+/**
+ * 数学公式转换菜单桥。
+ *
+ * 菜单只负责在可写、结构可证明的公式或公式块上追加“转换为”条目；点击后先在事务队列外排空编辑输入，
+ * 再读取内核来源快照，按整段有序签名与公式 ordinal 映射唯一目标，最后入队单笔 convertMath。
+ * 桥本身不预改 DOM、不预加 undo，也不在队列任务内等待自身。
+ */
+
+import {Constants} from "../../constants";
+import {queueTransaction} from "../util/transactionQueue";
+import {scheduleMathConversionRefresh} from "./mathConversionRefresh";
+import {
+    registerMathConversionMenuProvider,
+    type IMathConversionMenuContext,
+    type IMathConversionMenuProvider,
+} from "./mathConversionMenuRegistry";
+
+export const MATH_CONVERSION_PROVIDER_ID = "siyuan/math-conversion";
+
+export type TMathConversionDirection = "inline-to-block" | "block-to-inline";
+
+export const MATH_CONVERSION_DIRECTIONS: Record<TMathConversionDirection, TMathConversionDirection> = {
+    "inline-to-block": "inline-to-block",
+    "block-to-inline": "block-to-inline",
+};
+
+export interface IMathConversionFormula {
+    element: HTMLElement;
+    source: string;
+}
+
+export type TMathConversionSignatureFailure =
+    "content-unavailable" | "missing-source" | "too-large" | "too-deep" | "too-many-formulas";
+
+export interface IMathConversionSignature {
+    ok: boolean;
+    failure?: TMathConversionSignatureFailure;
+    /** 整段有序签名：正文、marks、公式位置与精确源；不剥离用户字符或实体 */
+    value: string;
+    formulas: IMathConversionFormula[];
+    /** 公式块方向使用的块级精确源 */
+    blockSource?: string;
+}
+
+export interface IMathConversionSnapshotTarget {
+    path: number[];
+    type: string;
+    source: string;
+    supported: boolean;
+    reason: string;
+}
+
+export interface IMathConversionSnapshot {
+    notebook: string;
+    rootID: string;
+    path: string;
+    version: string;
+    blockType: string;
+    topLevel: boolean;
+    targets: IMathConversionSnapshotTarget[];
+}
+
+export type TMathConversionMatchFailure =
+    "nested" | "block-mismatch" | "target-count" | "target-source" | "target-path" | "unsupported-target" | "no-formula";
+
+export type TMathConversionMatchResult =
+    {ok: true; targetPath: number[]; expectedSource: string; ordinal: number} |
+    {ok: false; failure: TMathConversionMatchFailure; detail?: string};
+
+/** 线协议只保留业务码、消息与未知数据；具体字段由 readMathConversionSnapshot 校验 */
+export interface IMathConversionWireResponse {
+    code: number;
+    msg: string;
+    data?: unknown;
+}
+
+export type TMathConversionTargetResponse = IMathConversionWireResponse;
+
+export type TMathConversionTransactionResponse = IMathConversionWireResponse;
+
+export interface IMathConversionImeTracker {
+    isActive: () => boolean;
+    dispose: () => void;
+}
+
+export interface IMathConversionRuntime {
+    now: () => number;
+    flush: (protyle: IProtyle) => Promise<void>;
+    requestTarget: (blockID: string) => Promise<TMathConversionTargetResponse>;
+    enqueue: (protyle: IProtyle, task: () => Promise<void>) => void | Promise<void>;
+    submit: (request: import("../../types/api").PerformTransactionsRequestInput) => Promise<TMathConversionTransactionResponse>;
+    refresh: (protyle: IProtyle, rootID: string) => void;
+    notify: (message: string) => void;
+    trackIme: (element: HTMLElement) => IMathConversionImeTracker;
+}
+
+interface IMathConversionFlowState {
+    protyle: IProtyle;
+    element: HTMLElement;
+    blockElement: HTMLElement;
+    blockID: string;
+    rootID: string;
+    editorElement: HTMLElement;
+}
+
+type TMathConversionInvalid = "changed" | "readonly" | "composing";
+
+const NODE_TEXT = 3;
+const NODE_ELEMENT = 1;
+/** 宿主与渲染器插在公式前后的光标边界：ZWSP、FEFF、换行与空白，不属于正文 */
+const BOUNDARY_TEXT = /^[\s\u200B\uFEFF]*$/;
+const MAX_SIGNATURE_NODES = 8192;
+const MAX_SIGNATURE_DEPTH = 64;
+const MAX_SIGNATURE_FORMULAS = 32;
+const SIGNATURE_ATTRIBUTES = [
+    "data-type", "data-subtype", "data-id", "href", "data-href", "data-inline-memo-content", "data-label", "data-content",
+];
+
+const languages = () => (window.siyuan?.languages || {}) as Record<string, string>;
+
+const blockReadonly = (protyle: IProtyle, blockElement: HTMLElement) => {
+    if (protyle.disabled || protyle.lite) {
+        return true;
+    }
+    if (window.siyuan?.config?.readonly || window.siyuan?.config?.editor?.readOnly || window.siyuan?.isPublish) {
+        return true;
+    }
+    const editorElement = protyle.wysiwyg?.element;
+    for (let element: HTMLElement | null = blockElement; element; element = element.parentElement) {
+        if (element.getAttribute(Constants.CUSTOM_SY_READONLY) === "true") {
+            return true;
+        }
+        if (element === editorElement) {
+            return false;
+        }
+    }
+    return false;
+};
+
+const isElement = (node: unknown): node is HTMLElement =>
+    Boolean(node) && (node as HTMLElement).nodeType === NODE_ELEMENT;
+
+const isInlineMathElement = (element: HTMLElement) => {
+    if (!isElement(element)) {
+        return false;
+    }
+    const types = (element.getAttribute("data-type") || "").split(/\s+/);
+    return types.includes("inline-math") && element.getAttribute("data-subtype") === "math";
+};
+
+const RUNTIME_DECORATION_CLASSES = ["protyle-attr", "protyle-icons", "protyle-cursor"];
+
+/** 运行时装饰：属性区、块图标、渲染光标、换行占位与渲染帧都不属于内容容器 */
+const isRuntimeDecoration = (element: HTMLElement) => {
+    const tag = (element.tagName || "").toLowerCase();
+    if (tag === "wbr") {
+        return true;
+    }
+    if (element.hasAttribute("data-render") || element.hasAttribute("spin")) {
+        return true;
+    }
+    const classes = (element.getAttribute("class") || "").split(/\s+/);
+    return RUNTIME_DECORATION_CLASSES.some(name => classes.includes(name));
+};
+
+/**
+ * 内容容器：块自身带 contenteditable 时就是它，否则取第一个带 contenteditable 的非装饰子级；
+ * 渲染块（公式块等）没有可编辑子级时回退块本身，属性区不会被当作内容。
+ */
+const contentElement = (blockElement: HTMLElement): HTMLElement | undefined => {
+    if (!isElement(blockElement)) {
+        return undefined;
+    }
+    // 提交租约会临时把 contenteditable 改成 false，查找只认属性存在，避免租约期间丢失内容容器。
+    if (blockElement.hasAttribute("contenteditable")) {
+        return blockElement;
+    }
+    const children = blockElement.children;
+    if (!children) {
+        return blockElement;
+    }
+    for (let index = 0; index < children.length; index++) {
+        const child = children[index] as HTMLElement;
+        if (!isElement(child) || isRuntimeDecoration(child)) {
+            continue;
+        }
+        if (child.hasAttribute("contenteditable")) {
+            return child;
+        }
+    }
+    return blockElement;
+};
+
+/**
+ * 独占段落：内容容器除空白文本与运行时装饰外只有一个直接子级，且正是当前行内公式。
+ * 混排段落（含可见文字或其他元素）不提供行内转块入口。
+ */
+const isSoleInlineMathParagraph = (blockElement: HTMLElement, element: HTMLElement) => {
+    if (!isElement(element) || !isInlineMathElement(element)) {
+        return false;
+    }
+    const content = contentElement(blockElement);
+    if (!content || element.parentElement !== content) {
+        return false;
+    }
+    let formulas = 0;
+    const children = content.childNodes;
+    if (!children) {
+        return false;
+    }
+    for (let index = 0; index < children.length; index++) {
+        const node = children[index];
+        if (node.nodeType === NODE_TEXT) {
+            // 边界钩子在公式前后插入 ZWSP/FEFF/换行/空白，它们不构成混排正文。
+            if (!BOUNDARY_TEXT.test(node.nodeValue ?? "")) {
+                return false;
+            }
+            continue;
+        }
+        if (node.nodeType !== NODE_ELEMENT) {
+            continue;
+        }
+        const child = node as HTMLElement;
+        if (child === element) {
+            formulas++;
+            continue;
+        }
+        // 另一个行内公式（含已渲染的）或任何其他元素都属于混排，只有属性区等装饰可以跳过。
+        if (isInlineMathElement(child)) {
+            return false;
+        }
+        if (isRuntimeDecoration(child)) {
+            continue;
+        }
+        return false;
+    }
+    return formulas === 1;
+};
+
+const containsElement = (ancestor: HTMLElement, element: HTMLElement | null) => {
+    for (let current: HTMLElement | null = element; current; current = current.parentElement) {
+        if (current === ancestor) {
+            return true;
+        }
+    }
+    return false;
+};
+
+/** 仅可写、顶层、结构可证明的公式或公式块返回转换方向；其他情况返回 undefined，菜单不显示 */
+export const getMathConversionDirection = (context: IMathConversionMenuContext): TMathConversionDirection | undefined => {
+    const protyle = context?.protyle;
+    const blockElement = context?.blockElement;
+    if (!protyle || !isElement(blockElement) || blockReadonly(protyle, blockElement)) {
+        return undefined;
+    }
+    const editorElement = protyle.wysiwyg?.element;
+    if (!isElement(editorElement) || blockElement.parentElement !== editorElement) {
+        return undefined;
+    }
+    const blockType = blockElement.getAttribute("data-type");
+    const element = context.element;
+    if (blockType === "NodeParagraph") {
+        return isSoleInlineMathParagraph(blockElement, element) ? "inline-to-block" : undefined;
+    }
+    if (blockType === "NodeMathBlock") {
+        if (blockElement.getAttribute("data-subtype") !== "math") {
+            return undefined;
+        }
+        return containsElement(blockElement, element) ? "block-to-inline" : undefined;
+    }
+    return undefined;
+};
+
+const signatureElement = (element: HTMLElement) => {
+    const attributes: Record<string, string> = {};
+    for (const name of SIGNATURE_ATTRIBUTES) {
+        const value = element.getAttribute(name);
+        if (value !== null) {
+            attributes[name] = value;
+        }
+    }
+    const tag = (element.tagName || "").toLowerCase();
+    return {tag, attributes};
+};
+
+/**
+ * 构造整段有序签名。正文文本原样保留（含 U+200B/U+2060/实体字符），只排除已证运行时装饰：
+ * `.protyle-attr`、`wbr`、渲染子树和 data-* 渲染标记；公式节点作为终端节点记录精确 data-content。
+ */
+export const buildMathConversionSignature = (blockElement: HTMLElement, direction: TMathConversionDirection):
+    IMathConversionSignature => {
+    const blockID = blockElement.getAttribute("data-node-id") || "";
+    if (direction === "block-to-inline") {
+        const source = blockElement.getAttribute("data-content");
+        if (source === null) {
+            return {ok: false, failure: "missing-source", value: "", formulas: []};
+        }
+        return {
+            ok: true,
+            value: JSON.stringify({id: blockID, direction, source}),
+            formulas: [],
+            blockSource: source,
+        };
+    }
+    const content = contentElement(blockElement);
+    if (!content) {
+        return {ok: false, failure: "content-unavailable", value: "", formulas: []};
+    }
+    const formulas: IMathConversionFormula[] = [];
+    let nodes = 0;
+    let failure: TMathConversionSignatureFailure | undefined;
+    const walk = (parent: Node, depth: number): unknown[] => {
+        const entries: unknown[] = [];
+        const children = parent.childNodes;
+        if (!children) {
+            return entries;
+        }
+        for (let index = 0; index < children.length; index++) {
+            const node = children[index] as Node & {tagName?: string};
+            nodes++;
+            if (nodes > MAX_SIGNATURE_NODES) {
+                failure = "too-large";
+                return entries;
+            }
+            if (node.nodeType === NODE_TEXT) {
+                entries.push({text: node.nodeValue ?? ""});
+                continue;
+            }
+            if (node.nodeType !== NODE_ELEMENT) {
+                continue;
+            }
+            const element = node as HTMLElement;
+            const tag = (element.tagName || "").toLowerCase();
+            if (tag === "wbr") {
+                continue;
+            }
+            if ((element.getAttribute("class") || "").split(/\s+/).includes("protyle-attr")) {
+                continue;
+            }
+            if (isInlineMathElement(element)) {
+                const source = element.getAttribute("data-content");
+                if (source === null) {
+                    failure = "missing-source";
+                    return entries;
+                }
+                formulas.push({element, source});
+                if (formulas.length > MAX_SIGNATURE_FORMULAS) {
+                    failure = "too-many-formulas";
+                    return entries;
+                }
+                entries.push({math: source});
+                continue;
+            }
+            if (element.hasAttribute("data-render")) {
+                continue;
+            }
+            if (depth + 1 > MAX_SIGNATURE_DEPTH) {
+                failure = "too-deep";
+                return entries;
+            }
+            const meta = signatureElement(element);
+            entries.push({element: meta.tag, ...meta.attributes, children: walk(element, depth + 1)});
+            if (failure) {
+                return entries;
+            }
+        }
+        return entries;
+    };
+    const tree = walk(content, 0);
+    if (failure) {
+        return {ok: false, failure, value: "", formulas: []};
+    }
+    return {ok: true, value: JSON.stringify({id: blockID, direction, content: tree}), formulas};
+};
+
+const isSnapshotTarget = (target: unknown): target is IMathConversionSnapshotTarget => {
+    if (!target || typeof target !== "object") {
+        return false;
+    }
+    const value = target as IMathConversionSnapshotTarget;
+    return Array.isArray(value.path) && typeof value.type === "string" && typeof value.source === "string" &&
+        typeof value.supported === "boolean" && typeof value.reason === "string" &&
+        value.path.every(item => Number.isInteger(item) && item >= 0);
+};
+
+/** 把 getTarget 响应转换成受检快照；失败响应返回 undefined，由调用方按业务码提示 */
+export const readMathConversionSnapshot = (response: TMathConversionTargetResponse):
+    IMathConversionSnapshot | undefined => {
+    if (!response || response.code !== 0 || !response.data || typeof response.data !== "object") {
+        return undefined;
+    }
+    const data = response.data as Record<string, unknown>;
+    if (typeof data.notebook !== "string" || typeof data.rootID !== "string" || typeof data.path !== "string" ||
+        typeof data.version !== "string" || typeof data.blockType !== "string" || typeof data.topLevel !== "boolean" ||
+        !Array.isArray(data.targets)) {
+        return undefined;
+    }
+    const targets: IMathConversionSnapshotTarget[] = [];
+    for (const target of data.targets) {
+        if (!isSnapshotTarget(target)) {
+            return undefined;
+        }
+        targets.push({path: [...target.path], type: target.type, source: target.source,
+            supported: target.supported, reason: target.reason});
+    }
+    return {
+        notebook: data.notebook, rootID: data.rootID, path: data.path, version: data.version,
+        blockType: data.blockType, topLevel: data.topLevel, targets,
+    };
+};
+
+/**
+ * 按公式 ordinal（在整段签名中的位置）映射内核候选。候选数量、公式类型、精确源与路径顺序必须
+ * 与 DOM 公式序列一一对应；不能证明唯一时返回失败，调用方不得自行改选目标。
+ */
+export const matchMathConversionTarget = (snapshot: IMathConversionSnapshot, signature: IMathConversionSignature,
+                                          direction: TMathConversionDirection, element: HTMLElement):
+    TMathConversionMatchResult => {
+    const expectedBlock = direction === "inline-to-block" ? "NodeParagraph" : "NodeMathBlock";
+    if (!snapshot.topLevel) {
+        return {ok: false, failure: "nested"};
+    }
+    if (snapshot.blockType !== expectedBlock) {
+        return {ok: false, failure: "block-mismatch"};
+    }
+    if (snapshot.targets.length !== 1 && direction === "block-to-inline") {
+        return {ok: false, failure: "target-count"};
+    }
+    if (direction === "inline-to-block") {
+        if (signature.formulas.length === 0) {
+            return {ok: false, failure: "no-formula"};
+        }
+        if (snapshot.targets.length !== signature.formulas.length) {
+            return {ok: false, failure: "target-count"};
+        }
+        let previousPath = -1;
+        for (let index = 0; index < snapshot.targets.length; index++) {
+            const target = snapshot.targets[index];
+            if (target.type !== "inline-math" || target.path.length !== 1) {
+                return {ok: false, failure: "target-path"};
+            }
+            if (target.source !== signature.formulas[index].source) {
+                return {ok: false, failure: "target-source"};
+            }
+            if (target.path[0] <= previousPath) {
+                return {ok: false, failure: "target-path"};
+            }
+            previousPath = target.path[0];
+        }
+        const ordinal = signature.formulas.findIndex(item => item.element === element);
+        if (ordinal < 0) {
+            return {ok: false, failure: "no-formula"};
+        }
+        const target = snapshot.targets[ordinal];
+        if (!target.supported) {
+            return {ok: false, failure: "unsupported-target", detail: target.reason};
+        }
+        return {ok: true, targetPath: [...target.path], expectedSource: target.source, ordinal};
+    }
+    const target = snapshot.targets[0];
+    if (target.type !== "math-block" || target.path.length !== 0) {
+        return {ok: false, failure: "target-path"};
+    }
+    if (target.source !== signature.blockSource) {
+        return {ok: false, failure: "target-source"};
+    }
+    if (!target.supported) {
+        return {ok: false, failure: "unsupported-target", detail: target.reason};
+    }
+    return {ok: true, targetPath: [], expectedSource: target.source, ordinal: 0};
+};
+
+const checkFlowState = (state: IMathConversionFlowState, imeActive: () => boolean): TMathConversionInvalid | undefined => {
+    const {protyle, element, blockElement} = state;
+    if (!element?.isConnected || !blockElement?.isConnected || !state.editorElement?.isConnected) {
+        return "changed";
+    }
+    if (protyle.wysiwyg?.element !== state.editorElement) {
+        return "changed";
+    }
+    if (!state.editorElement.contains(blockElement) || !state.editorElement.contains(element)) {
+        return "changed";
+    }
+    if (blockElement.getAttribute("data-node-id") !== state.blockID) {
+        return "changed";
+    }
+    if (protyle.block?.rootID !== state.rootID) {
+        return "changed";
+    }
+    if (blockElement.parentElement !== state.editorElement) {
+        return "changed";
+    }
+    if (blockReadonly(protyle, blockElement)) {
+        return "readonly";
+    }
+    if (imeActive()) {
+        return "composing";
+    }
+    return undefined;
+};
+
+const invalidMessage = (invalid: TMathConversionInvalid) => invalid === "readonly" ?
+    languages().mathConversionPermission || "" : languages().mathConversionChanged || "";
+
+const signatureFailureMessage = (failure: TMathConversionSignatureFailure) => failure === "missing-source" ||
+    failure === "content-unavailable" ? languages().mathConversionNoTarget || "" :
+    languages().mathConversionChanged || "";
+
+const matchFailureMessage = (result: TMathConversionMatchResult) => {
+    if (!("failure" in result)) {
+        return languages().mathConversionChanged || "";
+    }
+    if (result.failure === "unsupported-target" && result.detail) {
+        return `${languages().mathConversionUnsupported || ""}: ${result.detail}`;
+    }
+    if (result.failure === "nested" || result.failure === "block-mismatch") {
+        return languages().mathConversionUnsupported || "";
+    }
+    return languages().mathConversionNoTarget || "";
+};
+
+/** 业务码到可读提示：-409 冲突、422 不支持、403 权限，其余按失败提示，并保留内核原因 */
+export const mathConversionFailureMessage = (code: number, msg: string) => {
+    const currentLanguages = languages();
+    let message = currentLanguages.mathConversionFailed || "";
+    if (code === -409) {
+        message = currentLanguages.mathConversionConflict || "";
+    } else if (code === 422) {
+        message = currentLanguages.mathConversionUnsupported || "";
+    } else if (code === 403) {
+        message = currentLanguages.mathConversionPermission || "";
+    }
+    const detail = (msg || "").replace(/^(conflict|unsupported|permission|invalid|io):\s*/, "");
+    return detail ? `${message}: ${detail}` : message;
+};
+
+const createTransactionRequest = (state: IMathConversionFlowState, direction: TMathConversionDirection,
+                                  snapshot: IMathConversionSnapshot, match: Extract<TMathConversionMatchResult, {ok: true}>,
+                                  runtime: IMathConversionRuntime):
+    import("../../types/api").PerformTransactionsRequestInput => ({
+    reqId: runtime.now(),
+    app: Constants.SIYUAN_APPID,
+    session: state.protyle.id,
+    transactions: [{
+        doOperations: [{
+            action: "convertMath",
+            id: state.blockID,
+            blockID: state.blockID,
+            data: {
+                notebook: snapshot.notebook,
+                rootID: snapshot.rootID,
+                path: snapshot.path,
+                blockID: state.blockID,
+                direction,
+                targetPath: match.targetPath,
+                expectedSource: match.expectedSource,
+                expectedVersion: snapshot.version,
+            },
+        }],
+        undoOperations: [],
+    }],
+});
+
+interface IFetchSyncModule {
+    fetchSyncPost: (url: string, data?: unknown, headers?: Record<string, string>, process?: boolean) => Promise<unknown>;
+}
+
+const toWireResponse = (value: unknown): IMathConversionWireResponse => {
+    if (!value || typeof value !== "object") {
+        return {code: -1, msg: "", data: null};
+    }
+    const response = value as {code?: unknown; msg?: unknown; data?: unknown};
+    return {
+        code: typeof response.code === "number" ? response.code : -1,
+        msg: typeof response.msg === "string" ? response.msg : "",
+        data: response.data,
+    };
+};
+
+/** 默认运行时：迟加载 fetch/showMessage，避免菜单注册模块在无宿主环境加载网络与提示依赖 */
+export const createMathConversionRuntime = (): IMathConversionRuntime => ({
+    now: () => Date.now(),
+    flush: (protyle) => protyle.getInstance().flushPendingTransactions(),
+    requestTarget: async (blockID) => toWireResponse(await (require("../../util/fetch") as IFetchSyncModule)
+        .fetchSyncPost("/api/mathConversion/getTarget", {blockID}, undefined, false)),
+    enqueue: (protyle, task) => queueTransaction(protyle, task),
+    submit: async (request) => toWireResponse(await (require("../../util/fetch") as IFetchSyncModule)
+        .fetchSyncPost("/api/transactions", request, undefined, false)),
+    refresh: (protyle, rootID) => {
+        if (protyle.block?.rootID !== rootID || !protyle.element?.isConnected) {
+            return;
+        }
+        protyle.getInstance().reload(false);
+    },
+    notify: (message) => {
+        const {showMessage}: {showMessage: (text: string, timeout?: number, type?: string) => void} =
+            require("../../dialog/message");
+        showMessage(message, 6000, "error");
+    },
+    trackIme: (element) => {
+        let compositions = 0;
+        const onCompositionStart = () => {
+            compositions++;
+        };
+        const onCompositionEnd = () => {
+            if (compositions > 0) {
+                compositions--;
+            }
+        };
+        element.addEventListener("compositionstart", onCompositionStart, true);
+        element.addEventListener("compositionend", onCompositionEnd, true);
+        return {
+            isActive: () => compositions > 0,
+            dispose: () => {
+                element.removeEventListener("compositionstart", onCompositionStart, true);
+                element.removeEventListener("compositionend", onCompositionEnd, true);
+            },
+        };
+    },
+});
+
+/** 同时只允许一个流程持有目标块的内容容器 */
+const mathConversionLeases = new WeakMap<HTMLElement, object>();
+
+/**
+ * 租约只落在内容容器：块自身或带 contenteditable 的非装饰子级；属性区等装饰从不写入。
+ * 同一容器同时只允许一个流程持有，避免第二个流程把租约值当成原值恢复。
+ */
+const acquireMathConversionEditingLease = (blockElement: HTMLElement) => {
+    const content = contentElement(blockElement) || blockElement;
+    // 目标原本就不可编辑时保持原状，不写入也不恢复，避免覆盖其他流程或用户的只读设置。
+    if (content.getAttribute("contenteditable") === "false" || mathConversionLeases.has(content)) {
+        return undefined;
+    }
+    const token = {};
+    const original = content.getAttribute("contenteditable");
+    mathConversionLeases.set(content, token);
+    content.setAttribute("contenteditable", "false");
+    return () => {
+        if (mathConversionLeases.get(content) !== token) {
+            return;
+        }
+        mathConversionLeases.delete(content);
+        if (original === null) {
+            content.removeAttribute("contenteditable");
+        } else {
+            content.setAttribute("contenteditable", original);
+        }
+    };
+};
+
+interface IMathConversionRetry {
+    snapshot: IMathConversionSnapshot;
+    match: Extract<TMathConversionMatchResult, {ok: true}>;
+}
+
+/** -409 只重取一次快照；签名、目标路径与精确源仍须一致，否则按原冲突提示 */
+const retryMathConversionSnapshot = async (state: IMathConversionFlowState, direction: TMathConversionDirection,
+                                          signature: IMathConversionSignature,
+                                          match: Extract<TMathConversionMatchResult, {ok: true}>,
+                                          blockElement: HTMLElement, element: HTMLElement,
+                                          runtime: IMathConversionRuntime, imeActive: () => boolean):
+    Promise<IMathConversionRetry | undefined> => {
+    let response: TMathConversionTargetResponse;
+    try {
+        response = await runtime.requestTarget(state.blockID);
+    } catch {
+        return undefined;
+    }
+    if (checkFlowState(state, imeActive)) {
+        return undefined;
+    }
+    const retrySignature = buildMathConversionSignature(blockElement, direction);
+    if (!retrySignature.ok || retrySignature.value !== signature.value) {
+        return undefined;
+    }
+    const snapshot = readMathConversionSnapshot(response);
+    if (!snapshot || snapshot.rootID !== state.rootID ||
+        snapshot.blockType !== blockElement.getAttribute("data-type") ||
+        !/^[0-9a-f]{64}$/.test(snapshot.version) || !snapshot.notebook || !snapshot.path) {
+        return undefined;
+    }
+    const retryMatch = matchMathConversionTarget(snapshot, retrySignature, direction, element);
+    if (!retryMatch.ok || retryMatch.targetPath.join(",") !== match.targetPath.join(",") ||
+        retryMatch.expectedSource !== match.expectedSource) {
+        return undefined;
+    }
+    return {snapshot, match: retryMatch};
+};
+
+/** 执行一次转换：队列外 flush → 复核 → getTarget → 复核签名 → 队列内单笔 convertMath → 刷新正确 root */
+export const runMathConversion = async (context: IMathConversionMenuContext,
+                                        runtime: IMathConversionRuntime = createMathConversionRuntime()):
+    Promise<void> => {
+    const protyle = context?.protyle;
+    const blockElement = context?.blockElement;
+    const element = context?.element;
+    if (!protyle || !isElement(blockElement) || !isElement(element)) {
+        return;
+    }
+    const direction = getMathConversionDirection(context);
+    if (!direction) {
+        return;
+    }
+    const blockID = blockElement.getAttribute("data-node-id") || "";
+    const rootID = protyle.block?.rootID || "";
+    if (!blockID || !rootID) {
+        runtime.notify(languages().mathConversionChanged || "");
+        return;
+    }
+    const editorElement = protyle.wysiwyg?.element;
+    if (!isElement(editorElement)) {
+        return;
+    }
+    const state: IMathConversionFlowState = {protyle, element, blockElement, blockID, rootID, editorElement};
+    const ime = runtime.trackIme(editorElement);
+    const fail = (invalid: TMathConversionInvalid) => {
+        runtime.notify(invalidMessage(invalid));
+    };
+    try {
+        const initialInvalid = checkFlowState(state, ime.isActive);
+        if (initialInvalid) {
+            fail(initialInvalid);
+            return;
+        }
+        try {
+            await runtime.flush(protyle);
+        } catch {
+            runtime.notify(languages().mathConversionFailed || "");
+            return;
+        }
+        const flushedInvalid = checkFlowState(state, ime.isActive);
+        if (flushedInvalid) {
+            fail(flushedInvalid);
+            return;
+        }
+        const signature = buildMathConversionSignature(blockElement, direction);
+        if (!signature.ok) {
+            runtime.notify(signatureFailureMessage(signature.failure));
+            return;
+        }
+        if (direction === "inline-to-block" && !signature.formulas.some(item => item.element === element)) {
+            runtime.notify(languages().mathConversionNoTarget || "");
+            return;
+        }
+        let targetResponse: TMathConversionTargetResponse;
+        try {
+            targetResponse = await runtime.requestTarget(blockID);
+        } catch {
+            runtime.notify(languages().mathConversionFailed || "");
+            return;
+        }
+        const targetInvalid = checkFlowState(state, ime.isActive);
+        if (targetInvalid) {
+            fail(targetInvalid);
+            return;
+        }
+        const currentSignature = buildMathConversionSignature(blockElement, direction);
+        if (!currentSignature.ok || currentSignature.value !== signature.value) {
+            runtime.notify(languages().mathConversionChanged || "");
+            return;
+        }
+        const snapshot = readMathConversionSnapshot(targetResponse);
+        if (!snapshot) {
+            runtime.notify(targetResponse.code === 0 ? languages().mathConversionNoTarget || "" :
+                mathConversionFailureMessage(targetResponse.code, targetResponse.msg));
+            return;
+        }
+        if (snapshot.rootID !== rootID || snapshot.blockType !== blockElement.getAttribute("data-type") ||
+            !/^[0-9a-f]{64}$/.test(snapshot.version) || !snapshot.notebook || !snapshot.path) {
+            runtime.notify(languages().mathConversionNoTarget || "");
+            return;
+        }
+        const match = matchMathConversionTarget(snapshot, signature, direction, element);
+        if (!match.ok) {
+            runtime.notify(matchFailureMessage(match));
+            return;
+        }
+        const releaseLease = acquireMathConversionEditingLease(blockElement);
+        if (!releaseLease) {
+            // 同块已有流程持有租约，或目标本来不可编辑：拒绝本次转换，不改已有状态。
+            runtime.notify(languages().mathConversionChanged || "");
+            return;
+        }
+        let committedRootID = "";
+        try {
+            await runtime.enqueue(protyle, async () => {
+                const queuedInvalid = checkFlowState(state, ime.isActive);
+                if (queuedInvalid) {
+                    fail(queuedInvalid);
+                    return;
+                }
+                const queuedSignature = buildMathConversionSignature(blockElement, direction);
+                if (!queuedSignature.ok || queuedSignature.value !== signature.value) {
+                    runtime.notify(languages().mathConversionChanged || "");
+                    return;
+                }
+                const queuedMatch = matchMathConversionTarget(snapshot, queuedSignature, direction, element);
+                if (!queuedMatch.ok || queuedMatch.targetPath.join(",") !== match.targetPath.join(",") ||
+                    queuedMatch.expectedSource !== match.expectedSource) {
+                    runtime.notify(queuedMatch.ok ? languages().mathConversionChanged || "" :
+                        matchFailureMessage(queuedMatch));
+                    return;
+                }
+                const request = createTransactionRequest(state, direction, snapshot, match, runtime);
+                let response: TMathConversionTransactionResponse;
+                try {
+                    response = await runtime.submit(request);
+                } catch {
+                    runtime.notify(languages().mathConversionFailed || "");
+                    return;
+                }
+                if (response.code === -409) {
+                    // 同文档其他块刚保存也会让来源版本过期；最多重取一次快照，签名与目标仍须一致。
+                    const retry = await retryMathConversionSnapshot(state, direction, signature, match,
+                        blockElement, element, runtime, ime.isActive);
+                    if (retry) {
+                        try {
+                            response = await runtime.submit(createTransactionRequest(state, direction,
+                                retry.snapshot, retry.match, runtime));
+                        } catch {
+                            runtime.notify(languages().mathConversionFailed || "");
+                            return;
+                        }
+                    }
+                }
+                if (response.code !== 0) {
+                    runtime.notify(mathConversionFailureMessage(response.code, response.msg));
+                    return;
+                }
+                committedRootID = snapshot.rootID;
+            });
+        } catch {
+            runtime.notify(languages().mathConversionFailed || "");
+        } finally {
+            releaseLease();
+        }
+        if (committedRootID) {
+            // 提交成功后队列外 flush 再刷新；同一 protyle 的并发刷新由调度器合并。
+            await scheduleMathConversionRefresh(protyle, committedRootID, {
+                flush: () => runtime.flush(protyle),
+                reload: () => runtime.refresh(protyle, committedRootID),
+            });
+        }
+    } finally {
+        ime.dispose();
+    }
+};
+
+const menuLabel = (direction: TMathConversionDirection) => direction === "inline-to-block" ?
+    languages().math || "" : languages()["inline-math"] || "";
+
+export const createMathConversionMenuProvider = (): IMathConversionMenuProvider => ({
+    items: (context) => {
+        const direction = getMathConversionDirection(context);
+        if (!direction) {
+            return [];
+        }
+        return [{
+            id: direction,
+            icon: "iconMath",
+            label: menuLabel(direction),
+            click: () => {
+                void runMathConversion(context);
+            },
+        }];
+    },
+});
+
+/** 宿主内置提供器；重复安装由 registry 原位覆盖，保持菜单位置稳定 */
+export const installMathConversionBridge = () =>
+    registerMathConversionMenuProvider(MATH_CONVERSION_PROVIDER_ID, createMathConversionMenuProvider());
