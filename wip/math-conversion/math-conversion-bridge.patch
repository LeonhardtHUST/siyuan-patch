@@ -0,0 +1,74 @@
+/**
+ * 公式转换后的刷新调度。
+ *
+ * 同一 protyle 的并发刷新合并为一次；每次刷新前先在事务队列外排空输入。
+ * 这里不做“自身回声”去重：内核广播按 session 排除发起窗口，本地标记不会被自身消费，
+ * 却可能吞掉同文档其他窗口后续的合法广播。
+ */
+
+export interface IMathConversionRefreshRuntime {
+    flush: (protyle: IProtyle) => Promise<void>;
+    reload: (protyle: IProtyle) => void;
+}
+
+export const createMathConversionRefreshRuntime = (): IMathConversionRefreshRuntime => ({
+    flush: (protyle) => protyle.getInstance().flushPendingTransactions(),
+    reload: (protyle) => {
+        const {reloadProtyle}: {reloadProtyle: (target: IProtyle, focus: boolean) => void} =
+            require("../util/reload");
+        reloadProtyle(protyle, false);
+    },
+});
+
+const pendingRefreshes = new WeakMap<IProtyle, Promise<void>>();
+
+/**
+ * 合并同一 protyle 的刷新：先 flush 输入与事务队列，再确认仍显示目标 root 后 reload。
+ * flush 失败时保留当前视图，不 reload，避免丢掉未保存输入。
+ */
+export const scheduleMathConversionRefresh = (protyle: IProtyle, rootID: string,
+                                             runtime: IMathConversionRefreshRuntime =
+                                                 createMathConversionRefreshRuntime()): Promise<void> => {
+    const existing = pendingRefreshes.get(protyle);
+    if (existing) {
+        return existing;
+    }
+    const expectedRootID = rootID || protyle.block?.rootID || "";
+    const task = (async () => {
+        try {
+            await runtime.flush(protyle);
+        } catch {
+            return;
+        }
+        if (expectedRootID && protyle.block?.rootID !== expectedRootID) {
+            return;
+        }
+        if (!protyle.wysiwyg?.element?.isConnected) {
+            return;
+        }
+        runtime.reload(protyle);
+    })().finally(() => {
+        if (pendingRefreshes.get(protyle) === task) {
+            pendingRefreshes.delete(protyle);
+        }
+    });
+    pendingRefreshes.set(protyle, task);
+    return task;
+};
+
+/**
+ * convertMath 广播的线协议只保证 action/id/blockID：内核重建操作后 data 为 null，
+ * 撤销重放同样不带 rootID。因此只能按 blockID 是否属于当前编辑器判断，不能假设 metadata 可达。
+ */
+export const mathConversionBroadcastBlockID = (operation: IOperation) =>
+    operation?.id || operation?.blockID || "";
+
+/** 广播目标块不属于当前编辑器时不 reload，保住其他文档的未保存输入 */
+export const mathConversionBroadcastTargetsProtyle = (protyle: IProtyle, operation: IOperation) => {
+    const blockID = mathConversionBroadcastBlockID(operation);
+    if (!blockID) {
+        return false;
+    }
+    const editorElement = protyle.wysiwyg?.element;
+    return Boolean(editorElement?.querySelector?.(`[data-node-id="${blockID}"]`));
+};
