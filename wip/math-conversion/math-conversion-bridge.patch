+const targetSuccess = (data: IMathConversionSnapshot): TMathConversionTargetResponse =>
+    ({code: 0, msg: "", data: {notebook: data.notebook, rootID: data.rootID, path: data.path, version: data.version,
+        blockType: data.blockType, topLevel: data.topLevel, targets: data.targets}}) as TMathConversionTargetResponse;
+
+const transactionSuccess = (): TMathConversionTransactionResponse => ({
+    code: 0, msg: "", data: [{doOperations: [{action: "convertMath", id: "p1", blockID: "p1", retData: ["p1"]}],
+        undoOperations: [], timestamp: 1}],
+}) as unknown as TMathConversionTransactionResponse;
+
+const transactionFailure = (code: number, msg: string): TMathConversionTransactionResponse =>
+    ({code, msg, data: {closeTimeout: 0}}) as unknown as TMathConversionTransactionResponse;
+
+const failureResponse = (code: number, msg: string): TMathConversionTargetResponse =>
+    ({code, msg, data: {closeTimeout: 0}}) as unknown as TMathConversionTargetResponse;
