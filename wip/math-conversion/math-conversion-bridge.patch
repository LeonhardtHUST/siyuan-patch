+interface IRuntimeCalls {
+    flush: number;
+    requestTarget: number;
+    enqueue: number;
+    submit: number;
+    refresh: number;
+    notify: string[];
+    order: string[];
+    requests: Array<import("../../types/api").PerformTransactionsRequestInput>;
+    refreshRoot?: string;
+    disposed: number;
+}
+
+const createFakeRuntime = async (options: {
+    flush?: (protyle: IProtyle) => Promise<void>;
+    target?: (blockID: string, call: number) => Promise<TMathConversionTargetResponse>;
+    submit?: (request: import("../../types/api").PerformTransactionsRequestInput, call: number) =>
+        Promise<TMathConversionTransactionResponse>;
+    refresh?: (protyle: IProtyle, rootID: string) => void;
+    imeActive?: () => boolean;
+} = {}) => {
+    // 测试走真实 queueTransaction，避免假 enqueue 掩盖自等待与排队顺序问题。
+    const {queueTransaction} = await import("../util/transactionQueue");
+    const calls: IRuntimeCalls = {
+        flush: 0, requestTarget: 0, enqueue: 0, submit: 0, refresh: 0, notify: [], order: [], requests: [], disposed: 0,
+    };
+    const runtime: IMathConversionRuntime = {
+        now: () => 1700000000000,
+        flush: async (protyle) => {
+            calls.flush++;
+            calls.order.push("flush");
+            await options.flush?.(protyle);
+        },
+        requestTarget: async (blockID) => {
+            calls.requestTarget++;
+            calls.order.push("target");
+            return options.target ? options.target(blockID, calls.requestTarget) : targetSuccess(snapshot());
+        },
+        enqueue: (protyle, task) => {
+            calls.enqueue++;
+            calls.order.push("enqueue");
+            return queueTransaction(protyle, task);
+        },
+        submit: async (request) => {
+            calls.submit++;
+            calls.requests.push(request);
+            calls.order.push("submit");
+            return options.submit ? options.submit(request, calls.submit) : transactionSuccess();
+        },
+        refresh: (protyle, rootID) => {
+            calls.refresh++;
+            calls.order.push("refresh");
+            calls.refreshRoot = rootID;
+            if (options.refresh) {
+                options.refresh(protyle, rootID);
+            }
+        },
+        notify: (message) => {
+            calls.notify.push(message);
+            calls.order.push("notify");
+        },
+        trackIme: () => ({
+            isActive: () => options.imeActive?.() ?? false,
+            dispose: () => {
+                calls.disposed++;
+            },
+        }),
+    };
+    return {calls, runtime};
+};
