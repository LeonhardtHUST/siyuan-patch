+class FakeText {
+    public nodeType = 3;
+    public childNodes: FakeText[] = [];
+    public parentElement: FakeElement | null = null;
+
+    constructor(public nodeValue: string) {
+    }
+}
+
+class FakeElement {
+    public nodeType = 1;
+    public childNodes: Array<FakeElement | FakeText> = [];
+    public children: FakeElement[] = [];
+    public parentElement: FakeElement | null = null;
+    public isConnected = true;
+    private attributes = new Map<string, string>();
+    private listeners = new Map<string, Set<(event: unknown) => void>>();
+
+    constructor(public tagName: string, attributes: Record<string, string> = {}) {
+        Object.entries(attributes).forEach(([name, value]) => this.attributes.set(name, value));
+    }
+
+    public append(...nodes: Array<FakeElement | FakeText>) {
+        for (const node of nodes) {
+            node.parentElement = this;
+            this.childNodes.push(node);
+            if (node instanceof FakeElement) {
+                this.children.push(node);
+            }
+        }
+        return this;
+    }
+
+    public getAttribute(name: string) {
+        return this.attributes.has(name) ? this.attributes.get(name)! : null;
+    }
+
+    public hasAttribute(name: string) {
+        return this.attributes.has(name);
+    }
+
+    public setAttribute(name: string, value: string) {
+        this.attributes.set(name, value);
+    }
+
+    public removeAttribute(name: string) {
+        this.attributes.delete(name);
+    }
+
+    public addEventListener(type: string, listener: (event: unknown) => void) {
+        if (!this.listeners.has(type)) {
+            this.listeners.set(type, new Set());
+        }
+        this.listeners.get(type)!.add(listener);
+    }
+
+    public removeEventListener(type: string, listener: (event: unknown) => void) {
+        this.listeners.get(type)?.delete(listener);
+    }
+
+    public dispatch(type: string) {
+        this.listeners.get(type)?.forEach(listener => listener({type}));
+    }
+
+    public contains(node: unknown) {
+        for (let current = node as FakeElement | null; current; current = current.parentElement) {
+            if (current === this) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public querySelector(selector: string): FakeElement | null {
+        const match = /^\[data-node-id="(.*)"\]$/.exec(selector);
+        if (!match) {
+            return null;
+        }
+        for (const child of this.children) {
+            if (child.getAttribute("data-node-id") === match[1]) {
+                return child;
+            }
+            const nested = child.querySelector(selector);
+            if (nested) {
+                return nested;
+            }
+        }
+        return null;
+    }
+}
