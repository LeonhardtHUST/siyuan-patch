+        "data-render": "true",
+    });
+    const spin = new FakeElement("DIV", {spin: "1"});
+    spin.append(new FakeElement("SPAN", {contenteditable: "false"}).append(new FakeText("rendered")));
+    const attr = new FakeElement("DIV", {class: "protyle-attr", contenteditable: "false"});
+    attr.append(new FakeText("\u200B"));
+    block.append(spin, attr);
+    return {block, spin, attr};
+};
