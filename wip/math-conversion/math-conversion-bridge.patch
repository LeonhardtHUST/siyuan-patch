+test("broadcast probe: same-block windows refresh, unrelated blocks do not, no echo suppression", async () => {
+    const refresh = await import("./mathConversionRefresh");
+    const {queueTransaction, waitForPendingTransactions} = await import("../util/transactionQueue");
+    const restore = mockWindow();
+    try {
+        const buildWindow = (blockID = "p1") => {
+            const formula = inlineMath("x");
+            const {block} = paragraph(blockID, [formula]);
+            const protyle = fakeProtyle(editor(block));
+            let flushes = 0;
+            let reloads = 0;
+            const runtime = {
+                flush: async (current: IProtyle) => {
+                    flushes++;
+                    await waitForPendingTransactions(current);
+                },
+                reload: () => {
+                    reloads++;
+                },
+            };
+            return {protyle, runtime, counts: () => ({flushes, reloads})};
+        };
+        // 内核实际广播：重建操作后 data 为 null，也没有 rootID，只有 id/blockID。
+        const operation = {action: "convertMath", id: "p1", blockID: "p1"} as IOperation;
+        const windowA = buildWindow();
+        const windowB = buildWindow();
+        const unrelated = buildWindow("other-block");
+        const dispatch = (target: ReturnType<typeof buildWindow>) => {
+            if (!refresh.mathConversionBroadcastTargetsProtyle(target.protyle, operation)) {
+                return Promise.resolve(false);
+            }
+            return refresh.scheduleMathConversionRefresh(target.protyle,
+                target.protyle.block.rootID || "", target.runtime).then(() => true);
+        };
+        // A 队列里有待保存任务：广播刷新必须先 flush，不能带着未保存输入 reload。
+        let pendingSaved = false;
+        void queueTransaction(windowA.protyle, async () => {
+            await new Promise(resolve => setTimeout(resolve, 10));
+            pendingSaved = true;
+        });
+        const [a, b, c] = await Promise.all([dispatch(windowA), dispatch(windowB), dispatch(unrelated)]);
+        assert.equal(a, true);
+        assert.equal(b, true);
+        assert.equal(c, false);
+        assert.equal(pendingSaved, true);
+        assert.deepEqual(windowA.counts(), {flushes: 1, reloads: 1});
+        assert.deepEqual(windowB.counts(), {flushes: 1, reloads: 1});
+        assert.deepEqual(unrelated.counts(), {flushes: 0, reloads: 0});
+
+        // 没有本地 echo 去重：刷新完成后的下一条同块广播仍必须刷新。
+        await dispatch(windowA);
+        assert.equal(windowA.counts().reloads, 2);
+        // 同一 protyle 的并发广播仍然合并为一次刷新。
+        await Promise.all([dispatch(windowA), dispatch(windowA)]);
+        assert.equal(windowA.counts().reloads, 3);
+
+        assert.equal(refresh.mathConversionBroadcastTargetsProtyle(windowA.protyle,
+            {action: "convertMath", id: "missing"} as IOperation), false);
+        assert.equal(refresh.mathConversionBroadcastTargetsProtyle(windowA.protyle,
+            {action: "convertMath"} as IOperation), false);
+        const refreshExports = refresh as unknown as Record<string, unknown>;
+        assert.equal(refreshExports.markInitiatedMathConversionRefresh, undefined);
+        assert.equal(refreshExports.consumeInitiatedMathConversionRefresh, undefined);
+        await waitForPendingTransactions(windowA.protyle);
+    } finally {
+        restore();
+    }
+});
