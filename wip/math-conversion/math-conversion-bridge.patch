+test("signature keeps user zero-width, entity-looking text and excludes runtime decorations", async () => {
+    const bridge = await requireBridge();
+    const restore = mockWindow();
+    try {
+        const formula = inlineMath("x^2");
+        const {block, content} = paragraph("p1", [new FakeText("a\u200B\u2060&amp;"), formula, new FakeText("b")]);
+        const run = (extra?: (target: FakeElement) => void) => {
+            const next = paragraph("p1", [new FakeText("a\u200B\u2060&amp;"), inlineMath("x^2"), new FakeText("b")]);
+            extra?.(next.content);
+            return bridge.buildMathConversionSignature(asElement(next.block), "inline-to-block");
+        };
+        const before = run();
+        assert.equal(before.ok, true);
+        assert.equal(before.formulas.length, 1);
+        assert.equal(before.formulas[0].source, "x^2");
+        assert.ok(before.value.includes("\u200B"));
+        assert.ok(before.value.includes("\u2060"));
+        assert.ok(before.value.includes("&amp;"));
+        assert.ok(!before.value.includes("katex"));
+        assert.ok(!before.value.includes("rendered"));
+        assert.ok(!before.value.includes("protyle-attr"));
+
+        const decorated = run(target => {
+            target.append(new FakeElement("WBR"), new FakeElement("DIV", {class: "protyle-attr"}));
+            target.append(new FakeElement("SPAN", {"data-render": "true"}).append(new FakeText("derived")));
+        });
+        assert.equal(decorated.value, before.value);
+        assert.equal(signatureOf(block).value, before.value);
+
+        const changed = run(target => {
+            target.childNodes[0] = new FakeText("a\u200B\u2060&amp;c");
+        });
+        assert.notEqual(changed.value, before.value);
+        assert.equal(content.childNodes.length, 3);
+    } finally {
+        restore();
+    }
+});
