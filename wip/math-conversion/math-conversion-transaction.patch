+// MathConversionKind 区分公式转换在身份、冲突、支持范围或权限上的失败，调用方不需要依赖错误文本。
+type MathConversionKind string
+
+const (
+	MathConversionInvalid     MathConversionKind = "invalid"
+	MathConversionConflict    MathConversionKind = "conflict"
+	MathConversionUnsupported MathConversionKind = "unsupported"
+	MathConversionPermission  MathConversionKind = "permission"
+	MathConversionIO          MathConversionKind = "io"
+)
+
+type MathConversionError struct {
+	Kind   MathConversionKind
+	Reason string
+}
+
+func (failure *MathConversionError) Error() string {
+	return string(failure.Kind) + ": " + failure.Reason
+}
+
+func failMathConversion(kind MathConversionKind, reason string) error {
+	return &MathConversionError{Kind: kind, Reason: reason}
+}
+
+// MathConversionRequest 绑定一次公式转换的目标与来源版本。ExpectedVersion 是快照读取到的原始文件字节
+// 摘要；加密笔记本同样使用落盘密文的摘要，与最终 WriteFileWithPreflight 的原像比较保持一致。
+type MathConversionRequest struct {
+	Notebook        string
+	RootID          string
+	Path            string
+	BlockID         string
+	Direction       mathconversion.Direction
+	TargetPath      []int
+	ExpectedSource  string
+	ExpectedVersion string
+}
+
+type MathConversionTarget struct {
+	Path      []int
+	Type      string
+	Source    string
+	Supported bool
+	Reason    string
+}
+
+// MathConversionSnapshot 是只读来源快照。Version 绑定同一份 raw original 字节，而不是 updated 或
+// Markdown 投影；提交事务会再次在锁内读取并比较该版本。
+type MathConversionSnapshot struct {
+	Notebook  string
+	RootID    string
+	Path      string
+	Version   string
+	BlockType string
+	TopLevel  bool
+	Targets   []MathConversionTarget
+}
+
+type mathConversionFragment struct {
+	node *ast.Node
+}
+
+type mathConversionPosition struct {
+	previousID string
+	nextID     string
+	ids        []string
+}
+
+// mathConversionOperationState 只保存在内核内存中，客户端无法提交 before/after 快照或生成新 ID 的回调。
+type mathConversionOperationState struct {
+	request MathConversionRequest
+
+	notebook string
+	rootID   string
+	path     string
+	blockID  string
+
+	before         []mathConversionFragment
+	after          []mathConversionFragment
+	beforePosition mathConversionPosition
+	afterPosition  mathConversionPosition
+
+	newID func() string
+}
+
+func mathConversionSourceVersion(data []byte) string {
+	digest := sha256.Sum256(data)
+	return hex.EncodeToString(digest[:])
+}
+
+func mathConversionBlockTree(blockID string) *treenode.BlockTree {
+	if blockTree := treenode.GetBlockTree(blockID); blockTree != nil {
+		return blockTree
+	}
+	for _, boxID := range treenode.GetOpenedEncryptedBoxIDs() {
+		if blockTree := treenode.GetBlockTreeInBox(blockID, boxID); blockTree != nil {
+			return blockTree
+		}
+	}
+	return nil
+}
+
+func validateMathConversionRequest(request MathConversionRequest) error {
+	if !ast.IsNodeIDPattern(request.Notebook) {
+		return failMathConversion(MathConversionInvalid, "invalid notebook ID")
+	}
+	if !ast.IsNodeIDPattern(request.RootID) {
+		return failMathConversion(MathConversionInvalid, "invalid document ID")
+	}
+	if !ast.IsNodeIDPattern(request.BlockID) {
+		return failMathConversion(MathConversionInvalid, "invalid block ID")
+	}
+	if request.Direction != mathconversion.InlineToBlock && request.Direction != mathconversion.BlockToInline {
+		return failMathConversion(MathConversionInvalid, "unknown conversion direction")
+	}
+	if request.Direction == mathconversion.InlineToBlock {
+		if len(request.TargetPath) != 1 || request.TargetPath[0] < 0 {
+			return failMathConversion(MathConversionInvalid, "inline target requires one AST child index")
+		}
+	} else if len(request.TargetPath) != 0 {
+		return failMathConversion(MathConversionInvalid, "block target must not carry an AST child index")
+	}
+	if _, err := documentSourcePath(request.Notebook, request.Path, false); err != nil {
+		return failMathConversion(MathConversionInvalid, "invalid document path: "+err.Error())
+	}
+	if util.GetTreeID(request.Path) != request.RootID {
+		return failMathConversion(MathConversionInvalid, "document path and root ID differ")
+	}
+	if len(request.ExpectedVersion) != sha256.Size*2 {
+		return failMathConversion(MathConversionInvalid, "invalid expected source version")
+	}
+	if _, err := hex.DecodeString(request.ExpectedVersion); err != nil {
+		return failMathConversion(MathConversionInvalid, "invalid expected source version")
+	}
+	if len(request.ExpectedSource) > 1<<20 {
+		return failMathConversion(MathConversionUnsupported, "expected formula source exceeds source budget")
+	}
+	return nil
+}
+
+func validateMathConversionOperation(request MathConversionRequest) (*Operation, error) {
+	if err := validateMathConversionRequest(request); err != nil {
+		return nil, err
+	}
+	state := &mathConversionOperationState{request: request, blockID: request.BlockID,
+		notebook: request.Notebook, rootID: request.RootID, path: request.Path}
+	return &Operation{Action: "convertMath", ID: request.BlockID, BlockID: request.BlockID, mathConversion: state}, nil
+}
+
+// NewConvertMathOperation 构造模型层的单操作事务载荷。HTTP/API 解码尚未开放该 action，由后续独立任务接线。
+func NewConvertMathOperation(request MathConversionRequest) (*Operation, error) {
+	return validateMathConversionOperation(request)
+}
+
+func mathConversionNextBlock(node *ast.Node) *ast.Node {
+	for next := node.Next; next != nil; next = next.Next {
+		if next.IsBlock() && next.ID != "" {
+			return next
+		}
+	}
+	return nil
+}
+
+func mathConversionPreviousBlock(node *ast.Node) *ast.Node {
+	for previous := node.Previous; previous != nil; previous = previous.Previous {
+		if previous.IsBlock() && previous.ID != "" {
+			return previous
+		}
+	}
+	return nil
+}
+
+func mathConversionTopLevelBlock(tree *parse.Tree, id string) *ast.Node {
+	node := treenode.GetNodeInTree(tree, id)
+	if node == nil || node.Parent != tree.Root {
+		return nil
+	}
+	return node
+}
+
+func mathConversionFragmentIDs(fragments []mathConversionFragment) []string {
+	ids := make([]string, 0, len(fragments))
+	for _, fragment := range fragments {
+		if fragment.node != nil {
+			ids = append(ids, fragment.node.ID)
+		}
+	}
+	return ids
+}
+
+func mathConversionFragmentBlockIDs(fragments []mathConversionFragment) []string {
+	var ids []string
+	for _, fragment := range fragments {
+		if fragment.node == nil {
+			continue
+		}
+		ids = append(ids, fragment.node.BlockIDs()...)
+	}
+	return ids
+}
+
+func mathConversionCapturePosition(first, last *ast.Node) mathConversionPosition {
+	position := mathConversionPosition{ids: mathConversionRunIDsNodes(first, last)}
+	if previous := mathConversionPreviousBlock(first); previous != nil {
+		position.previousID = previous.ID
+	}
+	if next := mathConversionNextBlock(last); next != nil {
+		position.nextID = next.ID
+	}
+	return position
+}
+
+// mathConversionRunIDsNodes 按文档顶层顺序收集 first..last 之间的块 ID，忽略非块装饰节点。
+func mathConversionRunIDsNodes(first, last *ast.Node) (ids []string) {
+	for node := first; node != nil; node = mathConversionNextBlock(node) {
+		ids = append(ids, node.ID)
+		if node == last {
+			return
+		}
+	}
+	return
+}
+
+func mathConversionBlockIDSet(root *ast.Node) map[string]bool {
+	ids := map[string]bool{}
+	ast.Walk(root, func(node *ast.Node, entering bool) ast.WalkStatus {
+		if entering && node.IsBlock() && node.ID != "" {
+			ids[node.ID] = true
+		}
+		return ast.WalkContinue
+	})
+	return ids
+}
+
+func mathConversionReadonly(node *ast.Node) bool {
+	for current := node; current != nil; current = current.Parent {
+		if current.IALAttr(readonlyAttr) == "true" || current.Type == ast.NodeMindmapItem {
+			return true
+		}
+	}
+	return false
+}
+
+// mathConversionFingerprint 比较持久块内容、marks 与身份属性。IAL 是属性集合，持久化顺序不是身份，
+// 因此先按属性名稳定排序；updated 与动态引用角标不属于转换身份。
+func mathConversionFingerprint(node *ast.Node) string {
+	cloned := cloneRenderNode(node)
+	ast.Walk(cloned, func(current *ast.Node, entering bool) ast.WalkStatus {
+		if !entering {
+			return ast.WalkContinue
+		}
+		current.RemoveIALAttr("updated")
+		current.RemoveIALAttr("refcount")
+		if len(current.KramdownIAL) > 1 {
+			slices.SortFunc(current.KramdownIAL, func(a, b []string) int {
+				if len(a) == 0 || len(b) == 0 {
+					return 0
+				}
+				return strings.Compare(a[0], b[0])
+			})
+		}
+		if current.Type == ast.NodeTextMark && current.IsTextMarkType("block-ref") && current.TextMarkBlockRefSubtype == "d" {
+			current.TextMarkTextContent = ""
+		}
+		return ast.WalkContinue
+	})
+	luteEngine := util.NewLute()
+	return string(render.NewJSONRenderer(&parse.Tree{Root: cloned}, luteEngine.RenderOptions, luteEngine.ParseOptions).Render())
+}
+
+func mathConversionPlannerError(err error) error {
+	var failure *mathconversion.Error
+	if !errors.As(err, &failure) {
+		return failMathConversion(MathConversionInvalid, err.Error())
+	}
+	switch failure.Kind {
+	case mathconversion.Conflict:
+		return failMathConversion(MathConversionConflict, failure.Reason)
+	case mathconversion.Unsupported:
+		return failMathConversion(MathConversionUnsupported, failure.Reason)
+	default:
+		return failMathConversion(MathConversionInvalid, failure.Reason)
+	}
+}
+
+func mathConversionInlineSource(node *ast.Node) (string, bool) {
+	switch node.Type {
+	case ast.NodeTextMark:
+		if node.TextMarkType != "inline-math" {
+			return "", false
+		}
+		return node.TextMarkInlineMathContent, true
+	case ast.NodeInlineMath:
+		var content *ast.Node
+		for child := node.FirstChild; child != nil; child = child.Next {
+			if child.Type == ast.NodeInlineMathContent {
+				if content != nil {
+					return "", false
+				}
+				content = child
+				continue
+			}
+			if child.Type != ast.NodeInlineMathOpenMarker && child.Type != ast.NodeInlineMathCloseMarker {
+				return "", false
+			}
+		}
+		if content == nil {
+			return "", false
+		}
+		return string(content.Tokens), true
+	}
+	return "", false
+}
+
+func mathConversionMathBlockSource(node *ast.Node) (string, bool) {
+	if node.Type != ast.NodeMathBlock {
+		return "", false
+	}
+	var content *ast.Node
+	for child := node.FirstChild; child != nil; child = child.Next {
+		if child.Type == ast.NodeMathBlockContent {
+			if content != nil {
+				return "", false
+			}
+			content = child
+			continue
+		}
+		if child.Type != ast.NodeMathBlockOpenMarker && child.Type != ast.NodeMathBlockCloseMarker {
+			return "", false
+		}
+	}
+	if content == nil {
+		return "", false
+	}
+	return string(content.Tokens), true
+}
+
+// SnapshotMathConversion 在事务执行锁内排空已排队编辑，再从同一次文档读取返回 raw original 版本和
+// 目标描述。该接口只读；权限角色由后续 HTTP 接线负责，这里仍校验加密笔记本可访问性和文件认证。
+func SnapshotMathConversion(blockID string) (*MathConversionSnapshot, error) {
+	if !ast.IsNodeIDPattern(blockID) {
+		return nil, failMathConversion(MathConversionInvalid, "invalid block ID")
+	}
+	flushLock.Lock()
+	isFlushing.Store(true)
+	defer func() {
+		isFlushing.Store(false)
+		flushLock.Unlock()
+	}()
+	for _, queued := range takeQueuedTransactions() {
+		flushTx(queued)
+	}
+
+	blockTree := mathConversionBlockTree(blockID)
+	if blockTree == nil {
+		return nil, failMathConversion(MathConversionConflict, "block not found")
+	}
+	if IsEncryptedBox(blockTree.BoxID) && GetEncryptedBoxState(blockTree.BoxID) != EncryptedBoxStateUnlocked {
+		return nil, failMathConversion(MathConversionPermission, "encrypted notebook is not unlocked")
+	}
+	tree, original, err := filesys.LoadTreeSnapshot(blockTree.BoxID, blockTree.Path, util.NewLute())
+	if err != nil {
+		if errors.Is(err, ErrEncryptedBoxNotUnlocked) {
+			return nil, failMathConversion(MathConversionPermission, err.Error())
+		}
+		return nil, failMathConversion(MathConversionIO, err.Error())
+	}
+	if tree == nil || tree.Root == nil || tree.ID != blockTree.RootID || tree.Box != blockTree.BoxID || tree.Path != blockTree.Path {
+		return nil, failMathConversion(MathConversionConflict, "document location changed while reading the source")
+	}
+	node := treenode.GetNodeInTree(tree, blockID)
+	if node == nil {
+		return nil, failMathConversion(MathConversionConflict, "target block is missing from the document")
+	}
+
+	snapshot := &MathConversionSnapshot{
+		Notebook:  tree.Box,
+		RootID:    tree.ID,
+		Path:      tree.Path,
+		Version:   mathConversionSourceVersion(original),
+		BlockType: node.Type.String(),
+		TopLevel:  node.Parent == tree.Root,
+	}
+	switch node.Type {
+	case ast.NodeParagraph:
+		for index, child := range mathConversionDirectChildren(node) {
+			if !mathConversionInlineCandidate(child) {
+				continue
+			}
+			target := MathConversionTarget{Path: []int{index}, Type: "inline-math"}
+			if !snapshot.TopLevel {
+				target.Reason = "nested math conversion is not supported"
+			} else if source, ok := mathConversionInlineSource(child); !ok {
+				target.Reason = "noncanonical inline math node"
+			} else if plan, buildErr := mathconversion.Build(mathconversion.Request{
+				Block: node, TargetPath: target.Path, Direction: mathconversion.InlineToBlock,
+				ExpectedSource: source, NewID: mathConversionSnapshotNewID(node),
+			}); buildErr != nil {
+				target.Reason = buildErr.Error()
+			} else {
+				target.Supported = true
+				target.Source = plan.Source
+			}
+			snapshot.Targets = append(snapshot.Targets, target)
+		}
+	case ast.NodeMathBlock:
+		target := MathConversionTarget{Path: []int{}, Type: "math-block"}
+		if !snapshot.TopLevel {
+			target.Reason = "nested math conversion is not supported"
+		} else if source, ok := mathConversionMathBlockSource(node); !ok {
+			target.Reason = "noncanonical math block node"
+		} else if plan, buildErr := mathconversion.Build(mathconversion.Request{
+			Block: node, TargetPath: target.Path, Direction: mathconversion.BlockToInline,
+			ExpectedSource: source, NewID: mathConversionSnapshotNewID(node),
+		}); buildErr != nil {
+			target.Reason = buildErr.Error()
+		} else {
+			target.Supported = true
+			target.Source = plan.Source
+		}
+		snapshot.Targets = append(snapshot.Targets, target)
+	}
+	return snapshot, nil
+}
+
+func mathConversionDirectChildren(node *ast.Node) []*ast.Node {
+	var children []*ast.Node
+	for child := node.FirstChild; child != nil; child = child.Next {
+		children = append(children, child)
+	}
+	return children
+}
+
+func mathConversionInlineCandidate(node *ast.Node) bool {
+	return node.Type == ast.NodeInlineMath ||
+		node.Type == ast.NodeTextMark && strings.Contains(node.TextMarkType, "inline-math")
+}
+
+func mathConversionSnapshotNewID(block *ast.Node) func() string {
+	used := mathConversionBlockIDSet(block)
+	return func() string {
+		for range 8 {
+			id := ast.NewNodeID()
+			if !used[id] {
+				used[id] = true
+				return id
+			}
+		}
+		return ""
+	}
+}
+
+func (tx *Transaction) doConvertMath(operation *Operation) *TxErr {
+	fail := func(err error) *TxErr {
+		return &TxErr{code: TxErrCodePushMsg, id: operation.ID, msg: err.Error(), cause: err}
+	}
+	if operation == nil {
+		return fail(failMathConversion(MathConversionInvalid, "missing conversion operation"))
+	}
+	if len(tx.DoOperations) != 1 {
+		return fail(failMathConversion(MathConversionInvalid, "math conversion requires a separate transaction"))
+	}
+	state := operation.mathConversion
+	if tx.isReplay {
+		if state == nil || state.blockID == "" || state.rootID == "" || state.notebook == "" || state.path == "" ||
+			len(state.before) != 1 || len(state.after) == 0 {
+			return fail(failMathConversion(MathConversionInvalid, "math conversion undo state is unavailable"))
+		}
+		if err := tx.replayMathConversion(operation, state); err != nil {
+			return fail(err)
+		}
+		return nil
+	}
+	if state == nil || len(state.before) != 0 || len(state.after) != 0 {
+		return fail(failMathConversion(MathConversionInvalid, "client-provided conversion snapshot is not allowed"))
+	}
+	request := state.request
+	if err := validateMathConversionRequest(request); err != nil {
+		return fail(err)
+	}
+	if err := tx.convertMathOperation(operation, state); err != nil {
+		return fail(err)
+	}
+	return nil
+}
+
+func (tx *Transaction) convertMathOperation(operation *Operation, state *mathConversionOperationState) error {
+	request := state.request
+	blockTree := mathConversionBlockTree(request.BlockID)
+	if blockTree == nil {
+		return failMathConversion(MathConversionConflict, "block not found")
+	}
+	if blockTree.BoxID != request.Notebook || blockTree.RootID != request.RootID || blockTree.Path != request.Path {
+		return failMathConversion(MathConversionConflict, "document location changed before commit")
+	}
+	if IsEncryptedBox(blockTree.BoxID) && GetEncryptedBoxState(blockTree.BoxID) != EncryptedBoxStateUnlocked {
+		return failMathConversion(MathConversionPermission, "encrypted notebook is not unlocked")
+	}
+
+	tree, err := tx.loadTree(request.BlockID)
+	if err != nil {
+		if errors.Is(err, ErrEncryptedBoxNotUnlocked) {
+			return failMathConversion(MathConversionPermission, err.Error())
+		}
+		return failMathConversion(MathConversionIO, err.Error())
+	}
+	if tree == nil || tree.Root == nil || tree.Box != request.Notebook || tree.ID != request.RootID || tree.Path != request.Path {
+		return failMathConversion(MathConversionConflict, "document location changed while reading the source")
+	}
+	file := tx.documentSource(tree)
+	if file == nil || file.Box != tree.Box || file.Path != tree.Path {
+		return failMathConversion(MathConversionInvalid, "document source journal is unavailable")
+	}
+	if mathConversionSourceVersion(file.Before) != request.ExpectedVersion {
+		return failMathConversion(MathConversionConflict, "document source changed since the snapshot")
+	}
+	if IsEncryptedBox(tree.Box) && !tx.sourceLeases[tree.Box] {
+		return failMathConversion(MathConversionPermission, "encrypted notebook lease is unavailable")
+	}
+
+	block := treenode.GetNodeInTree(tree, request.BlockID)
+	if block == nil {
+		return failMathConversion(MathConversionConflict, "target block is missing from the document")
+	}
+	if block.Parent != tree.Root {
+		return failMathConversion(MathConversionUnsupported, "nested math conversion is not supported")
+	}
+	if mathConversionReadonly(block) {
+		return failMathConversion(MathConversionPermission, "math conversion requires editable blocks")
+	}
+
+	existingIDs := mathConversionBlockIDSet(tree.Root)
+	usedIDs := maps.Clone(existingIDs)
+	var newIDErr error
+	newID := state.newID
+	if newID == nil {
+		newID = ast.NewNodeID
+	}
+	plan, err := mathconversion.Build(mathconversion.Request{
+		Block: block, TargetPath: request.TargetPath, Direction: request.Direction,
+		ExpectedSource: request.ExpectedSource,
+		NewID: func() string {
+			for range 32 {
+				id := newID()
+				if !usedIDs[id] {
+					usedIDs[id] = true
+					return id
+				}
+			}
+			newIDErr = failMathConversion(MathConversionConflict, "new block ID collides with an existing block")
+			return ""
+		},
+	})
+	if err != nil {
+		if newIDErr != nil {
+			return newIDErr
+		}
+		return mathConversionPlannerError(err)
+	}
+	if plan.PreservedID != request.BlockID {
+		return failMathConversion(MathConversionConflict, "planner changed the preserved block ID")
+	}
+	if len(plan.Fragments) == 0 {
+		return failMathConversion(MathConversionInvalid, "planner returned no replacement blocks")
+	}
+	before := mathConversionFragment{node: cloneBlockSwapNode(block)}
+	if err = validateMathConversionProposedIDs(plan.Fragments, map[string]bool{request.BlockID: true}, existingIDs); err != nil {
+		return err
+	}
+
+	beforePosition := mathConversionCapturePosition(block, block)
+	if len(beforePosition.ids) != 1 || beforePosition.ids[0] != request.BlockID {
+		return failMathConversion(MathConversionConflict, "target block position changed before commit")
+	}
+
+	inserted := make([]*ast.Node, 0, len(plan.Fragments))
+	for _, fragment := range plan.Fragments {
+		inserted = append(inserted, cloneBlockSwapNode(fragment))
+	}
+	if err = mathConversionReplaceRun([]*ast.Node{block}, inserted); err != nil {
+		return err
+	}
+	afterPosition := mathConversionCapturePosition(inserted[0], inserted[len(inserted)-1])
+
+	state.notebook, state.rootID, state.path, state.blockID = tree.Box, tree.ID, tree.Path, request.BlockID
+	state.before = []mathConversionFragment{before}
+	state.after = cloneMathConversionFragments(inserted)
+	state.beforePosition = beforePosition
+	state.afterPosition = afterPosition
+	inverse := &Operation{Action: "convertMath", ID: request.BlockID, BlockID: request.BlockID,
+		RetData: mathConversionFragmentIDs(state.before), mathConversion: state, mathConversionUndo: true}
+	tx.UndoOperations = []*Operation{inverse}
+	if err = tx.finishMathConversion(state.before, state.after, inserted, tree); err != nil {
+		return err
+	}
+	operation.RetData = mathConversionFragmentIDs(state.after)
+	return nil
+}
+
+func mathConversionBlockIDSetFromFragments(fragments []mathConversionFragment) map[string]bool {
+	ids := map[string]bool{}
+	for _, id := range mathConversionFragmentBlockIDs(fragments) {
+		ids[id] = true
+	}
+	return ids
+}
+
+func validateMathConversionProposedIDs(fragments []*ast.Node, allowed map[string]bool, used map[string]bool) error {
+	seen := map[string]bool{}
+	for _, fragment := range fragments {
+		for _, id := range fragment.BlockIDs() {
+			if seen[id] {
+				return failMathConversion(MathConversionConflict, "replacement blocks reuse a block ID")
+			}
+			seen[id] = true
+			if used[id] && !allowed[id] {
+				return failMathConversion(MathConversionConflict, "replacement block ID collides with an existing block")
+			}
+		}
+	}
+	return nil
+}
+
+func cloneMathConversionFragments(nodes []*ast.Node) []mathConversionFragment {
+	fragments := make([]mathConversionFragment, 0, len(nodes))
+	for _, node := range nodes {
+		fragments = append(fragments, mathConversionFragment{node: cloneBlockSwapNode(node)})
+	}
+	return fragments
+}
+
+func cloneMathConversionState(state *mathConversionOperationState) *mathConversionOperationState {
+	if state == nil {
+		return nil
+	}
+	cloned := *state
+	cloned.request.TargetPath = append([]int(nil), state.request.TargetPath...)
+	cloned.before = append([]mathConversionFragment(nil), state.before...)
+	cloned.after = append([]mathConversionFragment(nil), state.after...)
+	cloned.beforePosition.ids = append([]string(nil), state.beforePosition.ids...)
+	cloned.afterPosition.ids = append([]string(nil), state.afterPosition.ids...)
+	return &cloned
+}
+
+func mathConversionReplaceRun(from, to []*ast.Node) error {
+	if len(from) == 0 || len(to) == 0 {
+		return failMathConversion(MathConversionInvalid, "conversion replacement is empty")
+	}
+	if from[0].Parent == nil {
+		return failMathConversion(MathConversionConflict, "conversion target is detached")
+	}
+	for index := 1; index < len(from); index++ {
+		if mathConversionNextBlock(from[index-1]) != from[index] {
+			return failMathConversion(MathConversionConflict, "conversion target blocks are not contiguous")
+		}
+	}
+	for _, node := range to {
+		from[0].InsertBefore(node)
+	}
+	for _, node := range from {
+		node.Unlink()
+	}
+	return nil
+}
+
+func mathConversionValidateRun(tree *parse.Tree, fragments []mathConversionFragment, position mathConversionPosition) (run []*ast.Node, err error) {
+	if len(fragments) == 0 {
+		return nil, failMathConversion(MathConversionInvalid, "conversion undo snapshot is empty")
+	}
+	ids := mathConversionFragmentIDs(fragments)
+	if len(ids) != len(position.ids) {
+		return nil, failMathConversion(MathConversionConflict, "conversion undo position metadata is inconsistent")
+	}
+	for index := range ids {
+		if ids[index] != position.ids[index] {
+			return nil, failMathConversion(MathConversionConflict, "conversion undo block order changed")
+		}
+	}
+	first := mathConversionTopLevelBlock(tree, ids[0])
+	if first == nil {
+		return nil, failMathConversion(MathConversionConflict, "conversion block changed since the snapshot")
+	}
+	run = []*ast.Node{first}
+	for index := 1; index < len(ids); index++ {
+		next := mathConversionNextBlock(run[index-1])
+		if next == nil || next.ID != ids[index] {
+			return nil, failMathConversion(MathConversionConflict, "conversion block sequence changed since the snapshot")
+		}
+		run = append(run, next)
+	}
+	if previous := mathConversionPreviousBlock(first); (previous == nil && position.previousID != "") ||
+		(previous != nil && previous.ID != position.previousID) {
+		return nil, failMathConversion(MathConversionConflict, "conversion block position changed since the snapshot")
+	}
+	if next := mathConversionNextBlock(run[len(run)-1]); (next == nil && position.nextID != "") ||
+		(next != nil && next.ID != position.nextID) {
+		return nil, failMathConversion(MathConversionConflict, "conversion block position changed since the snapshot")
+	}
+	for index, node := range run {
+		if fragments[index].node == nil {
+			return nil, failMathConversion(MathConversionInvalid, "conversion undo snapshot is missing a block")
+		}
+		if mathConversionFingerprint(node) != mathConversionFingerprint(fragments[index].node) {
+			return nil, failMathConversion(MathConversionConflict, "conversion block content changed since the snapshot")
+		}
+	}
+	return run, nil
+}
+
+func validateMathConversionReplayIDs(tree *parse.Tree, from, to []mathConversionFragment) error {
+	used := mathConversionBlockIDSet(tree.Root)
+	removed := mathConversionBlockIDSetFromFragments(from)
+	seen := map[string]bool{}
+	for _, fragment := range to {
+		if fragment.node == nil {
+			return failMathConversion(MathConversionInvalid, "conversion replacement is missing")
+		}
+		for _, id := range fragment.node.BlockIDs() {
+			if seen[id] {
+				return failMathConversion(MathConversionConflict, "conversion replacement reuses a block ID")
+			}
+			seen[id] = true
+			if used[id] && !removed[id] {
+				return failMathConversion(MathConversionConflict, "conversion replacement block ID is already occupied")
+			}
+		}
+	}
+	return nil
+}
+
+func (tx *Transaction) replayMathConversion(operation *Operation, state *mathConversionOperationState) error {
+	tree, err := tx.loadTree(state.blockID)
+	if err != nil {
+		if errors.Is(err, ErrEncryptedBoxNotUnlocked) {
+			return failMathConversion(MathConversionPermission, err.Error())
+		}
+		return failMathConversion(MathConversionIO, err.Error())
+	}
+	if tree == nil || tree.Root == nil || tree.Box != state.notebook || tree.ID != state.rootID || tree.Path != state.path {
+		return failMathConversion(MathConversionConflict, "conversion document location changed since the snapshot")
+	}
+	if IsEncryptedBox(tree.Box) && !tx.sourceLeases[tree.Box] {
+		return failMathConversion(MathConversionPermission, "encrypted notebook lease is unavailable")
+	}
+
+	from, to := state.before, state.after
+	position := state.beforePosition
+	if operation.mathConversionUndo {
+		from, to = state.after, state.before
+		position = state.afterPosition
+	}
+	run, err := mathConversionValidateRun(tree, from, position)
+	if err != nil {
+		return err
+	}
+	if mathConversionReadonly(run[0]) {
+		return failMathConversion(MathConversionPermission, "math conversion requires editable blocks")
+	}
+	if err = validateMathConversionReplayIDs(tree, from, to); err != nil {
+		return err
+	}
+	inserted := make([]*ast.Node, 0, len(to))
+	for _, fragment := range to {
+		inserted = append(inserted, cloneBlockSwapNode(fragment.node))
+	}
+	if err = mathConversionReplaceRun(run, inserted); err != nil {
+		return err
+	}
+	if err = tx.finishMathConversion(from, to, inserted, tree); err != nil {
+		return err
+	}
+	operation.RetData = mathConversionFragmentIDs(to)
+	return nil
+}
+
+func (tx *Transaction) finishMathConversion(from, to []mathConversionFragment, inserted []*ast.Node, tree *parse.Tree) error {
+	fromIDs := mathConversionBlockIDSetFromFragments(from)
+	toIDs := mathConversionBlockIDSetFromFragments(to)
+	var removed []string
+	for id := range fromIDs {
+		if !toIDs[id] {
+			removed = append(removed, id)
+		}
+	}
+	if len(removed) > 0 {
+		if err := treenode.RemoveBlockTreesByIDsWithError(tree.Box, removed); err != nil {
+			tx.sourceErr = err
+			return failMathConversion(MathConversionIO, err.Error())
+		}
+	}
+	tx.writeTree(tree)
+	if tx.sourceErr != nil {
+		return failMathConversion(MathConversionIO, tx.sourceErr.Error())
+	}
+	for _, node := range inserted {
+		ast.Walk(node, func(current *ast.Node, entering bool) ast.WalkStatus {
+			if entering && current.IsBlock() && current.ID != "" {
+				tx.nodes[current.ID] = current
+				tx.markStructureCheck(current)
+			}
+			return ast.WalkContinue
+		})
+	}
+	return nil
+}
