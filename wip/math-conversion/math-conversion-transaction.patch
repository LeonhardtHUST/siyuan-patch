+		t.Fatalf("undo did not restore the original paragraph: %+v", restoredBlock)
+	}
+	if ids := mathConversionTopBlockIDs(restoredTree); !slices.Equal(ids, []string{beforeID, targetID, afterID}) {
+		t.Fatalf("undo changed top-level blocks: %v", ids)
+	}
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, original) {
+		t.Fatal("undo did not restore the exact original source bytes")
+	}
+
+	if err := mathConversionRedo(t, fixture.sourceID); err != nil {
+		t.Fatalf("redo failed: %v", err)
+	}
+	redoneTree := mathConversionLoadTree(t, fixture.sourceID)
+	redoneBlock := treenode.GetNodeInTree(redoneTree, targetID)
+	if redoneBlock == nil || redoneBlock.Type != ast.NodeMathBlock || mathConversionMathSource(redoneBlock) != "alpha + beta" {
+		t.Fatalf("redo did not restore the converted math block: %+v", redoneBlock)
