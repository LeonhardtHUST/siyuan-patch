+func TestMathConversionRedoIDCollisionRejected(t *testing.T) {
+	fixture := setupMathConversionTest(t)
+	tree := mathConversionLoadTree(t, fixture.sourceID)
+	targetID := "20260718001501-abcdefg"
+	target := mathConversionParagraph(targetID, mathConversionText("before"), mathConversionInline("redo + collision"), mathConversionText("after"))
+	mathConversionSetRootBlocks(t, tree, target)
+	mathConversionWriteTree(t, tree)
+	snapshot := mathConversionSnapshot(t, targetID)
+	request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+		BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{1},
+		ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+	if err := mathConversionPerform(t, request); err != nil {
+		t.Fatal(err)
+	}
+	convertedIDs := mathConversionTopBlockIDs(mathConversionLoadTree(t, fixture.sourceID))
+	if len(convertedIDs) != 3 || convertedIDs[0] != targetID {
+		t.Fatalf("unexpected converted blocks: %v", convertedIDs)
+	}
+	mathID := convertedIDs[1]
+	if err := mathConversionUndo(t, fixture.sourceID); err != nil {
+		t.Fatal(err)
+	}
+	if undoDepth, redoDepth := mathConversionUndoDepth(fixture.sourceID), mathConversionRedoDepth(fixture.sourceID); undoDepth != 0 || redoDepth != 1 {
+		t.Fatalf("unexpected undo stacks after undo: undo=%d redo=%d", undoDepth, redoDepth)
+	}
+
+	collision := mathConversionLoadTree(t, fixture.sourceID)
+	collision.Root.AppendChild(mathConversionParagraph(mathID, mathConversionText("occupied after undo")))
+	mathConversionWriteTree(t, collision)
+	beforeRedo := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	err := mathConversionRedo(t, fixture.sourceID)
+	requireMathConversionKind(t, err, MathConversionConflict)
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, beforeRedo) {
+		t.Fatal("failed redo overwrote the source with a colliding block ID")
+	}
+	if undoDepth, redoDepth := mathConversionUndoDepth(fixture.sourceID), mathConversionRedoDepth(fixture.sourceID); undoDepth != 0 || redoDepth != 1 {
+		t.Fatalf("failed redo must stay retryable: undo=%d redo=%d", undoDepth, redoDepth)
+	}
+}
