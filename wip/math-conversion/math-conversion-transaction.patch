+func TestMathConversionWriteFailureRollsBack(t *testing.T) {
+	fixture := setupMathConversionTest(t)
+	tree := mathConversionLoadTree(t, fixture.sourceID)
+	targetID := "20260718001101-abcdefg"
+	mathConversionSetRootBlocks(t, tree,
+		mathConversionParagraph(targetID, mathConversionInline("write + failure")),
+	)
+	mathConversionWriteTree(t, tree)
+	original := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	snapshot := mathConversionSnapshot(t, targetID)
+	request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+		BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{0},
+		ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+	operation, err := NewConvertMathOperation(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transaction := &Transaction{DoOperations: []*Operation{operation}, m: &sync.Mutex{}}
+	transaction.MarkFromAPI()
+	if err = transaction.begin(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if transaction.state.Load() == 1 {
+			transaction.rollback()
+		}
+	}()
+	if txErr := transaction.doConvertMath(operation); txErr != nil {
+		t.Fatalf("prepare conversion failed: %v", txErr)
+	}
+	injected := errors.New("injected math conversion write failure")
+	transaction.writeTransactionTree = func(*parse.Tree) error { return injected }
+	if err = transaction.commit(); !errors.Is(err, injected) {
+		t.Fatalf("unexpected commit result: %v", err)
+	}
+	transaction.rollback()
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, original) {
+		t.Fatal("write failure changed the document source")
+	}
+	if depth := mathConversionUndoDepth(fixture.sourceID); depth != 0 {
+		t.Fatalf("write failure added %d undo entries", depth)
+	}
+	block := treenode.GetNodeInTree(mathConversionLoadTree(t, fixture.sourceID), targetID)
+	if block == nil || block.Type != ast.NodeParagraph || mathConversionInlineSourceOf(block) != "write + failure" {
+		t.Fatalf("write failure did not restore the original block: %+v", block)
+	}
+}
