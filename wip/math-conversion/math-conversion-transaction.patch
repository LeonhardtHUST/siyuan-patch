+func TestMathConversionExternalWriteBeforeCommitRejected(t *testing.T) {
+	fixture := setupMathConversionTest(t)
+	tree := mathConversionLoadTree(t, fixture.sourceID)
+	targetID := "20260718001201-abcdefg"
+	neighborID := "20260718001200-abcdefg"
+	mathConversionSetRootBlocks(t, tree,
+		mathConversionParagraph(neighborID, mathConversionText("old neighbor")),
+		mathConversionParagraph(targetID, mathConversionInline("race + formula")),
+	)
+	mathConversionWriteTree(t, tree)
+	snapshot := mathConversionSnapshot(t, targetID)
+	request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+		BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{0},
+		ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+	operation, err := NewConvertMathOperation(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transaction := &Transaction{DoOperations: []*Operation{operation}, m: &sync.Mutex{}}
+	transaction.MarkFromAPI()
+	if err = transaction.begin(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if transaction.state.Load() == 1 {
+			transaction.rollback()
+		}
+	}()
+	if txErr := transaction.doConvertMath(operation); txErr != nil {
+		t.Fatalf("prepare conversion failed: %v", txErr)
+	}
+
+	newer := mathConversionLoadTree(t, fixture.sourceID)
+	treenode.GetNodeInTree(newer, neighborID).FirstChild.Tokens = []byte("external newer edit")
+	mathConversionWriteTree(t, newer)
+	external := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	if err = transaction.commit(); !errors.Is(err, util.ErrFileChanged) {
+		t.Fatalf("external write was not rejected: %v", err)
+	}
+	transaction.rollback()
+	if !errors.Is(transaction.sourceRollbackErr, util.ErrFileChanged) {
+		t.Fatalf("rollback did not report the preserved conflict: %v", transaction.sourceRollbackErr)
+	}
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, external) {
+		t.Fatal("conversion or rollback overwrote the external edit")
+	}
+	if err = recoverDocumentSources(); err != nil {
+		t.Fatal(err)
+	}
+	indexBox(fixture.box.ID)
+	sql.FlushQueue()
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, external) {
+		t.Fatal("recovery overwrote the external edit")
+	}
+	if depth := mathConversionUndoDepth(fixture.sourceID); depth != 0 {
+		t.Fatalf("failed conversion added %d undo entries", depth)
+	}
+}
