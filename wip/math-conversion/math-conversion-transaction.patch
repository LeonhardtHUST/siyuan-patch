+	original := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	loadedBeforeConversion := mathConversionLoadTree(t, fixture.sourceID)
+	originalFingerprint := mathConversionFingerprint(treenode.GetNodeInTree(loadedBeforeConversion, targetID))
+	neighborBeforeFingerprint := mathConversionFingerprint(treenode.GetNodeInTree(loadedBeforeConversion, beforeID))
+	neighborAfterFingerprint := mathConversionFingerprint(treenode.GetNodeInTree(loadedBeforeConversion, afterID))
+
+	snapshot := mathConversionSnapshot(t, targetID)
+	if len(snapshot.Targets) != 1 || !snapshot.Targets[0].Supported ||
+		!slices.Equal(snapshot.Targets[0].Path, []int{2}) || snapshot.Targets[0].Source != "a + b" {
+		t.Fatalf("unexpected mixed target: %+v", snapshot)
+	}
+	request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+		BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{2},
+		ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+	if err := mathConversionPerform(t, request); err != nil {
+		t.Fatalf("mixed conversion failed: %v", err)
+	}
+	converted := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	convertedTree := mathConversionLoadTree(t, fixture.sourceID)
+	ids := mathConversionTopBlockIDs(convertedTree)
+	if len(ids) != 5 || ids[0] != beforeID || ids[1] != targetID || ids[3] == "" || ids[4] != afterID {
+		t.Fatalf("unexpected mixed top-level block order: %v", ids)
+	}
+	mathID, textAfterID := ids[2], ids[3]
+	if mathID == targetID || textAfterID == targetID || mathID == textAfterID {
+		t.Fatalf("mixed conversion reused the preserved ID: %v", ids)
+	}
+	beforeBlock := treenode.GetNodeInTree(convertedTree, targetID)
+	if beforeBlock == nil || beforeBlock.Type != ast.NodeParagraph || beforeBlock.IALAttr("style") != "color: blue" ||
+		beforeBlock.FirstChild == nil || beforeBlock.FirstChild.Type != ast.NodeStrong ||
+		beforeBlock.FirstChild.Next == nil || string(beforeBlock.FirstChild.Next.Tokens) != " " {
+		t.Fatalf("mixed before fragment lost original content or IAL: %+v", beforeBlock)
+	}
+	mathBlock := treenode.GetNodeInTree(convertedTree, mathID)
+	if mathBlock == nil || mathBlock.Type != ast.NodeMathBlock || mathConversionMathSource(mathBlock) != "a + b" ||
+		mathBlock.IALAttr("style") != "color: blue" || mathBlock.IALAttr("updated") != "" {
+		t.Fatalf("unexpected mixed math fragment: %+v", mathBlock)
+	}
+	textAfter := treenode.GetNodeInTree(convertedTree, textAfterID)
+	if textAfter == nil || textAfter.Type != ast.NodeParagraph || textAfter.IALAttr("style") != "color: blue" ||
+		textAfter.IALAttr("updated") != "" || textAfter.FirstChild == nil || string(textAfter.FirstChild.Tokens) != " " ||
+		textAfter.FirstChild.Next == nil || textAfter.FirstChild.Next.Type != ast.NodeEmphasis {
+		t.Fatalf("unexpected mixed after fragment: %+v", textAfter)
+	}
+	if mathConversionFingerprint(treenode.GetNodeInTree(convertedTree, beforeID)) != neighborBeforeFingerprint ||
+		mathConversionFingerprint(treenode.GetNodeInTree(convertedTree, afterID)) != neighborAfterFingerprint {
+		t.Fatal("mixed conversion changed a neighboring block")
+	}
+
+	if err := mathConversionUndo(t, fixture.sourceID); err != nil {
+		t.Fatalf("mixed undo failed: %v", err)
+	}
+	restoredTree := mathConversionLoadTree(t, fixture.sourceID)
+	if got := mathConversionTopBlockIDs(restoredTree); !slices.Equal(got, []string{beforeID, targetID, afterID}) {
+		t.Fatalf("mixed undo changed top-level blocks: %v", got)
+	}
+	restored := treenode.GetNodeInTree(restoredTree, targetID)
+	if restored == nil || restored.Type != ast.NodeParagraph || mathConversionFingerprint(restored) != originalFingerprint {
+		t.Fatalf("mixed undo did not restore the original paragraph: %+v", restored)
+	}
+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, original) {
+		t.Fatal("mixed undo did not restore the exact original source bytes")
+	}
+
+	for range 2 {
+		if err := mathConversionRedo(t, fixture.sourceID); err != nil {
+			t.Fatalf("mixed redo failed: %v", err)
+		}
+		redoneTree := mathConversionLoadTree(t, fixture.sourceID)
+		if got := mathConversionTopBlockIDs(redoneTree); !slices.Equal(got, ids) {
+			t.Fatalf("mixed redo did not reuse snapshot IDs: got %v want %v", got, ids)
+		}
+		if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, converted) {
+			t.Fatal("mixed redo did not restore the converted source bytes")
+		}
+		if err := mathConversionUndo(t, fixture.sourceID); err != nil {
+			t.Fatalf("mixed second undo failed: %v", err)
+		}
+	}
+}
