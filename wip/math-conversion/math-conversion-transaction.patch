+
+func mathConversionUndo(t *testing.T, rootID string) error {
+	t.Helper()
+	entry := GlobalUndoLog.Undo(rootID)
+	if entry == nil {
+		return errors.New("undo stack is empty")
+	}
+	transaction := &Transaction{DoOperations: entry.UndoOperationsForReplay()}
+	transaction.MarkReplay()
+	if err := PerformTxSync(transaction); err != nil {
+		GlobalUndoLog.UndoRollback(entry, rootID)
+		return err
+	}
+	GlobalUndoLog.UndoCommit(entry, rootID)
+	return nil
+}
+
+func mathConversionRedo(t *testing.T, rootID string) error {
+	t.Helper()
+	entry := GlobalUndoLog.Redo(rootID)
+	if entry == nil {
+		return errors.New("redo stack is empty")
+	}
+	transaction := &Transaction{DoOperations: entry.DoOperationsForReplay()}
+	transaction.MarkReplay()
+	if err := PerformTxSync(transaction); err != nil {
+		GlobalUndoLog.RedoRollback(entry, rootID)
+		return err
+	}
+	GlobalUndoLog.RedoCommit(entry, rootID)
+	return nil
+}
+
+func mathConversionUndoDepth(rootID string) int {
+	GlobalUndoLog.mu.Lock()
+	defer GlobalUndoLog.mu.Unlock()
+	stack := GlobalUndoLog.stacks[rootID]
+	if stack == nil {
+		return 0
+	}
+	return len(stack.undoStack)
+}
+
+func mathConversionRedoDepth(rootID string) int {
+	GlobalUndoLog.mu.Lock()
+	defer GlobalUndoLog.mu.Unlock()
+	stack := GlobalUndoLog.stacks[rootID]
+	if stack == nil {
+		return 0
+	}
+	return len(stack.redoStack)
+}
