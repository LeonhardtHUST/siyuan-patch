+func TestMathConversionSnapshotDrainsQueuedEdits(t *testing.T) {
+	fixture := setupMathConversionTest(t)
+	tree := mathConversionLoadTree(t, fixture.sourceID)
+	targetID := "20260718001401-abcdefg"
+	neighborID := "20260718001400-abcdefg"
+	mathConversionSetRootBlocks(t, tree,
+		mathConversionParagraph(neighborID, mathConversionText("queued neighbor")),
+		mathConversionParagraph(targetID, mathConversionInline("queued + snapshot")),
+	)
+	mathConversionWriteTree(t, tree)
+
+	queued := []*Transaction{{DoOperations: []*Operation{{
+		Action: "setAttrs", ID: neighborID, Data: `{"custom-queued":"yes"}`,
+	}}}}
+	PerformTransactions(&queued)
+	snapshot := mathConversionSnapshot(t, targetID)
+	if txQueueSize() != 0 {
+		t.Fatalf("snapshot did not drain the transaction queue: %d", txQueueSize())
+	}
+	current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+	if snapshot.Version != mathConversionSourceVersion(current) {
+		t.Fatal("snapshot version does not match the source it read")
+	}
+	reloaded := treenode.GetNodeInTree(mathConversionLoadTree(t, fixture.sourceID), neighborID)
+	if reloaded.IALAttr("custom-queued") != "yes" {
+		t.Fatal("snapshot did not observe the drained edit")
+	}
+}
