+	if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, converted) {
+		t.Fatal("redo did not restore the converted source bytes")
+	}
+	if depth := mathConversionUndoDepth(fixture.sourceID); depth != 1 {
+		t.Fatalf("redo changed the undo entry count: %d", depth)
+	}
+}
