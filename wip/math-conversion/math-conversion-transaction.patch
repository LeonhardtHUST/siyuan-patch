+
+func mathConversionParagraph(id string, children ...*ast.Node) *ast.Node {
+	paragraph := &ast.Node{Type: ast.NodeParagraph, ID: id}
+	paragraph.SetIALAttr("id", id)
+	for _, child := range children {
+		paragraph.AppendChild(child)
+	}
+	return paragraph
+}
+
+func mathConversionText(text string) *ast.Node {
+	return &ast.Node{Type: ast.NodeText, Tokens: []byte(text)}
+}
+
+func mathConversionStrong(text string) *ast.Node {
+	strong := &ast.Node{Type: ast.NodeStrong}
+	strong.AppendChild(&ast.Node{Type: ast.NodeStrongA6kOpenMarker, Tokens: []byte("**")})
+	strong.AppendChild(mathConversionText(text))
+	strong.AppendChild(&ast.Node{Type: ast.NodeStrongA6kCloseMarker, Tokens: []byte("**")})
+	return strong
+}
+
+func mathConversionEmphasis(text string) *ast.Node {
+	emphasis := &ast.Node{Type: ast.NodeEmphasis}
+	emphasis.AppendChild(&ast.Node{Type: ast.NodeEmA6kOpenMarker, Tokens: []byte("*")})
+	emphasis.AppendChild(mathConversionText(text))
+	emphasis.AppendChild(&ast.Node{Type: ast.NodeEmA6kCloseMarker, Tokens: []byte("*")})
+	return emphasis
+}
+
+func mathConversionInline(source string) *ast.Node {
+	return &ast.Node{Type: ast.NodeTextMark, TextMarkType: "inline-math", TextMarkInlineMathContent: source}
+}
+
+func mathConversionMathBlock(id, source string) *ast.Node {
+	block := &ast.Node{Type: ast.NodeMathBlock, ID: id}
+	block.SetIALAttr("id", id)
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockOpenMarker, Tokens: []byte("$$")})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockContent, Tokens: []byte(source)})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockCloseMarker, Tokens: []byte("$$")})
+	return block
+}
+
+func mathConversionTopBlockIDs(tree *parse.Tree) []string {
+	var ids []string
+	for node := tree.Root.FirstChild; node != nil; node = node.Next {
+		if node.IsBlock() && node.ID != "" {
+			ids = append(ids, node.ID)
+		}
+	}
+	return ids
+}
+
+func mathConversionMathSource(node *ast.Node) string {
+	if node == nil || node.Type != ast.NodeMathBlock {
+		return ""
+	}
+	content := node.ChildByType(ast.NodeMathBlockContent)
+	if content == nil {
+		return ""
+	}
+	return string(content.Tokens)
+}
+
+func mathConversionInlineSourceOf(node *ast.Node) string {
+	if node == nil || node.Type != ast.NodeParagraph {
+		return ""
+	}
+	for child := node.FirstChild; child != nil; child = child.Next {
+		if child.Type == ast.NodeTextMark && child.TextMarkType == "inline-math" {
+			return child.TextMarkInlineMathContent
+		}
+	}
+	return ""
+}
