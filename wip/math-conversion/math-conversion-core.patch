+
+package mathconversion
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/88250/lute/ast"
+)
+
+const originalID = "20261117140000-origina"
+
+func paragraph(source string, native bool, before, after string) *ast.Node {
+	block := &ast.Node{Type: ast.NodeParagraph, ID: originalID}
+	block.SetIALAttr("id", originalID)
+	block.SetIALAttr("updated", "20261117140000")
+	if before != "" {
+		block.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(before)})
+	}
+	if native {
+		math := &ast.Node{Type: ast.NodeInlineMath}
+		math.AppendChild(&ast.Node{Type: ast.NodeInlineMathOpenMarker, Tokens: []byte("$")})
+		math.AppendChild(&ast.Node{Type: ast.NodeInlineMathContent, Tokens: []byte(source)})
+		math.AppendChild(&ast.Node{Type: ast.NodeInlineMathCloseMarker, Tokens: []byte("$")})
+		block.AppendChild(math)
+	} else {
+		block.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "inline-math", TextMarkInlineMathContent: source})
+	}
+	if after != "" {
+		block.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(after)})
+	}
+	return block
+}
+
+func allocator() func() string {
+	counter := 0
+	return func() string { counter++; return fmt.Sprintf("20261117140000-new%04d", counter) }
+}
+
+func request(block *ast.Node, index int, source string) Request {
+	return Request{Block: block, Direction: InlineToBlock, TargetPath: []int{index}, ExpectedSource: source, NewID: allocator()}
+}
+
+func snapshot(node *ast.Node) string {
+	if node == nil {
+		return "nil"
+	}
+	copied := *node
+	copied.Parent, copied.Previous, copied.Next, copied.FirstChild, copied.LastChild = nil, nil, nil, nil, nil
+	data, _ := json.Marshal(copied)
+	result := fmt.Sprintf("%s|%d|%q|%v|", data, node.Type, node.Tokens, node.KramdownIAL)
+	for child := node.FirstChild; child != nil; child = child.Next {
+		result += "[" + snapshot(child) + "]"
+	}
+	return result
+}
+
+func requireKind(t *testing.T, err error, kind Kind) {
+	t.Helper()
+	var typed *Error
+	if !errors.As(err, &typed) || typed.Kind != kind {
+		t.Fatalf("want %s, got %v", kind, err)
+	}
+}
+
+func TestSoleAndInverse(t *testing.T) {
+	for _, native := range []bool{false, true} {
+		t.Run(fmt.Sprint(native), func(t *testing.T) {
+			block := paragraph(`\t{alpha}`, native, "", "")
+			block.SetIALAttr("bookmark", "remember")
+			block.SetIALAttr("custom-private", "keep")
+			original := snapshot(block)
+			plan, err := Build(request(block, 0, `\t{alpha}`))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if plan.PreservedID != originalID || len(plan.CreatedIDs) != 0 || !reflect.DeepEqual(plan.Fragments[0].KramdownIAL, block.KramdownIAL) {
+				t.Fatal("identity not retained")
+			}
+			beforeSnapshot := snapshot(plan.Before)
+			inverse, err := Build(Request{Block: plan.Fragments[0], Direction: BlockToInline, ExpectedSource: plan.Source})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if inverse.Source != plan.Source || inverse.Fragments[0].ID != originalID || !reflect.DeepEqual(inverse.Fragments[0].KramdownIAL, block.KramdownIAL) {
+				t.Fatal("inverse changed identity")
+			}
+			inverse.Fragments[0].SetIALAttr("custom-private", "changed")
+			if snapshot(block) != original || snapshot(plan.Before) != beforeSnapshot {
+				t.Fatal("inverse aliased original snapshots")
+			}
+		})
+	}
+}
+
+func TestMixedAllocation(t *testing.T) {
+	for _, texts := range [][2]string{{"before", "after"}, {"before", ""}, {"", "after"}} {
+		for _, native := range []bool{false, true} {
+			t.Run(fmt.Sprint(texts, native), func(t *testing.T) {
+				block := paragraph("x", native, texts[0], texts[1])
+				block.SetIALAttr("style", "color: red;")
+
+				original := snapshot(block)
+				index := 0
+				if texts[0] != "" {
+					index = 1
+				}
+				plan, err := Build(request(block, index, "x"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				mathIndex := 0
+				if texts[0] != "" {
+					mathIndex = 1
+				}
+				if plan.Fragments[mathIndex].Type != ast.NodeMathBlock || plan.FocusBlockID != plan.Fragments[mathIndex].ID {
+					t.Fatal("bad math focus")
+				}
+				owner := 0
+				if texts[0] == "" {
+					owner = 1
+				}
+				if plan.Fragments[owner].ID != originalID || !reflect.DeepEqual(plan.Fragments[owner].KramdownIAL, block.KramdownIAL) {
+					t.Fatal("original paragraph identity misplaced")
+				}
+				for _, fragment := range plan.Fragments {
+					if fragment.ID == originalID {
+						continue
+					}
+					for _, attribute := range fragment.KramdownIAL {
+						if attribute[0] != "id" && attribute[0] != "style" && attribute[0] != "direction" {
+							t.Fatal("copied identity attribute")
+						}
+					}
+				}
+				if snapshot(block) != original || snapshot(plan.Before) != original {
+					t.Fatal("mutation")
+				}
+			})
+		}
+	}
+}
+
+func TestSourceExperiments(t *testing.T) {
+	sources := []string{"x", "x\r\ny", " x", "x ", "x$y", "数学 α", `<x a="b">&'`, "x\ty", `\t{alpha}`, `\traw{alpha}`, "", "\n", "a\nb"}
+	for _, source := range sources {
+		for _, native := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%q/native=%v", source, native), func(t *testing.T) {
+				block := paragraph(source, native, "", "")
+				original := snapshot(block)
+				plan, err := Build(request(block, 0, source))
+				expectedUnsupported := source == "x\r\ny" || source == " x" || source == "x " || source == "\n"
+				if (err != nil) != expectedUnsupported {
+					t.Fatalf("inline-to-block support changed for %q: %v", source, err)
+				}
+				if err != nil {
+					requireKind(t, err, Unsupported)
+					t.Logf("inline-to-block unsupported: %v", err)
+				} else {
+					t.Log("inline-to-block supported")
+					if plan.Source != source {
+						t.Fatal("source changed")
+					}
+					inverse, inverseErr := Build(Request{Block: plan.Fragments[0], Direction: BlockToInline, ExpectedSource: source})
+					if (inverseErr != nil) != (source == "" || source == "a\nb") {
+						t.Fatalf("inverse support changed for %q: %v", source, inverseErr)
+					}
+					if inverseErr != nil {
+						requireKind(t, inverseErr, Unsupported)
+						t.Logf("block-to-inline unsupported: %v", inverseErr)
+					} else if inverse.Source != source {
+						t.Fatal("inverse source changed")
+					} else {
+						t.Log("block-to-inline supported")
+					}
+				}
+				if snapshot(block) != original {
+					t.Fatal("source failure mutated original")
+				}
+			})
+		}
+	}
+}
+
+func TestErrorsAndUniquePath(t *testing.T) {
+	block := paragraph("x", false, "before", "after")
+	block.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "inline-math", TextMarkInlineMathContent: "x"})
+	plan, err := Build(request(block, 3, "x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(plan.Fragments) != 2 || plan.Fragments[0].LastChild.Type != ast.NodeText {
+		t.Fatal("did not select unique path")
+	}
+	cases := []struct {
+		name   string
+		mutate func(*Request)
+		kind   Kind
+	}{
+		{"stale", func(input *Request) { input.ExpectedSource = "other" }, Conflict},
+		{"missing", func(input *Request) { input.TargetPath = []int{9} }, Conflict},
+		{"negative", func(input *Request) { input.TargetPath = []int{-1} }, Invalid},
+		{"nested", func(input *Request) { input.TargetPath = []int{1, 0} }, Conflict},
+		{"empty-id", func(input *Request) { input.NewID = func() string { return "" } }, Invalid},
+		{"bad-id", func(input *Request) { input.NewID = func() string { return "bad" } }, Invalid},
+		{"original-id", func(input *Request) { input.NewID = func() string { return originalID } }, Invalid},
+		{"new-id-collision", func(input *Request) { input.NewID = func() string { return "20261117140000-new0001" } }, Invalid},
+		{"missing-id-callback", func(input *Request) { input.NewID = nil }, Invalid},
+		{"identity-IAL", func(input *Request) { input.Block.SetIALAttr("bookmark", "keep") }, Unsupported},
+		{"unknown-IAL", func(input *Request) { input.Block.SetIALAttr("custom-x", "keep") }, Unsupported},
+		{"styled-target", func(input *Request) { input.Block.FirstChild.Next.SetIALAttr("style", "color:red") }, Unsupported},
+		{"compound-target", func(input *Request) { input.Block.FirstChild.Next.TextMarkType = "strong inline-math" }, Unsupported},
+	}
+	for _, testcase := range cases {
+		t.Run(testcase.name, func(t *testing.T) {
+			input := request(paragraph("x", false, "before", "after"), 1, "x")
+			testcase.mutate(&input)
+			original := snapshot(input.Block)
+			_, err := Build(input)
+			requireKind(t, err, testcase.kind)
+			if snapshot(input.Block) != original {
+				t.Fatal("failure mutated input")
+			}
+		})
+	}
+}
+
+func TestNoAlias(t *testing.T) {
+	block := paragraph("x", false, "before", "after")
+	block.FirstChild.Tokens = []byte("before")
+	block.FirstChild.Properties = map[string]string{"custom": "value"}
+	block.FirstChild.CodeBlockInfo = []byte("info")
+	block.FirstChild.LinkRefLabel = []byte("label")
+	block.FirstChild.TableAligns = []int{1, 2}
+	block.FirstChild.ListData = &ast.ListData{Marker: []byte("-")}
+	original := snapshot(block)
+	copied, err := clone(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	copied.FirstChild.Tokens[0] = 'X'
+	copied.FirstChild.Properties["custom"] = "changed"
+	copied.FirstChild.CodeBlockInfo[0] = 'X'
+	copied.FirstChild.LinkRefLabel[0] = 'X'
+	copied.FirstChild.TableAligns[0] = 9
+	copied.FirstChild.ListData.Marker[0] = 'X'
+	copied.KramdownIAL[0][1] = "changed"
+	if snapshot(block) != original {
+		t.Fatal("clone aliased mutable fields")
+	}
+	planBlock := paragraph("x", false, "before", "after")
+	plan, err := Build(request(planBlock, 1, "x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := snapshot(plan.Before)
+	original = snapshot(planBlock)
+	plan.Fragments[0].FirstChild.Tokens[0] = 'X'
+	plan.Fragments[0].KramdownIAL[0][1] = "changed"
+	if snapshot(plan.Before) != before || snapshot(planBlock) != original {
+		t.Fatal("plan aliases input or before")
+	}
+}
+
+func TestWrappedAndRichRefusal(t *testing.T) {
+	for _, kind := range []ast.NodeType{ast.NodeStrong, ast.NodeEmphasis, ast.NodeLink} {
+		block := paragraph("x", false, "", "")
+		target := block.FirstChild
+		target.Unlink()
+		wrapper := &ast.Node{Type: kind}
+		wrapper.AppendChild(target)
+		block.AppendChild(wrapper)
+		_, err := Build(Request{Block: block, Direction: InlineToBlock, TargetPath: []int{0, 0}, ExpectedSource: "x"})
+		requireKind(t, err, Unsupported)
+	}
+	block := paragraph("x", false, "", "")
+	block.TableCellRich = &ast.TableCellRich{}
+	_, err := Build(request(block, 0, "x"))
+	requireKind(t, err, Unsupported)
+}
+
+func TestOutsideMarks(t *testing.T) {
+	for _, mark := range []string{"strong", "em", "code", "a"} {
+		block := paragraph("x", false, "", "after")
+		outside := &ast.Node{Type: ast.NodeTextMark, TextMarkType: mark, TextMarkTextContent: "outside &lt;中文&gt;"}
+		if mark == "a" {
+			outside.TextMarkAHref = "https://example.org/?a=1&amp;b=2"
+			outside.TextMarkATitle = "title"
+		}
+		block.PrependChild(outside)
+		original := snapshot(block)
+		plan, err := Build(request(block, 1, "x"))
+		if err != nil {
+			t.Fatalf("%s: %v", mark, err)
+		}
+		if snapshot(plan.Fragments[0].FirstChild) != snapshot(outside) || snapshot(block) != original {
+			t.Fatal("outside mark changed")
+		}
+	}
+}
