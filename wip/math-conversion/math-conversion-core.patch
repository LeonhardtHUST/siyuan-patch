diff --git a/kernel/mathconversion/bounds.go b/kernel/mathconversion/bounds.go
new file mode 100644
index 0000000..41298b9
--- /dev/null
+++ b/kernel/mathconversion/bounds.go
@@ -0,0 +1,211 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"github.com/88250/lute/ast"
+)
+
+// 预算是单个 forest 的：一个或多个互不共享节点的根，连同各自全部后代。深度、节点、源字节、元数据
+// 字节与元数据条目数在 forest 内累计，多根与单根使用同一组上限。根自身的 Parent/Previous/Next 属于
+// 调用方上下文，只允许存在而不向外遍历；后代必须通过一致的 Parent/Previous/LastChild 链接构成无环
+// 树。转换后的输出 forest 在进入 JSON 与 Lute 之前，以及 JSON/BlockDOM 回载之后，都按同一组上限
+// 继续核验。
+//
+// 源预算按 len 统计全部变长字符串和字节字段；元数据预算同时统计字节与条目数，零长度 IAL/属性对也
+// 各占一个条目。已不支持的 Children、TableCellRich、DocumentTitle 和 FootnotesRefs 在展开其外部
+// graph 之前直接拒绝。
+const (
+	maxForestDepth           = 256
+	maxForestNodes           = 16384
+	maxForestSourceBytes     = 1 << 20
+	maxForestMetadataBytes   = 256 << 10
+	maxForestMetadataEntries = 16384
+	maxNodeIALEntries        = 256
+	maxTargetPathLength      = maxForestDepth
+	maxBlockIDLength         = 256
+)
+
+func preflightRequest(request Request) error {
+	block := request.Block
+	if block == nil || len(block.ID) > maxBlockIDLength || !validID.MatchString(block.ID) {
+		return fail(Invalid, "missing block or invalid block ID")
+	}
+	if request.Direction != InlineToBlock && request.Direction != BlockToInline {
+		return fail(Invalid, "unknown direction")
+	}
+	if len(request.TargetPath) > maxTargetPathLength {
+		return fail(Unsupported, "AST target path exceeds depth budget")
+	}
+	for _, index := range request.TargetPath {
+		if index < 0 {
+			return fail(Invalid, "negative AST child index")
+		}
+	}
+	if len(request.ExpectedSource) > maxForestSourceBytes {
+		return fail(Unsupported, "expected formula source exceeds source budget")
+	}
+	return preflightForest([]*ast.Node{block})
+}
+
+type forestFrame struct {
+	node     *ast.Node
+	parent   *ast.Node
+	previous *ast.Node
+	depth    int
+}
+
+// preflightForest 用显式栈遍历，不递归也不复制节点；任何 cycle、共享节点、链接不一致或超预算都在
+// clone、后续递归和 NewID 回调之前返回分类错误。
+func preflightForest(roots []*ast.Node) error {
+	return preflightForestDepth(roots, 1)
+}
+
+// preflightDocument 把文档根视为容器，子块从深度 1 开始，使 JSON/BlockDOM 回载的块与输入块使用同一
+// 深度语义；文档根自身仍计入节点、源和元数据预算。
+func preflightDocument(root *ast.Node) error {
+	return preflightForestDepth([]*ast.Node{root}, 0)
+}
+
+func preflightForestDepth(roots []*ast.Node, rootDepth int) error {
+	seen := make(map[*ast.Node]bool, len(roots))
+	external := make([]*ast.Node, 0, len(roots)*3)
+	budget := forestBudget{}
+	stack := make([]forestFrame, 0, 32)
+	for index := len(roots) - 1; index >= 0; index-- {
+		root := roots[index]
+		if root == nil {
+			return fail(Invalid, "AST forest contains a nil root")
+		}
+		if seen[root] {
+			return fail(Invalid, "AST forest reuses a root node")
+		}
+		seen[root] = true
+		if err := budget.add(root); err != nil {
+			return err
+		}
+		external = append(external, root.Parent, root.Previous, root.Next)
+		stack = append(stack, forestFrame{node: root, depth: rootDepth})
+	}
+	for len(stack) > 0 {
+		frame := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		node := frame.node
+		if frame.parent != nil {
+			if node.Parent != frame.parent || node.Previous != frame.previous {
+				return fail(Invalid, "AST sibling or parent link is inconsistent")
+			}
+		}
+		var last *ast.Node
+		for child := node.FirstChild; child != nil; child = child.Next {
+			if child == node {
+				return fail(Invalid, "AST child graph contains a cycle")
+			}
+			if seen[child] {
+				return fail(Invalid, "AST child graph contains a cycle or shared node")
+			}
+			if aliasesExternal(child, external) {
+				return fail(Invalid, "AST child aliases root-external context")
+			}
+			seen[child] = true
+			if err := budget.add(child); err != nil {
+				return err
+			}
+			depth := frame.depth + 1
+			if depth > maxForestDepth {
+				return fail(Unsupported, "AST forest exceeds depth budget")
+			}
+			stack = append(stack, forestFrame{node: child, parent: node, previous: last, depth: depth})
+			last = child
+		}
+		if node.LastChild != last {
+			return fail(Invalid, "AST last child link is inconsistent")
+		}
+	}
+	return nil
+}
+
+func aliasesExternal(node *ast.Node, external []*ast.Node) bool {
+	for _, outer := range external {
+		if outer != nil && outer == node {
+			return true
+		}
+	}
+	return false
+}
+
+type forestBudget struct {
+	nodes           int
+	sourceBytes     int
+	metadataBytes   int
+	metadataEntries int
+}
+
+func (budget *forestBudget) add(node *ast.Node) error {
+	if node.TableCellRich != nil || node.DocumentTitle != nil || len(node.FootnotesRefs) != 0 || len(node.Children) != 0 {
+		return fail(Unsupported, "rich table, document title, footnote references or unresolved JSON children")
+	}
+	budget.nodes++
+	if budget.nodes > maxForestNodes {
+		return fail(Unsupported, "AST forest exceeds node budget")
+	}
+	if len(node.KramdownIAL) > maxNodeIALEntries {
+		return fail(Unsupported, "AST node IAL exceeds entry budget")
+	}
+	for _, attribute := range node.KramdownIAL {
+		if len(attribute) != 2 {
+			return fail(Unsupported, "malformed block IAL entry")
+		}
+	}
+	budget.metadataEntries += len(node.KramdownIAL) + len(node.Properties) + len(node.TableAligns)
+	if budget.metadataEntries > maxForestMetadataEntries {
+		return fail(Unsupported, "AST forest metadata exceeds entry budget")
+	}
+	budget.sourceBytes += nodeSourceBytes(node)
+	if budget.sourceBytes > maxForestSourceBytes {
+		return fail(Unsupported, "AST forest source exceeds source budget")
+	}
+	budget.metadataBytes += nodeMetadataBytes(node)
+	if budget.metadataBytes > maxForestMetadataBytes {
+		return fail(Unsupported, "AST forest metadata exceeds metadata budget")
+	}
+	return nil
+}
+
+// nodeSourceBytes 统计节点上全部变长字符串和字节字段，包括 ID、路径等标识，避免任何字段绕过预算。
+func nodeSourceBytes(node *ast.Node) int {
+	total := len(node.ID) + len(node.Box) + len(node.Path) + len(node.Spec) +
+		len(node.TypeStr) + len(node.Data) + len(node.Tokens) +
+		len(node.CodeBlockOpenFence) + len(node.CodeBlockInfo) + len(node.CodeBlockCloseFence) +
+		len(node.LinkRefLabel) + len(node.FootnotesRefLabel) + len(node.HtmlEntityTokens) +
+		len(node.HeadingNormalizedID) + len(node.FootnotesRefId) +
+		len(node.TextMarkType) + len(node.TextMarkAHref) + len(node.TextMarkATitle) +
+		len(node.TextMarkInlineMathContent) + len(node.TextMarkInlineMemoContent) +
+		len(node.TextMarkBlockRefID) + len(node.TextMarkBlockRefSubtype) +
+		len(node.TextMarkFileAnnotationRefID) + len(node.TextMarkFlashcardOcclusionID) +
+		len(node.TextMarkTextContent) +
+		len(node.AttributeViewID) + len(node.AttributeViewType) +
+		len(node.CustomBlockInfo) + len(node.CalloutType) + len(node.CalloutTitle) +
+		len(node.TabItemTitle) + len(node.CalloutIcon)
+	if node.ListData != nil {
+		total += len(node.ListData.Marker)
+	}
+	return total
+}
+
+// nodeMetadataBytes 统计 IAL、属性 map 和表格对齐切片的开销；节点结构本身由节点预算约束。
+func nodeMetadataBytes(node *ast.Node) int {
+	total := 8 * len(node.TableAligns)
+	for _, attribute := range node.KramdownIAL {
+		total += 16
+		for _, value := range attribute {
+			total += len(value)
+		}
+	}
+	for key, value := range node.Properties {
+		total += 16 + len(key) + len(value)
+	}
+	return total
+}
diff --git a/kernel/mathconversion/bounds_test.go b/kernel/mathconversion/bounds_test.go
new file mode 100644
index 0000000..c3b7ce9
--- /dev/null
+++ b/kernel/mathconversion/bounds_test.go
@@ -0,0 +1,243 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/88250/lute/ast"
+)
+
+func countingAllocator() (func() string, *int) {
+	calls := 0
+	return func() string {
+		calls++
+		return fmt.Sprintf("20261117140000-new%04d", calls)
+	}, &calls
+}
+
+func chain(depth int) *ast.Node {
+	root := &ast.Node{Type: ast.NodeText}
+	current := root
+	for index := 1; index < depth; index++ {
+		child := &ast.Node{Type: ast.NodeText}
+		current.AppendChild(child)
+		current = child
+	}
+	return root
+}
+
+func wideForest(nodes int) *ast.Node {
+	root := &ast.Node{Type: ast.NodeParagraph}
+	for index := 1; index < nodes; index++ {
+		root.AppendChild(&ast.Node{Type: ast.NodeText})
+	}
+	return root
+}
+
+func zeroByteIAL(entries int) [][]string {
+	pairs := make([][]string, entries)
+	for index := range pairs {
+		pairs[index] = []string{"", ""}
+	}
+	return pairs
+}
+
+func zeroByteIALForest(entries int) *ast.Node {
+	root := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: zeroByteIAL(maxNodeIALEntries)}
+	entries -= maxNodeIALEntries
+	for entries > 0 {
+		childEntries := entries
+		if childEntries > maxNodeIALEntries {
+			childEntries = maxNodeIALEntries
+		}
+		root.AppendChild(&ast.Node{Type: ast.NodeText, KramdownIAL: zeroByteIAL(childEntries)})
+		entries -= childEntries
+	}
+	return root
+}
+
+// TestPreflightRejectsMalformedGraphBeforeClone 只调用新 preflight 代码验证旧的致命图；不会执行
+// clone、递归渲染或旧危险路径。所有失败都必须保持 NewID 零调用，且可安全快照的输入保持原样。
+func TestPreflightRejectsMalformedGraphBeforeClone(t *testing.T) {
+	cases := []struct {
+		name       string
+		mutate     func(*ast.Node)
+		kind       Kind
+		checkInput bool
+	}{
+		{"first-child-self", func(block *ast.Node) {
+			block.FirstChild, block.LastChild = block, block
+		}, Invalid, false},
+		{"next-self", func(block *ast.Node) {
+			block.FirstChild.Next.Next = block.FirstChild.Next
+		}, Invalid, false},
+		{"next-cycle", func(block *ast.Node) {
+			block.LastChild.Next = block.FirstChild
+		}, Invalid, false},
+		{"shared-child", func(block *ast.Node) {
+			block.FirstChild.FirstChild, block.FirstChild.LastChild = block.FirstChild.Next, block.FirstChild.Next
+		}, Invalid, false},
+		{"parent-link", func(block *ast.Node) {
+			block.FirstChild.Next.Parent = nil
+		}, Invalid, true},
+		{"previous-link", func(block *ast.Node) {
+			block.LastChild.Previous = nil
+		}, Invalid, true},
+		{"last-child", func(block *ast.Node) {
+			block.LastChild = block.FirstChild
+		}, Invalid, true},
+		{"root-alias", func(block *ast.Node) {
+			block.Parent = block.FirstChild.Next
+		}, Invalid, true},
+		{"unresolved-children", func(block *ast.Node) {
+			block.FirstChild.Next.Children = []*ast.Node{{}}
+		}, Unsupported, true},
+		{"depth-budget", func(block *ast.Node) {
+			block.FirstChild.AppendChild(chain(maxForestDepth))
+		}, Unsupported, false},
+		{"node-budget", func(block *ast.Node) {
+			for index := 0; index < maxForestNodes; index++ {
+				block.AppendChild(&ast.Node{Type: ast.NodeText})
+			}
+		}, Unsupported, false},
+		{"source-budget", func(block *ast.Node) {
+			block.FirstChild.Tokens = make([]byte, maxForestSourceBytes)
+		}, Unsupported, false},
+		{"metadata-budget", func(block *ast.Node) {
+			block.SetIALAttr("custom-large", strings.Repeat("v", maxForestMetadataBytes))
+		}, Unsupported, false},
+	}
+	for _, testcase := range cases {
+		t.Run(testcase.name, func(t *testing.T) {
+			block := paragraph("x", false, "before", "after")
+			newID, calls := countingAllocator()
+			testcase.mutate(block)
+			var original string
+			if testcase.checkInput {
+				original = snapshot(block)
+			}
+			_, err := Build(Request{Block: block, Direction: InlineToBlock, TargetPath: []int{1}, ExpectedSource: "x", NewID: newID})
+			requireKind(t, err, testcase.kind)
+			if *calls != 0 {
+				t.Fatalf("NewID called %d times on rejected input", *calls)
+			}
+			if testcase.checkInput && snapshot(block) != original {
+				t.Fatal("preflight mutated the rejected input")
+			}
+		})
+	}
+}
+
+func TestPreflightRejectsOversizedRequestFields(t *testing.T) {
+	cases := []struct {
+		name  string
+		input func(*ast.Node, func() string) Request
+		kind  Kind
+	}{
+		{"expected-source", func(block *ast.Node, newID func() string) Request {
+			return Request{Block: block, Direction: InlineToBlock, TargetPath: []int{1},
+				ExpectedSource: strings.Repeat("x", maxForestSourceBytes+1), NewID: newID}
+		}, Unsupported},
+		{"target-path", func(block *ast.Node, newID func() string) Request {
+			return Request{Block: block, Direction: InlineToBlock, TargetPath: make([]int, maxTargetPathLength+1),
+				ExpectedSource: "x", NewID: newID}
+		}, Unsupported},
+		{"target-index", func(block *ast.Node, newID func() string) Request {
+			return Request{Block: block, Direction: InlineToBlock, TargetPath: []int{maxForestNodes + 1},
+				ExpectedSource: "x", NewID: newID}
+		}, Conflict},
+		{"block-id", func(block *ast.Node, newID func() string) Request {
+			block.ID = strings.Repeat("a", maxBlockIDLength+1)
+			return Request{Block: block, Direction: InlineToBlock, TargetPath: []int{1}, ExpectedSource: "x", NewID: newID}
+		}, Invalid},
+	}
+	for _, testcase := range cases {
+		t.Run(testcase.name, func(t *testing.T) {
+			block := paragraph("x", false, "before", "after")
+			newID, calls := countingAllocator()
+			input := testcase.input(block, newID)
+			original := snapshot(block)
+			_, err := Build(input)
+			requireKind(t, err, testcase.kind)
+			if *calls != 0 {
+				t.Fatalf("NewID called %d times on rejected input", *calls)
+			}
+			if snapshot(block) != original {
+				t.Fatal("request preflight mutated the rejected input")
+			}
+		})
+	}
+}
+
+func TestPreflightBudgetBoundaries(t *testing.T) {
+	t.Run("depth", func(t *testing.T) {
+		if err := preflightForest([]*ast.Node{chain(maxForestDepth)}); err != nil {
+			t.Fatal(err)
+		}
+		requireKind(t, preflightForest([]*ast.Node{chain(maxForestDepth + 1)}), Unsupported)
+	})
+	t.Run("nodes", func(t *testing.T) {
+		if err := preflightForest([]*ast.Node{wideForest(maxForestNodes)}); err != nil {
+			t.Fatal(err)
+		}
+		requireKind(t, preflightForest([]*ast.Node{wideForest(maxForestNodes + 1)}), Unsupported)
+	})
+	t.Run("source", func(t *testing.T) {
+		if err := preflightForest([]*ast.Node{{Tokens: make([]byte, maxForestSourceBytes)}}); err != nil {
+			t.Fatal(err)
+		}
+		requireKind(t, preflightForest([]*ast.Node{{Tokens: make([]byte, maxForestSourceBytes+1)}}), Unsupported)
+	})
+	t.Run("metadata", func(t *testing.T) {
+		exact := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: [][]string{{"k", strings.Repeat("v", maxForestMetadataBytes-17)}}}
+		if err := preflightForest([]*ast.Node{exact}); err != nil {
+			t.Fatal(err)
+		}
+		over := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: [][]string{{"k", strings.Repeat("v", maxForestMetadataBytes-16)}}}
+		requireKind(t, preflightForest([]*ast.Node{over}), Unsupported)
+	})
+	t.Run("node-ial-entries", func(t *testing.T) {
+		exact := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: zeroByteIAL(maxNodeIALEntries)}
+		if err := preflightForest([]*ast.Node{exact}); err != nil {
+			t.Fatal(err)
+		}
+		over := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: zeroByteIAL(maxNodeIALEntries + 1)}
+		requireKind(t, preflightForest([]*ast.Node{over}), Unsupported)
+		wide := &ast.Node{Type: ast.NodeParagraph, KramdownIAL: [][]string{make([]string, maxNodeIALEntries+1)}}
+		requireKind(t, preflightForest([]*ast.Node{wide}), Unsupported)
+	})
+	t.Run("metadata-entries", func(t *testing.T) {
+		if err := preflightForest([]*ast.Node{zeroByteIALForest(maxForestMetadataEntries)}); err != nil {
+			t.Fatal(err)
+		}
+		requireKind(t, preflightForest([]*ast.Node{zeroByteIALForest(maxForestMetadataEntries + 1)}), Unsupported)
+	})
+}
+
+func TestPreflightDocumentKeepsBlockDepth(t *testing.T) {
+	document := &ast.Node{Type: ast.NodeDocument}
+	document.AppendChild(chain(maxForestDepth))
+	if err := preflightDocument(document); err != nil {
+		t.Fatal(err)
+	}
+	requireKind(t, preflightForest([]*ast.Node{document}), Unsupported)
+}
+
+func TestPreflightAllowsRootExternalContext(t *testing.T) {
+	block := paragraph("x", false, "before", "after")
+	block.Parent = &ast.Node{Type: ast.NodeDocument, ID: "20000101000000-docroot"}
+	block.Previous = &ast.Node{Type: ast.NodeParagraph}
+	block.Next = &ast.Node{Type: ast.NodeParagraph}
+	plan, err := Build(request(block, 1, "x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(plan.Fragments) != 3 || plan.Fragments[1].Type != ast.NodeMathBlock {
+		t.Fatal("root external context changed the plan")
+	}
+}
diff --git a/kernel/mathconversion/planner.go b/kernel/mathconversion/planner.go
new file mode 100644
index 0000000..eadf550
--- /dev/null
+++ b/kernel/mathconversion/planner.go
@@ -0,0 +1,441 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"bytes"
+	"fmt"
+	"maps"
+	"reflect"
+	"regexp"
+	"slices"
+
+	"github.com/88250/lute/ast"
+)
+
+type Direction uint8
+
+const (
+	InlineToBlock Direction = iota + 1
+	BlockToInline
+)
+
+type Kind string
+
+const (
+	Conflict    Kind = "conflict"
+	Unsupported Kind = "unsupported"
+	Invalid     Kind = "invalid"
+)
+
+type Error struct {
+	Kind   Kind
+	Reason string
+}
+
+func (failure *Error) Error() string      { return string(failure.Kind) + ": " + failure.Reason }
+func fail(kind Kind, reason string) error { return &Error{Kind: kind, Reason: reason} }
+
+type Request struct {
+	Block          *ast.Node
+	TargetPath     []int
+	Direction      Direction
+	ExpectedSource string
+	NewID          func() string
+}
+
+type Plan struct {
+	Before       *ast.Node
+	Fragments    []*ast.Node
+	PreservedID  string
+	CreatedIDs   []string
+	Source       string
+	TargetPath   []int
+	FocusBlockID string
+	FocusPath    []int
+}
+
+var validID = regexp.MustCompile(`^[0-9]{14}-[a-z0-9]{7}$`)
+
+func Build(request Request) (*Plan, error) {
+	if err := preflightRequest(request); err != nil {
+		return nil, err
+	}
+	before, err := clone(request.Block)
+	if err != nil {
+		return nil, err
+	}
+	target := before
+	for _, index := range request.TargetPath {
+		target = target.FirstChild
+		for offset := 0; target != nil && offset < index; offset++ {
+			target = target.Next
+		}
+		if target == nil {
+			return nil, fail(Conflict, "AST target path no longer exists")
+		}
+	}
+	var source string
+	if request.Direction == BlockToInline {
+		if before.Type != ast.NodeMathBlock || len(request.TargetPath) != 0 {
+			return nil, fail(Unsupported, "block-to-inline requires the math block itself")
+		}
+		source, err = mathSource(before)
+	} else {
+		if before.Type != ast.NodeParagraph {
+			return nil, fail(Unsupported, "inline target requires a paragraph")
+		}
+		if len(request.TargetPath) != 1 {
+			return nil, fail(Unsupported, "nested or wrapped math target")
+		}
+		source, err = mathSource(target)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if source != request.ExpectedSource {
+		return nil, fail(Conflict, "formula source differs from expected source")
+	}
+	if err = plainTarget(target); err != nil {
+		return nil, err
+	}
+	if err = validateIAL(before); err != nil {
+		return nil, err
+	}
+	if err = persistentFields(before); err != nil {
+		return nil, err
+	}
+	plan := &Plan{Before: before, PreservedID: before.ID, Source: source, TargetPath: slices.Clone(request.TargetPath)}
+	working, err := clone(before)
+	if err != nil {
+		return nil, err
+	}
+	if request.Direction == BlockToInline {
+		clearChildren(working)
+		working.Type = ast.NodeParagraph
+		working.MathBlockDollarOffset = 0
+		working.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "inline-math", TextMarkInlineMathContent: source})
+		plan.Fragments = []*ast.Node{working}
+		plan.FocusBlockID, plan.FocusPath = working.ID, []int{0}
+	} else {
+		index := request.TargetPath[0]
+		children := childList(working)
+		if len(children) == 1 {
+			clearChildren(working)
+			working.Type = ast.NodeMathBlock
+			appendMathContent(working, source)
+			plan.Fragments = []*ast.Node{working}
+			plan.FocusBlockID = working.ID
+		} else {
+			if err = mixedMetadata(before); err != nil {
+				return nil, err
+			}
+			used := map[string]bool{}
+			ast.Walk(before, func(node *ast.Node, entering bool) ast.WalkStatus {
+				if entering && node.ID != "" {
+					used[node.ID] = true
+				}
+				return ast.WalkContinue
+			})
+			fresh := func(typ ast.NodeType) (*ast.Node, error) {
+				if request.NewID == nil {
+					return nil, fail(Invalid, "new block ID callback is required")
+				}
+				identity := request.NewID()
+				if !validID.MatchString(identity) || used[identity] {
+					return nil, fail(Invalid, "empty, malformed or colliding new block ID")
+				}
+				used[identity] = true
+				plan.CreatedIDs = append(plan.CreatedIDs, identity)
+				node := &ast.Node{Type: typ, ID: identity}
+				node.SetIALAttr("id", identity)
+				for _, attribute := range before.KramdownIAL {
+					if attribute[0] == "style" || attribute[0] == "direction" {
+						node.SetIALAttr(attribute[0], attribute[1])
+					}
+				}
+				return node, nil
+			}
+			math, allocErr := fresh(ast.NodeMathBlock)
+			if allocErr != nil {
+				return nil, allocErr
+			}
+			appendMathContent(math, source)
+			clearChildren(working)
+			if index > 0 {
+				for _, child := range children[:index] {
+					child.Unlink()
+					working.AppendChild(child)
+				}
+				plan.Fragments = append(plan.Fragments, working)
+			}
+			plan.Fragments = append(plan.Fragments, math)
+			if index+1 < len(children) {
+				after := working
+				if index > 0 {
+					after, err = fresh(ast.NodeParagraph)
+					if err != nil {
+						return nil, err
+					}
+				}
+				for _, child := range children[index+1:] {
+					child.Unlink()
+					after.AppendChild(child)
+				}
+				plan.Fragments = append(plan.Fragments, after)
+			}
+			plan.FocusBlockID = math.ID
+		}
+	}
+	if err = checkRoundTrips(plan.Fragments); err != nil {
+		return nil, err
+	}
+	return plan, nil
+}
+
+func appendMathContent(block *ast.Node, source string) {
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockOpenMarker, Tokens: []byte("$$")})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockContent, Tokens: []byte(source)})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockCloseMarker, Tokens: []byte("$$")})
+}
+
+func childList(node *ast.Node) (children []*ast.Node) {
+	for child := node.FirstChild; child != nil; child = child.Next {
+		children = append(children, child)
+	}
+	return
+}
+
+func clearChildren(node *ast.Node) {
+	for child := node.FirstChild; child != nil; {
+		next := child.Next
+		child.Unlink()
+		child = next
+	}
+	node.Children = nil
+}
+
+func clone(node *ast.Node) (*ast.Node, error) {
+	if node == nil {
+		return nil, nil
+	}
+	if node.TableCellRich != nil || node.DocumentTitle != nil || len(node.FootnotesRefs) != 0 || len(node.Children) != 0 {
+		return nil, fail(Unsupported, "rich table, document title, footnote references or unresolved JSON children")
+	}
+	copied := *node
+	copied.Parent, copied.Previous, copied.Next = nil, nil, nil
+	copied.FirstChild, copied.LastChild, copied.Children = nil, nil, nil
+	copied.Tokens = bytes.Clone(node.Tokens)
+	copied.CodeBlockOpenFence = bytes.Clone(node.CodeBlockOpenFence)
+	copied.CodeBlockInfo = bytes.Clone(node.CodeBlockInfo)
+	copied.CodeBlockCloseFence = bytes.Clone(node.CodeBlockCloseFence)
+	copied.LinkRefLabel = bytes.Clone(node.LinkRefLabel)
+	copied.FootnotesRefLabel = bytes.Clone(node.FootnotesRefLabel)
+	copied.HtmlEntityTokens = bytes.Clone(node.HtmlEntityTokens)
+	copied.TableAligns = slices.Clone(node.TableAligns)
+	copied.FootnotesRefs = slices.Clone(node.FootnotesRefs)
+	copied.Properties = maps.Clone(node.Properties)
+	if node.KramdownIAL != nil {
+		copied.KramdownIAL = make([][]string, len(node.KramdownIAL))
+		for index, attribute := range node.KramdownIAL {
+			copied.KramdownIAL[index] = slices.Clone(attribute)
+		}
+	}
+	if node.ListData != nil {
+		list := *node.ListData
+		list.Marker = bytes.Clone(node.ListData.Marker)
+		copied.ListData = &list
+	}
+	for child := node.FirstChild; child != nil; child = child.Next {
+		descendant, err := clone(child)
+		if err != nil {
+			return nil, err
+		}
+		copied.AppendChild(descendant)
+	}
+	return &copied, nil
+}
+
+func mathSource(node *ast.Node) (string, error) {
+	switch node.Type {
+	case ast.NodeTextMark:
+		if node.TextMarkType != "inline-math" {
+			return "", fail(Unsupported, "compound or non-math TextMark target")
+		}
+		return node.TextMarkInlineMathContent, nil
+	case ast.NodeInlineMath, ast.NodeMathBlock:
+		contentType := ast.NodeInlineMathContent
+		if node.Type == ast.NodeMathBlock {
+			contentType = ast.NodeMathBlockContent
+		}
+		children := childList(node)
+		openType, closeType, marker := ast.NodeInlineMathOpenMarker, ast.NodeInlineMathCloseMarker, "$"
+		if node.Type == ast.NodeMathBlock {
+			openType, closeType, marker = ast.NodeMathBlockOpenMarker, ast.NodeMathBlockCloseMarker, "$$"
+		}
+		if len(children) == 3 {
+			if children[0].Type != openType || children[1].Type != contentType || children[2].Type != closeType {
+				return "", fail(Unsupported, "noncanonical math children")
+			}
+			for _, position := range []int{0, 2} {
+				if len(children[position].Tokens) != 0 && string(children[position].Tokens) != marker {
+					return "", fail(Unsupported, "noncanonical math marker")
+				}
+			}
+		} else if len(children) != 1 || children[0].Type != contentType {
+			return "", fail(Unsupported, "noncanonical math children")
+		}
+		var content *ast.Node
+		for child := node.FirstChild; child != nil; child = child.Next {
+			if child.Type == contentType {
+				if content != nil {
+					return "", fail(Unsupported, "multiple math content nodes")
+				}
+				content = child
+			} else if child.Type != ast.NodeInlineMathOpenMarker && child.Type != ast.NodeInlineMathCloseMarker && child.Type != ast.NodeMathBlockOpenMarker && child.Type != ast.NodeMathBlockCloseMarker {
+				return "", fail(Unsupported, "unexpected math child")
+			}
+		}
+		if content == nil {
+			return "", fail(Unsupported, "missing math content")
+		}
+		return string(content.Tokens), nil
+	}
+	return "", fail(Unsupported, "target is not an inline formula")
+}
+
+func plainTarget(node *ast.Node) error {
+	copied := *node
+	copied.Type = 0
+	copied.Parent, copied.Previous, copied.Next = nil, nil, nil
+	copied.FirstChild, copied.LastChild = nil, nil
+	copied.Close, copied.LastLineBlank, copied.LastLineChecked = false, false, false
+	if len(copied.Tokens) == 0 {
+		copied.Tokens = nil
+	}
+	if len(copied.KramdownIAL) == 0 {
+		copied.KramdownIAL = nil
+	}
+	if len(copied.Properties) == 0 {
+		copied.Properties = nil
+	}
+	if node.Type == ast.NodeMathBlock {
+		copied.ID, copied.Box, copied.Path, copied.Spec = "", "", "", ""
+		copied.KramdownIAL, copied.Properties = nil, nil
+		copied.MathBlockDollarOffset = 0
+	}
+	if node.Type == ast.NodeTextMark {
+		copied.TextMarkType, copied.TextMarkInlineMathContent = "", ""
+	}
+	if !reflect.DeepEqual(copied, ast.Node{}) {
+		return fail(Unsupported, "target has attributes or additional metadata")
+	}
+	for child := node.FirstChild; child != nil; child = child.Next {
+		plain := *child
+		plain.Type, plain.Tokens = 0, nil
+		plain.Parent, plain.Previous, plain.Next = nil, nil, nil
+		plain.Close, plain.LastLineBlank, plain.LastLineChecked = false, false, false
+		if len(plain.KramdownIAL) == 0 {
+			plain.KramdownIAL = nil
+		}
+		if len(plain.Properties) == 0 {
+			plain.Properties = nil
+		}
+		if !reflect.DeepEqual(plain, ast.Node{}) {
+			return fail(Unsupported, "math child has attributes or additional metadata")
+		}
+	}
+	return nil
+}
+
+func validateIAL(block *ast.Node) error {
+	seen := map[string]bool{}
+	for _, attribute := range block.KramdownIAL {
+		if len(attribute) != 2 || seen[attribute[0]] {
+			return fail(Unsupported, "malformed or duplicate block IAL")
+		}
+		seen[attribute[0]] = true
+		if attribute[0] == "id" && attribute[1] != block.ID {
+			return fail(Invalid, "block ID differs from IAL ID")
+		}
+	}
+	return nil
+}
+
+func persistentFields(node *ast.Node) error {
+	copied := *node
+	copied.Type = 0
+	copied.Parent, copied.Previous, copied.Next = nil, nil, nil
+	copied.FirstChild, copied.LastChild, copied.Children = nil, nil, nil
+	copied.Tokens = nil
+	copied.Close, copied.LastLineBlank, copied.LastLineChecked = false, false, false
+	copied.KramdownIAL = nil
+	if len(copied.Properties) == 0 {
+		copied.Properties = nil
+	}
+	if len(copied.TableAligns) == 0 {
+		copied.TableAligns = nil
+	}
+	if len(copied.FootnotesRefs) == 0 {
+		copied.FootnotesRefs = nil
+	}
+	if node.IsBlock() {
+		copied.ID, copied.Box, copied.Path, copied.Spec = "", "", "", ""
+	}
+	if node.Type == ast.NodeMathBlock {
+		copied.MathBlockDollarOffset = 0
+	}
+	if node.Type == ast.NodeCodeSpan || node.Type == ast.NodeCodeSpanOpenMarker || node.Type == ast.NodeCodeSpanCloseMarker {
+		copied.CodeMarkerLen = 0
+	}
+	if node.Type == ast.NodeTextMark {
+		copied.TextMarkType, copied.TextMarkTextContent = "", ""
+		if node.IsTextMarkType("a") {
+			copied.TextMarkAHref, copied.TextMarkATitle = "", ""
+		}
+		if node.IsTextMarkType("inline-math") {
+			copied.TextMarkInlineMathContent = ""
+		}
+	}
+	if !reflect.DeepEqual(copied, ast.Node{}) {
+		return fail(Unsupported, "unproven node metadata: "+node.Type.String())
+	}
+	if err := validateIAL(node); err != nil {
+		return err
+	}
+	for child := node.FirstChild; child != nil; child = child.Next {
+		if err := persistentFields(child); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func mixedMetadata(block *ast.Node) error {
+	for _, attribute := range block.KramdownIAL {
+		switch attribute[0] {
+		case "id", "updated", "style", "direction":
+		default:
+			return fail(Unsupported, fmt.Sprintf("mixed paragraph attribute %q requires an identity policy", attribute[0]))
+		}
+	}
+	copied := *block
+	copied.ID, copied.Box, copied.Path, copied.Spec = "", "", "", ""
+	copied.Type = 0
+	copied.Parent, copied.Previous, copied.Next = nil, nil, nil
+	copied.FirstChild, copied.LastChild = nil, nil
+	copied.KramdownIAL = nil
+	copied.Close, copied.LastLineBlank, copied.LastLineChecked = false, false, false
+	if len(copied.Tokens) == 0 {
+		copied.Tokens = nil
+	}
+	if len(copied.Properties) == 0 {
+		copied.Properties = nil
+	}
+	if !reflect.DeepEqual(copied, ast.Node{}) {
+		return fail(Unsupported, "mixed paragraph carries additional metadata")
+	}
+	return nil
+}
