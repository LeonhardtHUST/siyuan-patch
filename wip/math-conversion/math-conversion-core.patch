+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/88250/lute/ast"
+)
+
+func TestIndependentBlockSources(t *testing.T) {
+	for _, source := range []string{"x", "x\r\ny", " x", "x ", "x$y", "数学 α", `<x a="b">&'`, "x\ty", `\t{alpha}`, `\traw{alpha}`, "", "\n", "a\nb"} {
+		t.Run(fmt.Sprintf("%q", source), func(t *testing.T) {
+			block := &ast.Node{Type: ast.NodeMathBlock, ID: originalID}
+			block.SetIALAttr("id", originalID)
+			appendMathContent(block, source)
+			original := snapshot(block)
+			plan, err := Build(Request{Block: block, Direction: BlockToInline, ExpectedSource: source})
+			expectedUnsupported := source == "x\r\ny" || source == "" || source == "\n" || source == "a\nb"
+			if (err != nil) != expectedUnsupported {
+				t.Fatalf("block-to-inline support changed for %q: %v", source, err)
+			}
+			if err != nil {
+				requireKind(t, err, Unsupported)
+				t.Logf("unsupported: %v", err)
+			} else if plan.Source != source {
+				t.Fatal("source changed")
+			} else {
+				t.Log("supported")
+			}
+			if snapshot(block) != original {
+				t.Fatal("input changed")
+			}
+		})
+	}
+}
+
+func TestOutsideNativeMarks(t *testing.T) {
+	for _, kind := range []ast.NodeType{ast.NodeStrong, ast.NodeEmphasis, ast.NodeCodeSpan, ast.NodeLink} {
+		t.Run(kind.String(), func(t *testing.T) {
+			block := paragraph("x", false, "", "after")
+			outside := &ast.Node{Type: kind}
+			switch kind {
+			case ast.NodeStrong:
+				outside.AppendChild(&ast.Node{Type: ast.NodeStrongA6kOpenMarker, Tokens: []byte("**")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte("outside")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeStrongA6kCloseMarker, Tokens: []byte("**")})
+			case ast.NodeEmphasis:
+				outside.AppendChild(&ast.Node{Type: ast.NodeEmA6kOpenMarker, Tokens: []byte("*")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte("outside")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeEmA6kCloseMarker, Tokens: []byte("*")})
+			case ast.NodeCodeSpan:
+				outside.CodeMarkerLen = 1
+				outside.AppendChild(&ast.Node{Type: ast.NodeCodeSpanOpenMarker, Tokens: []byte("`")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeCodeSpanContent, Tokens: []byte("outside")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeCodeSpanCloseMarker, Tokens: []byte("`")})
+			case ast.NodeLink:
+				outside.AppendChild(&ast.Node{Type: ast.NodeOpenBracket, Tokens: []byte("[")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeLinkText, Tokens: []byte("outside")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeCloseBracket, Tokens: []byte("]")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeOpenParen, Tokens: []byte("(")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeLinkDest, Tokens: []byte("https://example.org/")})
+				outside.AppendChild(&ast.Node{Type: ast.NodeCloseParen, Tokens: []byte(")")})
+			}
+			block.PrependChild(outside)
+			original := snapshot(block)
+			plan, err := Build(request(block, 1, "x"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if snapshot(plan.Fragments[0].FirstChild) != snapshot(outside) || snapshot(block) != original {
+				t.Fatal("native mark changed")
+			}
+		})
+	}
+}
+
+func TestBoundaryTextIsNotStripped(t *testing.T) {
+	for _, before := range []string{"\u200b", "\u200b\u200b", "\ufeff", "\ufffe", " ", "\n", "\t", "\r\n"} {
+		for _, after := range []string{"\u200b", "\u200b\u200b", "tail"} {
+			t.Run(fmt.Sprintf("%q-%q", before, after), func(t *testing.T) {
+				block := paragraph("x", false, "", after)
+				block.PrependChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "code", TextMarkTextContent: "outside"})
+				block.PrependChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(before)})
+				original := snapshot(block)
+				plan, err := Build(request(block, 2, "x"))
+				if err != nil {
+					requireKind(t, err, Unsupported)
+					t.Logf("unchanged refusal: %v", err)
+				} else {
+					if string(plan.Fragments[0].FirstChild.Tokens) != before || string(plan.Fragments[2].FirstChild.Tokens) != after {
+						t.Fatal("user boundary text was stripped")
+					}
+				}
+				if snapshot(block) != original {
+					t.Fatal("input changed")
+				}
+			})
+		}
+	}
+}
+
+func TestAdditionalMetadataAndIAL(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*ast.Node)
+	}{
+		{"direction-loss", func(block *ast.Node) { block.SetIALAttr("direction", "rtl") }},
+		{"database-identity", func(block *ast.Node) { block.SetIALAttr("custom-avs", "database") }},
+		{"unknown-block-property", func(block *ast.Node) { block.Properties = map[string]string{"identity": "keep"} }},
+		{"unknown-inline-property", func(block *ast.Node) { block.FirstChild.Properties = map[string]string{"identity": "keep"} }},
+	}
+	for _, testcase := range cases {
+		t.Run(testcase.name, func(t *testing.T) {
+			block := paragraph("x", false, "before", "after")
+			testcase.change(block)
+			original := snapshot(block)
+			_, err := Build(request(block, 1, "x"))
+			requireKind(t, err, Unsupported)
+			if snapshot(block) != original {
+				t.Fatal("metadata failure changed input")
+			}
+		})
+	}
+	block := paragraph("x", false, "", "")
+	block.SetIALAttr("custom-avs", "database")
+	plan, err := Build(request(block, 0, "x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(plan.Fragments[0].KramdownIAL, block.KramdownIAL) {
+		t.Fatal("sole identity IAL lost")
+	}
+	input := request(paragraph("x", false, "before", "after"), 1, "x")
+	input.Block.FirstChild.ID = "20261117140000-child00"
+	input.NewID = func() string { return input.Block.FirstChild.ID }
+	_, err = Build(input)
+	requireKind(t, err, Unsupported)
+}
