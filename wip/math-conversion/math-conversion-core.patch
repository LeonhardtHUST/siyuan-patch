+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"testing"
+
+	"github.com/88250/lute/ast"
+)
+
+func TestPlannerAcceptsPersistedNativeMath(t *testing.T) {
+	for _, native := range []bool{false, true} {
+		original := paragraph("x", native, "before", "after")
+		restored, err := saveReload([]*ast.Node{original})
+		if err != nil {
+			t.Fatal(err)
+		}
+		persisted := restored.Root.FirstChild
+		before := snapshot(persisted)
+		plan, err := Build(request(persisted, 1, "x"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if snapshot(persisted) != before {
+			t.Fatal("persisted input mutated")
+		}
+		saved, err := saveReload(plan.Fragments)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for math := saved.Root.FirstChild; math != nil; math = math.Next {
+			if math.Type != ast.NodeMathBlock {
+				continue
+			}
+			if _, err = Build(Request{Block: math, Direction: BlockToInline, ExpectedSource: "x"}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
diff --git a/kernel/mathconversion/roundtrip.go b/kernel/mathconversion/roundtrip.go
new file mode 100644
index 0000000..31ca8e4
--- /dev/null
+++ b/kernel/mathconversion/roundtrip.go
@@ -0,0 +1,297 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package mathconversion
+
+import (
+	"bytes"
+	"encoding/json"
+	"html"
+	"reflect"
+	"slices"
+	"strings"
+
+	"github.com/88250/lute"
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/88250/lute/render"
+	"github.com/siyuan-note/dataparser"
+)
+
+func engine() *lute.Lute {
+	result := lute.New()
+	result.ParseOptions.KeepEscaped = true
+	result.SetTextMark(true)
+	result.SetProtyleWYSIWYG(true)
+	result.SetBlockRef(true)
+	result.SetFileAnnotationRef(true)
+	result.SetKramdownIAL(true)
+	result.SetTag(true)
+	result.SetSuperBlock(true)
+	result.SetCustomBlock(true)
+	result.SetImgPathAllowSpace(true)
+	result.SetGitConflict(true)
+	result.SetInlineAsterisk(true)
+	result.SetInlineUnderscore(true)
+	result.SetSup(true)
+	result.SetSub(true)
+	result.SetInlineMath(true)
+	result.SetGFMStrikethrough(true)
+	result.SetFullWidthStrikethrough(true)
+	result.SetMark(true)
+	result.SetInlineMathAllowDigitAfterOpenMarker(true)
+	result.SetGFMStrikethrough1(false)
+	result.SetFootnotes(false)
+	result.SetToC(false)
+	result.SetIndentCodeBlock(false)
+	result.SetParagraphBeginningSpace(true)
+	result.SetAutoSpace(false)
+	result.SetHeadingID(false)
+	result.SetSetext(false)
+	result.SetYamlFrontMatter(false)
+	result.SetLinkRef(false)
+	result.SetCodeSyntaxHighlight(false)
+	result.SetSanitize(true)
+	result.SetUnorderedListMarker("-")
+	result.SetCallout(true)
+	result.SetTabs(true)
+	result.SetDataTask(true)
+	result.SetArbitraryTaskListItemMarker(true)
+	result.SetExportNormalizeTaskListMarker(false)
+	result.SetEnsureListItemParagraph(true)
+	return result
+}
+
+func document(blocks []*ast.Node) (*parse.Tree, error) {
+	root := &ast.Node{Type: ast.NodeDocument, ID: "20000101000000-docroot", Spec: "1"}
+	root.SetIALAttr("id", root.ID)
+	root.SetIALAttr("type", "doc")
+	for _, block := range blocks {
+		copied, err := clone(block)
+		if err != nil {
+			return nil, err
+		}
+		root.AppendChild(copied)
+	}
+	return &parse.Tree{Root: root}, nil
+}
+
+func saveReload(blocks []*ast.Node) (*parse.Tree, error) {
+	processor := engine()
+	tree, err := document(blocks)
+	if err != nil {
+		return nil, err
+	}
+	data := render.NewJSONRenderer(tree, processor.RenderOptions, processor.ParseOptions).Render()
+	restored, _, err := dataparser.ParseJSON(data, processor.ParseOptions)
+	if err != nil {
+		return nil, fail(Unsupported, "JSON persistence cannot reload AST")
+	}
+	return restored, nil
+}
+
+type event struct {
+	Text       string
+	Marks      string
+	Attributes string
+	Formula    bool
+}
+
+func signature(block *ast.Node) ([]event, error) {
+	var events []event
+	emit := func(value event) {
+		if len(events) > 0 && value.Marks == "" && !value.Formula && !events[len(events)-1].Formula && events[len(events)-1].Marks == value.Marks && events[len(events)-1].Attributes == value.Attributes {
+			events[len(events)-1].Text += value.Text
+		} else {
+			events = append(events, value)
+		}
+	}
+	var visit func(*ast.Node, []string, map[string]string) error
+	visit = func(node *ast.Node, marks []string, inherited map[string]string) error {
+		attributeMap := map[string]string{}
+		for key, value := range inherited {
+			attributeMap[key] = value
+		}
+		for _, attribute := range node.KramdownIAL {
+			if len(attribute) != 2 {
+				return fail(Unsupported, "malformed inline IAL")
+			}
+			attributeMap[attribute[0]] = attribute[1]
+		}
+		attributeData, _ := json.Marshal(attributeMap)
+		attributes := string(attributeData)
+		if node.Type == ast.NodeInlineMath || node.Type == ast.NodeMathBlock || node.Type == ast.NodeTextMark && strings.Contains(node.TextMarkType, "inline-math") {
+			source, err := mathSource(node)
+			if err != nil {
+				return err
+			}
+			emit(event{Text: source, Formula: true, Attributes: attributes})
+			return nil
+		}
+		switch node.Type {
+		case ast.NodeParagraph:
+		case ast.NodeText, ast.NodeLinkText, ast.NodeCodeSpanContent:
+			normalized := slices.Clone(marks)
+			slices.Sort(normalized)
+			emit(event{Text: string(node.Tokens), Marks: strings.Join(normalized, " "), Attributes: attributes})
+			return nil
+		case ast.NodeTextMark:
+			normalized := strings.Fields(node.TextMarkType)
+			slices.Sort(normalized)
+			if slices.Contains(normalized, "a") {
+				normalized = append(normalized, "href="+html.UnescapeString(node.TextMarkAHref), "title="+html.UnescapeString(node.TextMarkATitle))
+			}
+			emit(event{Text: html.UnescapeString(node.TextMarkTextContent), Marks: strings.Join(normalized, " "), Attributes: attributes})
+			return nil
+		case ast.NodeStrong:
+			marks = append(slices.Clone(marks), "strong")
+		case ast.NodeEmphasis:
+			marks = append(slices.Clone(marks), "em")
+		case ast.NodeCodeSpan:
+			marks = append(slices.Clone(marks), "code")
+		case ast.NodeLink:
+			marks = append(slices.Clone(marks), "a")
+			for child := node.FirstChild; child != nil; child = child.Next {
+				if child.Type == ast.NodeLinkDest {
+					marks = append(marks, "href="+string(child.Tokens))
+				}
+				if child.Type == ast.NodeLinkTitle {
+					marks = append(marks, "title="+string(child.Tokens))
+				}
+			}
+			if node.ChildByType(ast.NodeLinkTitle) == nil {
+				marks = append(marks, "title=")
+			}
+		case ast.NodeLinkDest, ast.NodeLinkTitle, ast.NodeOpenBracket, ast.NodeCloseBracket, ast.NodeOpenParen, ast.NodeCloseParen:
+			return nil
+		default:
+			if strings.HasSuffix(node.Type.String(), "Marker") {
+				return nil
+			}
+			return fail(Unsupported, "unproven inline round-trip node: "+node.Type.String())
+		}
+		for child := node.FirstChild; child != nil; child = child.Next {
+			descendantAttributes := attributeMap
+			if node.Type == ast.NodeParagraph {
+				descendantAttributes = nil
+			}
+			if err := visit(child, marks, descendantAttributes); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := visit(block, nil, nil); err != nil {
+		return nil, err
+	}
+	return events, nil
+}
+
+func checkRoundTrips(blocks []*ast.Node) (err error) {
+	defer func() {
+		if recover() != nil {
+			err = fail(Unsupported, "Lute cannot safely round-trip this AST")
+		}
+	}()
+	if err = preflightForest(blocks); err != nil {
+		return err
+	}
+	restored, err := saveReload(blocks)
+	if err != nil {
+		return err
+	}
+	if err = preflightDocument(restored.Root); err != nil {
+		return err
+	}
+	processor := engine()
+	domTree, err := document(childList(restored.Root))
+	if err != nil {
+		return err
+	}
+	dom := processor.Tree2BlockDOM(domTree, processor.RenderOptions, processor.ParseOptions)
+	domRestored := processor.BlockDOM2Tree(dom)
+	if err = preflightDocument(domRestored.Root); err != nil {
+		return err
+	}
+	jsonBlocks, domBlocks := persistentBlocks(restored.Root), persistentBlocks(domRestored.Root)
+	if len(blocks) != len(jsonBlocks) || len(blocks) != len(domBlocks) {
+		return fail(Unsupported, "round-trip changed block count")
+	}
+	for index, block := range blocks {
+		expected, signatureErr := signature(block)
+		if signatureErr != nil {
+			return signatureErr
+		}
+		for roundTripIndex, actual := range []*ast.Node{jsonBlocks[index], domBlocks[index]} {
+			comparison := expected
+			if roundTripIndex == 1 {
+				comparison = renderedBoundaries(expected)
+			}
+			observed, signatureErr := signature(actual)
+			for _, attribute := range block.KramdownIAL {
+				if actual.IALAttr(attribute[0]) != attribute[1] {
+					return fail(Unsupported, "round-trip changed block attribute: "+attribute[0])
+				}
+			}
+			if signatureErr != nil {
+				return signatureErr
+			}
+			if block.ID != actual.ID || block.Type != actual.Type || !reflect.DeepEqual(comparison, observed) {
+
+				return fail(Unsupported, "JSON or BlockDOM round-trip changed source, marks, identity or text")
+			}
+		}
+		jsonTree, cloneErr := document([]*ast.Node{jsonBlocks[index]})
+		if cloneErr != nil {
+			return cloneErr
+		}
+		originalTree, cloneErr := document([]*ast.Node{block})
+		if cloneErr != nil {
+			return cloneErr
+		}
+		originalJSON := render.NewJSONRenderer(originalTree, processor.RenderOptions, processor.ParseOptions).Render()
+		actualJSON := render.NewJSONRenderer(jsonTree, processor.RenderOptions, processor.ParseOptions).Render()
+		if !bytes.Equal(originalJSON, actualJSON) {
+			return fail(Unsupported, "JSON persistence changed metadata")
+		}
+	}
+	return nil
+}
+
+func renderedBoundaries(events []event) (result []event) {
+	emit := func(value event) {
+		if len(result) > 0 && value.Marks == "" && !value.Formula && result[len(result)-1].Marks == "" && !result[len(result)-1].Formula && result[len(result)-1].Attributes == value.Attributes {
+			result[len(result)-1].Text += value.Text
+		} else {
+			result = append(result, value)
+		}
+	}
+	for index, value := range events {
+		boundary := false
+		for _, mark := range strings.Fields(value.Marks) {
+			if mark == "code" || mark == "kbd" || mark == "tag" || mark == "sup" || mark == "sub" {
+				boundary = true
+			}
+		}
+		if boundary {
+			if len(result) == 0 || result[len(result)-1].Marks != "" || !strings.HasSuffix(result[len(result)-1].Text, "\u200b") {
+				emit(event{Text: "\u200b", Attributes: "{}"})
+			}
+		}
+		emit(value)
+		if boundary && (index+1 == len(events) || events[index+1].Marks != "" || !strings.HasPrefix(events[index+1].Text, "\u200b")) {
+			emit(event{Text: "\u200b", Attributes: "{}"})
+		}
+	}
+	return
+}
+
+func persistentBlocks(root *ast.Node) (blocks []*ast.Node) {
+	for child := root.FirstChild; child != nil; child = child.Next {
+		if child.Type != ast.NodeKramdownBlockIAL {
+			blocks = append(blocks, child)
+		}
+	}
+	return
+}
