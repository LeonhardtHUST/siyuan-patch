+
+class FakeEl {
+    static root = new FakeEl("#doc");
+    attrs = new Map<string, string>();
+    children: FakeEl[] = [];
+    parentElement: FakeEl | null = null;
+    shadowRoot: FakeEl | null = null;
+    style: Record<string, string> = {};
+    nodeType = 1;
+    text = "";
+    private classes = new Set<string>();
+    constructor(public tagName: string, cls = "") {
+        cls.split(/\s+/).filter(Boolean).forEach(c => this.classes.add(c));
+    }
+    get isConnected(): boolean {
+        let n: FakeEl | null = this;
+        while (n) {
+            if (n === FakeEl.root) return true;
+            n = n.parentElement;
+        }
+        return false;
+    }
+    get classList() {
+        const s = this.classes;
+        return {add: (c: string) => s.add(c), remove: (c: string) => s.delete(c), contains: (c: string) => s.has(c)};
+    }
+    get firstElementChild() { return this.children[0] ?? null; }
+    get childNodes() { return this.children; }
+    get childElementCount() { return this.children.length; }
+    get textContent() { return this.text + this.children.map(c => c.textContent).join(""); }
+    set textContent(v: string) { this.text = v; this.children = []; }
+    get innerHTML() { return this.children.map(child => child.outerHTML).join(""); }
+    set innerHTML(v: string) {
+        this.children = [];
+        if (v.startsWith("<katex>")) {
+            // 测试桩：KaTeX 回退产物按既有约定表示成 span.katex，保留 "不可见输出" 语义
+            const k = new FakeEl("SPAN", "katex");
+            k.text = v;
+            this.append(k);
+            return;
+        }
+        parseHTML(v).forEach(child => this.append(child));
+    }
+    get outerHTML() {
+        const cls = this.getAttribute("class");
+        const attributes = (cls ? ` class="${cls}"` : "") +
+            Array.from(this.attrs, ([name, value]) => ` ${name}="${value}"`).join("");
+        return `<${this.tagName.toLowerCase()}${attributes}>${this.text}${this.innerHTML}</${this.tagName.toLowerCase()}>`;
+    }
+    get content() { return {firstElementChild: this.firstElementChild}; }
+    get attributes() { return Array.from(this.attrs, ([name, value]) => ({name, value})); }
+    getAttribute(n: string) { return n === "class" ? [...this.classes].join(" ") || null : this.attrs.get(n) ?? null; }
