+const parseHTML = (html: string): FakeEl[] => {
+    const out: FakeEl[] = [];
+    const tagRe = /<(\/?)([a-zA-Z][\w-]*)((?:\s+[\w:-]+(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s"'>]+))?)*)\s*(\/?)>/g;
+    let current: FakeEl | null = null;
+    let match: RegExpExecArray | null;
+    while ((match = tagRe.exec(html))) {
+        if (!match[1]) {
+            const element = new FakeEl(match[2].toUpperCase());
+            const attrRe = /\s+([^\s=]+)(?:\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'>]+)))?/g;
+            let attribute: RegExpExecArray | null;
+            while ((attribute = attrRe.exec(match[3]))) {
+                element.setAttribute(attribute[1], attribute[2] ?? attribute[3] ?? attribute[4] ?? "");
+            }
+            if (current) {
+                current.append(element);
+            } else {
+                out.push(element);
+            }
+            if (!match[4]) {
+                current = element;
+            }
+        } else if (current && current.parentElement) {
+            current = current.parentElement;
+        } else {
+            current = null;
+        }
+    }
+    return out;
