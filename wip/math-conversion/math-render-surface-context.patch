diff --git a/app/src/protyle/util/processRender.test.ts b/app/src/protyle/util/processRender.test.ts
new file mode 100644
index 0000000..1ad5b75
--- /dev/null
+++ b/app/src/protyle/util/processRender.test.ts
@@ -0,0 +1,149 @@
+import * as assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import * as path from "node:path";
+import test from "node:test";
+import {ModuleKind, ScriptTarget, transpileModule} from "typescript";
+
+/**
+ * processRender 参数回归单测：加载**真实** protyle/util/processCode.ts，把全部依赖换成桩，
+ * 捕获每个渲染器收到的实参。
+ *
+ * 回归点：RENDER_MAP 的第二参语义是 cdn；只有 math 条目通过闭包接收 IMathRenderOptions。
+ * 旧实现把 mathOptions 当第二参转给 mermaid/chart/abc/graphviz/flowchart/plantuml，
+ * 这些渲染器会执行 addScript(`${mathOptions}/js/...`)，首次渲染必然 404。
+ */
+
+class FakeEl {
+    attrs = new Map<string, string>();
+    parentElement: FakeEl | null = null;
+    constructor(public tagName: string) {}
+    getAttribute(name: string) {
+        return this.attrs.get(name) ?? null;
+    }
+    setAttribute(name: string, value: string) {
+        this.attrs.set(name, value);
+    }
+    closest(selector: string) {
+        if (selector === '[data-protyle-lite-render="safe"]') {
+            let node: FakeEl | null = this;
+            while (node) {
+                if (node.getAttribute("data-protyle-lite-render") === "safe") {
+                    return node;
+                }
+                node = node.parentElement;
+            }
+        }
+        return null;
+    }
+}
+
+type RenderCall = {name: string, args: any[]};
+
+const setup = () => {
+    const calls: RenderCall[] = [];
+    const noop = (name: string) => (...args: any[]) => calls.push({name, args});
+    const silent = (): void => undefined;
+    const extra: Record<string, unknown> = {
+        "../render/abcRender": {abcRender: noop("abcRender")},
+        "../render/chartRender": {chartRender: noop("chartRender")},
+        "../render/graphvizRender": {graphvizRender: noop("graphvizRender")},
+        "../render/mathRender": {mathRender: noop("mathRender")},
+        "../render/mermaidRender": {mermaidRender: noop("mermaidRender")},
+        "../render/mindmapRender": {mindmapRender: noop("mindmapRender")},
+        "../render/flowchartRender": {flowchartRender: noop("flowchartRender")},
+        "../render/plantumlRender": {plantumlRender: noop("plantumlRender")},
+        "../render/htmlRender": {htmlRender: noop("htmlRender")},
+        "../../util/escape": {escapeHtml: (value: string) => value},
+        "../../plugin/customBlockRender": {customBlockRender: silent},
+        "./inlineElementMarker": {buildSemanticInlineHTML: silent},
+        "../render/tableCellRich": {renderTableCellRichElements: silent},
+        "../render/embedHeading": {renderEmbedHeadings: silent},
+        "./inlineElementBoundary": {normalizeInlineElementBoundaries: silent},
+        "./longTextWrap": {renderLongTextRuns: silent},
+        "../render/imageActions": {renderImageActions: silent},
+        "../render/imageDisplay": {renderImageDisplay: silent},
+        "../render/mediaResize": {renderMediaResize: silent},
+        "../render/blockDirection": {renderBlockDirection: silent},
+        "../../constants": {Constants: {PROTYLE_CDN: "cdn"}},
+    };
+    const file = path.join(__dirname, "processCode.ts");
+    const js = transpileModule(readFileSync(file, "utf8"), {
+        compilerOptions: {module: ModuleKind.CommonJS, target: ScriptTarget.ES2022},
+    }).outputText;
+    const exports: Record<string, unknown> = {};
+    new Function("exports", "require", js)(exports, (spec: string) => {
+        if (spec in extra) {
+            return extra[spec];
+        }
+        throw new Error("unexpected import " + spec);
+    });
+    return {calls, processRender: exports.processRender as (element: Element, mathOptions?: any) => void};
+};
+
+const languagePanel = (subtype: string) => {
+    const panel = new FakeEl("DIV");
+    panel.setAttribute("data-subtype", subtype);
+    return panel as unknown as Element;
+};
+
+const CHART_LANGUAGES = [
+    ["abc", "abcRender"],
+    ["plantuml", "plantumlRender"],
+    ["mermaid", "mermaidRender"],
+    ["flowchart", "flowchartRender"],
+    ["echarts", "chartRender"],
+    ["graphviz", "graphvizRender"],
+] as const;
+
+for (const [subtype, renderer] of CHART_LANGUAGES) {
+    test(`processRender passes cdn (not mathOptions) as the second argument to ${renderer}`, () => {
+        const {calls, processRender} = setup();
+        const options = {surface: "preview", rootID: "R1", docMode: "preview"};
+        const panel = languagePanel(subtype);
+        processRender(panel, options);
+        // mindmapRender 在语言分支之前无条件执行（上游顺序），不消费 mathOptions
+        assert.deepEqual(calls.map(call => call.name), ["mindmapRender", renderer],
+            "only the matching language renderer runs after mindmapRender");
+        assert.deepEqual(calls[0].args, [panel, "cdn"]);
+        assert.equal(calls[1].args[0], panel);
+        assert.equal(calls[1].args[1], "cdn");
+        assert.equal(calls[1].args.length, 2);
+    });
+}
+
+test("processRender hands mathOptions to mathRender only, fourth argument", () => {
+    const {calls, processRender} = setup();
+    const options = {surface: "preview", rootID: "R1", docMode: "preview"};
+    const panel = languagePanel("math");
+    processRender(panel, options);
+    assert.deepEqual(calls.map(call => call.name), ["mindmapRender", "mathRender"]);
+    assert.deepEqual(calls[1].args, [panel, "cdn", false, options]);
+});
+
+test("processRender fallback loop passes cdn to every renderer and mathOptions only to math", () => {
+    const {calls, processRender} = setup();
+    const options: {surface: string, rootID: string | null, docMode: string} =
+        {surface: "export-image", rootID: null, docMode: "detached"};
+    const panel = new FakeEl("DIV") as unknown as Element;
+    processRender(panel, options);
+    const charts = calls.filter(call => call.name !== "mathRender" && call.name !== "htmlRender");
+    assert.equal(charts.length, CHART_LANGUAGES.length + 1, "six chart renderers + mindmapRender");
+    charts.forEach(call => {
+        assert.equal(call.args[0], panel);
+        assert.equal(call.args.length, 2, call.name);
+        assert.equal(call.args[1], "cdn", call.name);
+    });
+    const math = calls.find(call => call.name === "mathRender");
+    assert.deepEqual(math!.args, [panel, "cdn", false, options]);
+    assert.ok(calls.some(call => call.name === "htmlRender"));
+});
+
+test("processRender Lite safe path renders math only, with cdn and mathOptions", () => {
+    const {calls, processRender} = setup();
+    const options = {surface: "doc-title", rootID: "R2", docMode: "editable"};
+    const panel = new FakeEl("DIV");
+    panel.setAttribute("data-protyle-lite-render", "safe");
+    processRender(panel as unknown as Element, options);
+    assert.deepEqual(calls.map(call => call.name), ["mathRender"]);
+    assert.deepEqual(calls[0].args, [panel, "cdn", false, options]);
+});
