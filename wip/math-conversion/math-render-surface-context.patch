+import type {TMathRenderDocMode, TMathRenderSurface} from "./mathRendererRegistry";
+
+/**
+ * 公式渲染表面推断与可视输出判定（只读，不改 DOM）。
+ * 仅在调用点没有显式传入 surface/docMode/rootID 时使用，规则见 R4 契约“registry context 契约”。
+ */
+
+export const MATH_RENDER_SURFACES: readonly TMathRenderSurface[] = [
+    "editor", "editor-readonly", "doc-title", "table-cell", "ai-message", "popover",
+    "preview", "mindmap", "export-bake", "export-image", "export-window", "unknown",
+];
+
+export const MATH_RENDER_DOC_MODES: readonly TMathRenderDocMode[] = ["editable", "readonly", "preview", "detached"];
+
+const DETACHED_SURFACES: readonly TMathRenderSurface[] = ["export-bake", "export-image", "export-window"];
+
+/**
+ * 可以注入行内边界字符（ZWSP/FEFF）的表面：只有真正可编辑、且公式参与编辑器光标的表面。
+ * 与插件 render-surface.ts 的 editableRenderSurfaces 保持一致。
+ * preview/popover/ai-message/mindmap 克隆、导出与只读表面都不注入。
+ */
+export const BOUNDARY_ALLOWED_SURFACES: readonly TMathRenderSurface[] = [
+    "editor", "doc-title", "table-cell",
+];
+
+/** 边界的完整门控：可编辑档位 + 可编辑表面 + 元素仍连接。 */
+export const canApplyInlineMathBoundaries = (surface: TMathRenderSurface, docMode: TMathRenderDocMode,
+                                             isConnected: boolean) =>
+    docMode === "editable" && isConnected && BOUNDARY_ALLOWED_SURFACES.includes(surface);
+
+export const normalizeMathSurface = (value: unknown): TMathRenderSurface | null =>
+    typeof value === "string" && (MATH_RENDER_SURFACES as readonly string[]).includes(value) ?
+        value as TMathRenderSurface : null;
+
+export const normalizeMathDocMode = (value: unknown): TMathRenderDocMode | null =>
+    typeof value === "string" && (MATH_RENDER_DOC_MODES as readonly string[]).includes(value) ?
+        value as TMathRenderDocMode : null;
+
+const classTokens = (element: Element): string[] =>
+    (element.getAttribute("class") || "").split(/\s+/).filter(token => token.length > 0);
+
+const hasClass = (element: Element, token: string) => classTokens(element).includes(token);
+
+const closestWhere = (element: Element | null, predicate: (candidate: Element) => boolean): Element | null => {
+    let candidate = element;
+    // 异常父链保护：最多上溯 64 层
+    for (let depth = 0; candidate && depth < 64; depth++) {
+        if (predicate(candidate)) {
+            return candidate;
+        }
+        candidate = candidate.parentElement;
+    }
+    return null;
+};
+
+export const inferMathSurface = (element: Element): TMathRenderSurface => {
+    if (closestWhere(element, c => hasClass(c, "block__popover") || hasClass(c, "block__panel"))) {
+        return "popover";
+    }
+    if (closestWhere(element, c => classTokens(c).some(token => token.startsWith("document-title")))) {
+        return "doc-title";
+    }
+    if (closestWhere(element, c => hasClass(c, "table__cell-rich") ||
+        (c.tagName === "TD" && c.getAttribute("data-table-cell-rich") !== null))) {
+        return "table-cell";
+    }
+    if (closestWhere(element, c => hasClass(c, "agent-chat"))) {
+        return "ai-message";
+    }
+    if (closestWhere(element, c => hasClass(c, "mindmap-view"))) {
+        return "mindmap";
+    }
+    if (!element.isConnected) {
+        return "export-bake";
+    }
+    const wysiwyg = closestWhere(element, c => hasClass(c, "protyle-wysiwyg"));
+    if (wysiwyg) {
+        return wysiwyg.getAttribute("data-readonly") === "true" ? "editor-readonly" : "editor";
+    }
+    return closestWhere(element, c => hasClass(c, "protyle")) ? "editor" : "unknown";
+};
+
+export const inferMathDocMode = (element: Element, surface: TMathRenderSurface): TMathRenderDocMode => {
+    if (DETACHED_SURFACES.includes(surface)) {
+        return "detached";
+    }
+    if (surface === "preview") {
+        return "preview";
+    }
+    if (surface === "editor-readonly") {
+        return "readonly";
+    }
+    if (!element.isConnected) {
+        return "detached";
+    }
+    const wysiwyg = closestWhere(element, c => hasClass(c, "protyle-wysiwyg"));
+    return wysiwyg && wysiwyg.getAttribute("data-readonly") === "true" ? "readonly" : "editable";
+};
+
+export const inferMathRootID = (element: Element): string | null => {
+    const protyle = closestWhere(element, c => hasClass(c, "protyle"));
+    return protyle ? protyle.getAttribute("data-node-id") || null : null;
+};
+
+const EMPTY_ATTRIBUTES: Readonly<Record<string, string>> = Object.freeze({});
+
+/**
+ * 文档 custom-* 属性快照：取最近的 `.protyle`（含自身）。
+ * 文档 IAL 由 syncRootAttributes 写到 protyle.element（wysiwyg/index.ts:654），不是
+ * `.protyle-wysiwyg`；detached 容器没有 `.protyle`，退化为 {}。
+ */
+export const snapshotDocAttributes = (element: Element): Readonly<Record<string, string>> => {
+    const protyle = closestWhere(element, c => hasClass(c, "protyle"));
+    if (!protyle) {
+        return EMPTY_ATTRIBUTES;
+    }
+    const result: Record<string, string> = {};
+    Array.from(protyle.attributes || []).forEach(attribute => {
+        if (attribute.name.startsWith("custom-")) {
+            result[attribute.name] = attribute.value;
+        }
+    });
+    return Object.freeze(result);
+};
+
+/**
+ * 默认的“已渲染”判定：块级看 firstElementChild 下、行内看元素下，存在非光标占位的
+ * 可视输出（svg、shadow 宿主或有内容的子元素）。
+ */
+export const hasVisibleMathOutput = (element: Element, isBlock: boolean): boolean => {
+    const target = isBlock ? element.firstElementChild : element;
+    if (!target) {
+        return false;
+    }
+    return Array.from(target.childNodes).some(node => {
+        if (node.nodeType !== 1) {
+            return false;
+        }
+        const child = node as Element;
+        if (hasClass(child, "protyle-cursor")) {
+            return false;
+        }
+        if (child.tagName.toLowerCase() === "svg" || child.shadowRoot) {
+            return true;
+        }
+        return child.childNodes.length > 0 && (child.childElementCount > 0 || (child.textContent || "").trim() !== "");
+    });
+};
