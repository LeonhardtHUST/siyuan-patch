+import * as assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import {resolve} from "node:path";
+import test from "node:test";
+import type {IMathConversionMenuContext, IMathConversionMenuProvider} from "./mathConversionMenuRegistry";
+import {
+    appendMathConversionMenuItems,
+    createMathConversionMenu,
+    getMathConversionMenuElement,
+    getMathConversionMenuItems,
+    isMathConversionMenuReadOnly,
+    registerMathConversionMenuProvider,
+    unregisterMathConversionMenuProvider,
+} from "./mathConversionMenuRegistry";
+
+const mockWindow = (readonly = false) => {
+    const previous = Object.getOwnPropertyDescriptor(globalThis, "window");
+    Object.defineProperty(globalThis, "window", {
+        configurable: true,
+        value: {siyuan: {config: {readonly}, languages: {turnInto: "Turn into"}}},
+    });
+    return () => {
+        if (previous) {
+            Object.defineProperty(globalThis, "window", previous);
+        } else {
+            Reflect.deleteProperty(globalThis, "window");
+        }
+    };
+};
+
+const target = (overrides: Partial<{
+    element: HTMLElement,
+    blockElement: HTMLElement,
+    protyle: IProtyle,
+    surface: "inline-context" | "block-convert",
+}> = {}) => ({
+    element: {} as HTMLElement,
+    blockElement: {} as HTMLElement,
+    protyle: {disabled: false} as IProtyle,
+    surface: "inline-context" as const,
+    ...overrides,
+});
+
+const mathContext = (overrides: Partial<IMathConversionMenuContext> = {}): IMathConversionMenuContext => ({
+    ...target(),
+    isReadOnly: false,
+    ...overrides,
+});
+
+const fakeBlock = (type: string, inlineMath: HTMLElement[] = [], mathChild?: HTMLElement) =>
+    ({
+        getAttribute: (name: string) => name === "data-type" ? type : null,
+        querySelector: () => mathChild ?? null,
+        querySelectorAll: () => inlineMath,
+    }) as unknown as HTMLElement;
+
+test("no provider keeps the native math menu unchanged", () => {
+    const restore = mockWindow(false);
+    try {
+        assert.deepEqual(getMathConversionMenuItems(mathContext()), []);
+        assert.equal(createMathConversionMenu(target()), undefined);
+        assert.equal(appendMathConversionMenuItems([{id: "copy", label: "Copy"}], target()), false);
+    } finally {
+        restore();
+    }
+});
+
+test("provider receives the menu context and entries get namespaced ids", () => {
+    const seen: IMathConversionMenuContext[] = [];
+    const context = mathContext({surface: "block-convert", isReadOnly: true});
+    registerMathConversionMenuProvider("typst/formula", {
+        items: (current) => {
+            seen.push(current);
+            return [{
+                id: "block", label: "Block", type: "submenu",
+                submenu: [{id: "document", label: "Document"}],
+            }];
+        },
+    });
+    try {
+        const items = getMathConversionMenuItems(context);
+        assert.equal(seen.length, 1);
+        assert.equal(seen[0].surface, "block-convert");
+        assert.equal(seen[0].isReadOnly, true);
+        assert.equal(seen[0].element, context.element);
+        assert.equal(seen[0].blockElement, context.blockElement);
+        assert.deepEqual(items.map(item => item.id), ["typst%2Fformula:block"]);
+        assert.deepEqual(items[0].submenu.map(item => item.id), ["typst%2Fformula:block:document"]);
+    } finally {
+        unregisterMathConversionMenuProvider("typst/formula");
+    }
+});
+
+test("duplicate ids are removed per provider and stay distinct across providers", () => {
+    registerMathConversionMenuProvider("one", {
+        items: () => [{id: "same", label: "a"}, {id: "same", label: "b"},
+            {type: "separator"}, {type: "separator"}, null as unknown as IMenu],
+    });
+    registerMathConversionMenuProvider("two", {
+        items: () => [{id: "same", label: "c"}],
+    });
+    try {
+        const items = getMathConversionMenuItems(mathContext());
+        assert.deepEqual(items.map(item => item.id),
+            ["one:same", "one:separator_2", "one:separator_3", "two:same"]);
+        assert.equal(new Set(items.map(item => item.id)).size, items.length);
+    } finally {
+        unregisterMathConversionMenuProvider("one");
+        unregisterMathConversionMenuProvider("two");
+    }
+});
+
+test("provider items within the recursive budget survive and invalid providers are isolated", () => {
+    const warnings: unknown[] = [];
+    const originalWarn = console.warn;
+    console.warn = (...args: unknown[]) => {
+        warnings.push(args);
+    };
+    registerMathConversionMenuProvider("many", {
+        items: () => Array.from({length: 40}, (_, index) => ({id: `item${index}`, label: `${index}`})),
+    });
+    registerMathConversionMenuProvider("throws", {
+        items: () => {
+            throw new Error("boom");
+        },
+    });
+    registerMathConversionMenuProvider("invalid", {
+        items: () => ({}) as unknown as IMenu[],
+    });
+    try {
+        const items = getMathConversionMenuItems(mathContext());
+        assert.equal(items.length, 40);
+        assert.equal(items[0].id, "many:item0");
+        assert.equal(warnings.length, 2);
+    } finally {
+        console.warn = originalWarn;
+        unregisterMathConversionMenuProvider("many");
+        unregisterMathConversionMenuProvider("throws");
+        unregisterMathConversionMenuProvider("invalid");
+    }
+});
+
+test("re-registering replaces a provider in place and unregister removes it", () => {
+    registerMathConversionMenuProvider("a", {items: () => [{id: "old", label: "Old"}]});
+    registerMathConversionMenuProvider("b", {items: () => [{id: "b", label: "B"}]});
+    registerMathConversionMenuProvider("a", {items: () => [{id: "new", label: "New"}]});
+    try {
+        assert.deepEqual(getMathConversionMenuItems(mathContext()).map(item => item.id), ["a:new", "b:b"]);
+        unregisterMathConversionMenuProvider("a");
+        assert.deepEqual(getMathConversionMenuItems(mathContext()).map(item => item.id), ["b:b"]);
+    } finally {
+        unregisterMathConversionMenuProvider("a");
+        unregisterMathConversionMenuProvider("b");
+    }
+    assert.deepEqual(getMathConversionMenuItems(mathContext()), []);
+});
+
+test("readonly editor and workspace do not pass through conversion entries", () => {
+    const restoreWritable = mockWindow(false);
+    assert.equal(isMathConversionMenuReadOnly({disabled: false} as IProtyle), false);
+    assert.equal(isMathConversionMenuReadOnly({disabled: true} as IProtyle), true);
+    restoreWritable();
+    const restoreReadonly = mockWindow(true);
+    let called = false;
+    registerMathConversionMenuProvider("guard", {
+        items: () => {
+            called = true;
+            return [{id: "x", label: "X"}];
+        },
+    });
+    try {
+        assert.equal(isMathConversionMenuReadOnly({disabled: false} as IProtyle), true);
+        assert.equal(createMathConversionMenu(target()), undefined);
+        assert.equal(appendMathConversionMenuItems([], target()), false);
+        assert.equal(called, false);
+    } finally {
+        unregisterMathConversionMenuProvider("guard");
+        restoreReadonly();
+    }
+});
+
+test("provider entries are appended to the native turnInto submenu without a duplicate parent", () => {
+    const restore = mockWindow(false);
+    registerMathConversionMenuProvider("typst", {
+        items: () => [{id: "block", label: "Math block", click: () => undefined}],
+    });
