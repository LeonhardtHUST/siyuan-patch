+test("plugin provider registration is namespaced by plugin name", () => {
+    const source = readFileSync(resolve(process.cwd(), "src/plugin/index.ts"), "utf8");
+    const start = source.indexOf("public registerMathConversionMenuProvider");
+    const end = source.indexOf("public unregisterMathConversionMenuProvider", start);
+    assert.notEqual(start, -1);
+    assert.notEqual(end, -1);
+    const body = source.slice(start, end);
