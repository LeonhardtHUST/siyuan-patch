@@ -0,0 +1,188 @@
+/**
+ * 数学公式转换菜单提供器注册表。
+ *
+ * 宿主只在可写的公式菜单里收集提供器条目，并追加到原生“转换为”子菜单；
+ * 注册表负责命名空间化 data-id、隔离提供器异常并限制条目数量，不执行任何转换或写入操作。
+ */
+
+export type TMathConversionMenuSurface = "inline-context" | "block-convert";
+
+export interface IMathConversionMenuContext {
+    /** 公式节点：行内公式为 span[data-type="inline-math"]，块级公式为 div[data-subtype="math"] */
+    element: HTMLElement;
+    /** 公式所在块 */
+    blockElement: HTMLElement;
+    protyle: IProtyle;
+    surface: TMathConversionMenuSurface;
+    isReadOnly: boolean;
+}
+
+export interface IMathConversionMenuProvider {
+    /** 返回追加到原生“转换为”子菜单的条目 */
+    items: (context: IMathConversionMenuContext) => IMenu[];
+}
+
+export interface IMathConversionMenuTarget {
+    element: HTMLElement;
+    blockElement: HTMLElement;
+    protyle: IProtyle;
+    surface: TMathConversionMenuSurface;
+}
+
+interface IRegisteredMathConversionMenuProvider {
+    id: string;
+    provider: IMathConversionMenuProvider;
+}
+
+const providers: IRegisteredMathConversionMenuProvider[] = [];
+const MAX_DEPTH = 8;
+const MAX_PROVIDER_NODES = 64;
+const MAX_TOTAL_NODES = 128;
+const MENU_FIELDS: Array<keyof IMenu> = [
+    "checked", "iconClass", "label", "click", "type", "accelerator", "action", "actionLabel",
+    "id", "submenu", "loadSubmenu", "disabled", "icon", "iconHTML", "current", "bind", "index",
+    "element", "ignore", "warning",
+];
+
+/** 注册提供器；同一 id 重复注册会原位覆盖，保持菜单顺序不变 */
+export const registerMathConversionMenuProvider = (id: string, provider: IMathConversionMenuProvider) => {
+    const record = {id, provider};
+    const index = providers.findIndex(item => item.id === id);
+    if (index > -1) {
+        providers[index] = record;
+    } else {
+        providers.push(record);
+    }
+    return () => {
+        const currentIndex = providers.indexOf(record);
+        if (currentIndex > -1) {
+            providers.splice(currentIndex, 1);
+        }
+    };
+};
+
+/** 注销提供器 */
+export const unregisterMathConversionMenuProvider = (id: string) => {
+    const index = providers.findIndex(item => item.id === id);
+    if (index > -1) {
+        providers.splice(index, 1);
+    }
+};
+
+/** 只读工作区与只读编辑器都不提供转换菜单 */
+export const isMathConversionMenuReadOnly = (protyle: Pick<IProtyle, "disabled">) =>
+    Boolean(protyle.disabled || window.siyuan.config.readonly);
+
+const readOwn = (object: object, key: PropertyKey): unknown => {
+    const descriptor = Object.getOwnPropertyDescriptor(object, key);
+    return descriptor && ("value" in descriptor ? descriptor.value : descriptor.get?.call(object));
+};
+
+const qualifyMenuItems = (providerID: string, items: unknown, remaining: number) => {
+    let nodes = 0;
+    const path = new WeakSet<object>();
+    const visit = (parentID: string, entries: unknown, depth: number): IMenu[] => {
+        if (!Array.isArray(entries) || path.has(entries)) {
+            throw new Error("Invalid or cyclic math conversion submenu");
+        }
+        const length = readOwn(entries, "length");
+        if (typeof length !== "number" || length > MAX_PROVIDER_NODES || (length > 0 && depth > MAX_DEPTH)) {
+            throw new Error("Math conversion menu depth or node budget exceeded");
+        }
+        path.add(entries);
+        const result: IMenu[] = [];
+        const ids = new Set<string>();
+        for (let index = 0; index < length; index++) {
+            const item = readOwn(entries, index);
+            if (!item || typeof item !== "object") {
+                continue;
+            }
+            if (path.has(item) || ++nodes > MAX_PROVIDER_NODES || nodes > remaining) {
+                throw new Error("Math conversion menu cycle or node budget exceeded");
+            }
+            path.add(item);
+            const qualified: IMenu = {};
+            for (const field of MENU_FIELDS) {
+                const value = readOwn(item, field);
+                if (value !== undefined) {
+                    Object.defineProperty(qualified, field, {value, enumerable: true, writable: true, configurable: true});
+                }
+            }
+            const rawID = typeof qualified.id === "string" ? qualified.id : "";
+            const id = rawID ? `${parentID}:${encodeURIComponent(rawID)}` :
+                qualified.type === "separator" ? `${parentID}:separator_${index}` : "";
+            if (id && !ids.has(id)) {
+                ids.add(id);
+                qualified.id = id;
+                if (qualified.submenu !== undefined) {
+                    qualified.submenu = visit(id, qualified.submenu, depth + 1);
+                }
+                result.push(qualified);
+            }
+            path.delete(item);
+        }
+        path.delete(entries);
+        return result;
+    };
+    const qualified = visit(encodeURIComponent(providerID), items, 1);
+    return {items: qualified, nodes};
+};
+
+/** 按注册顺序收集提供器条目；单个提供器的异常不会影响其他提供器 */
+export const getMathConversionMenuItems = (context: IMathConversionMenuContext): IMenu[] => {
+    const result: IMenu[] = [];
+    let totalNodes = 0;
+    for (const entry of providers.slice()) {
+        if (totalNodes >= MAX_TOTAL_NODES) {
+            break;
+        }
+        try {
+            const qualified = qualifyMenuItems(entry.id, entry.provider.items(context), MAX_TOTAL_NODES - totalNodes);
+            result.push(...qualified.items);
+            totalNodes += qualified.nodes;
+        } catch (error) {
+            console.warn(`Math conversion menu provider [${entry.id}] failed:`, error);
+        }
+    }
+    return result;
+};
+
+/** 块级菜单使用的公式节点；块内没有唯一公式节点时回退为块元素 */
+export const getMathConversionMenuElement = (blockElement: HTMLElement): HTMLElement => {
+    if (blockElement.getAttribute("data-type") === "NodeMathBlock") {
+        return blockElement.querySelector<HTMLElement>('[data-subtype="math"]') || blockElement;
+    }
+    const inlineMathElements = blockElement.querySelectorAll<HTMLElement>('[data-type="inline-math"]');
+    return inlineMathElements.length === 1 ? inlineMathElements[0] : blockElement;
+};
+
+/** 为行内公式菜单创建原生“转换为”父条目，无提供器条目或只读时返回空 */
+export const createMathConversionMenu = (target: IMathConversionMenuTarget): IMenu | undefined => {
+    if (isMathConversionMenuReadOnly(target.protyle)) {
+        return undefined;
+    }
+    const submenu = getMathConversionMenuItems({...target, isReadOnly: false});
+    if (submenu.length === 0) {
+        return undefined;
+    }
+    return {
+        id: "turnInto",
+        icon: "iconTurnInto",
+        label: window.siyuan.languages.turnInto,
+        type: "submenu",
+        submenu,
+    };
+};
+
+/** 把提供器条目追加到块标菜单已有的“转换为”子菜单，返回是否追加 */
+export const appendMathConversionMenuItems = (items: IMenu[], target: IMathConversionMenuTarget) => {
+    if (isMathConversionMenuReadOnly(target.protyle)) {
+        return false;
+    }
+    const conversionItems = getMathConversionMenuItems({...target, isReadOnly: false});
+    if (conversionItems.length === 0) {
+        return false;
+    }
+    items.push(...conversionItems);
+    return true;
+};
