+        const bodyStart = source.indexOf("{", start);
+        const bodyEnd = source.indexOf("\n    }", bodyStart);
+        return new Function("registerMathConversionMenuProviderRegistry", "unregisterMathConversionMenuProviderRegistry",
+            `return function(id, provider) ${source.slice(bodyStart, bodyEnd + 6)}`)(
+            registerMathConversionMenuProvider, unregisterMathConversionMenuProvider) as
+            (this: {name: string}, id: string, provider?: IMathConversionMenuProvider) => (() => void) | void;
+    };
+    return {register: method("registerMathConversionMenuProvider"), unregister: method("unregisterMathConversionMenuProvider")};
+};
+
+test("plugin methods keep all plugin and provider segments distinct and cleanup generation safe", () => {
+    const methods = pluginMenuMethods();
+    const pairs = [["a/b", "c"], ["a", "b/c"], ["a%2Fb", "c"], ["a:b", "c"], ["a", "b:c"], ["汉字/插件", "x:%/"]];
+    try {
+        for (const [name, id] of pairs) {
+            methods.register.call({name}, id, {items: () => [{id: "entry:%/"}]});
+        }
+        const items = getMathConversionMenuItems(mathContext());
+        assert.equal(items.length, pairs.length);
+        assert.equal(new Set(items.map(item => item.id)).size, pairs.length);
+        const cleanup = methods.register.call({name: "a"}, "b/c", {items: () => [{id: "old"}]}) as () => void;
+        methods.register.call({name: "a"}, "b/c", {items: () => [{id: "new"}]});
+        cleanup();
+        assert.equal(getMathConversionMenuItems(mathContext()).some(item => item.id.endsWith(":new")), true);
+        methods.unregister.call({name: "a"}, "b/c");
+        assert.equal(getMathConversionMenuItems(mathContext()).length, pairs.length - 1);
+    } finally {
+        for (const [name, id] of pairs) methods.unregister.call({name}, id);
+    }
+});
+
+test("exact depth and recursive node limits are accepted with submenu read once", () => {
+    let deep: IMenu = {id: "leaf"};
+    for (let depth = 0; depth < 7; depth++) deep = {id: `depth${depth}`, submenu: [deep]};
+    let reads = 0;
+    withProviders([["depth", {items: () => [deep]}], ["nodes", {items: () => [{
+        id: "root", get submenu() {reads++; return Array.from({length: 63}, (_, index) => ({id: `${index}`}));},
+    }]}]], () => {
+        const items = getMathConversionMenuItems(mathContext());
+        assert.equal(items.length, 2);
+        assert.equal(items[1].submenu.length, 63);
+        assert.equal(reads, 1);
+    });
+});
+
+test("revoked arrays and provider accessor errors remain isolated", () => {
+    const revoked = Proxy.revocable([] as IMenu[], {});
+    revoked.revoke();
+    assertIsolated(() => revoked.proxy);
+    withProviders([
+        ["accessor", {get items(): IMathConversionMenuProvider["items"] {throw Error("provider getter");}}],
+        ["normal", {items: () => [{id: "ok"}]}],
+    ], () => assert.deepEqual(getMathConversionMenuItems(mathContext()).map(item => item.id), ["normal:ok"]));
+});
+
