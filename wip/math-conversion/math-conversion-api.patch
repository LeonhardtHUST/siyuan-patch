+func (fixture *mathConversionAPIFixture) snapshot(t *testing.T, blockID string) mathConversionAPISnapshot {
+	t.Helper()
+	recorder := fixture.call(t, fixture.engine, mathConversionContractPath, map[string]any{"blockID": blockID})
+	var envelope mathConversionAPISnapshotEnvelope
+	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
+		t.Fatal(err)
+	}
+	if envelope.Code != 0 {
+		t.Fatalf("snapshot %s failed: %s", blockID, recorder.Body.String())
+	}
+	snapshot := mathConversionAPISnapshot{Notebook: envelope.Data.Notebook, RootID: envelope.Data.RootID,
+		Path: envelope.Data.Path, Version: envelope.Data.Version, BlockType: envelope.Data.BlockType,
+		TopLevel: envelope.Data.TopLevel, Targets: envelope.Data.Targets}
+	return snapshot
+}
+
+func mathConversionAPIConvertPayload(snapshot mathConversionAPISnapshot, blockID, direction string, target mathConversionAPITarget) map[string]any {
+	data := map[string]any{
+		"notebook": snapshot.Notebook, "rootID": snapshot.RootID, "path": snapshot.Path, "blockID": blockID,
+		"direction": direction, "targetPath": target.Path, "expectedSource": target.Source,
+		"expectedVersion": snapshot.Version,
+	}
+	operation := map[string]any{"action": "convertMath", "id": blockID, "blockID": blockID, "data": data}
+	return map[string]any{"transactions": []map[string]any{{"doOperations": []map[string]any{operation}}},
+		"reqId": 1, "app": "contract", "session": "contract"}
+}
+
+func (fixture *mathConversionAPIFixture) fileBytes(t *testing.T) []byte {
+	t.Helper()
+	data, err := os.ReadFile(fixture.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
