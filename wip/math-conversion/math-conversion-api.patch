+	sql.InitDatabase(true)
+	sql.InitHistoryDatabase(true)
+	sql.InitAssetContentDatabase(true)
+	model.GlobalUndoLog.Clear("")
+	t.Cleanup(func() {
+		model.FlushTxQueue()
+		model.GlobalUndoLog.Clear("")
+		sql.CloseDatabase()
+		treenode.CloseDatabase()
+		model.Conf, util.Lang, util.Langs = oldConf, oldLang, oldLangs
+		if hadTimeLang {
+			util.TimeLangs["en"] = oldTimeLang
+		} else {
+			delete(util.TimeLangs, "en")
+		}
+		util.WorkspaceDir, util.HomeDir, util.TempDir = oldWorkspaceDir, oldHomeDir, oldTempDir
+		util.HistoryDir, util.RepoDir, util.LogPath = oldHistoryDir, oldRepoDir, oldLogPath
+		util.DataDir, util.BlockTreeDBPath, util.QueueDir = oldDataDir, oldBlockTreeDBPath, oldQueueDir
+		util.ConfDir, util.DBPath = oldConfDir, oldDBPath
+		util.HistoryDBPath, util.AssetContentDBPath = oldHistoryDBPath, oldAssetContentDBPath
+	})
+
+	docPath := "/" + mathConversionDocID + ".sy"
+	tree := treenode.NewTree(mathConversionBoxID, docPath, "/Math conversion", "Math conversion")
+	mathConversionSetRootChildren(tree, mathConversionParagraph(mathConversionInlineID, mathConversionInline("x + 1")),
+		mathConversionMathBlock(mathConversionBlockID, "y = 2"),
+		mathConversionBudgetParagraph(), mathConversionReadonlyParagraph(), mathConversionNestedList())
+	if _, err := filesys.WriteTree(tree); err != nil {
