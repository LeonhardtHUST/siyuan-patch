+func TestAPIContractMathConversion(t *testing.T) {
+	const helper = "SIYUAN_TEST_MATH_CONVERSION_API"
+	if os.Getenv(helper) != "1" {
+		// 数据库、块树和撤销状态都是进程级变量，用独立测试进程避免污染同包其他用例。
+		ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+		defer cancel()
+		command := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestAPIContractMathConversion$", "-test.v")
+		command.Env = append(os.Environ(), helper+"=1")
+		if output, err := command.CombinedOutput(); err != nil {
+			t.Fatalf("math conversion API subprocess failed: %v\n%s", err, output)
+		}
+		return
+	}
+	fixture := setupMathConversionAPIContractTest(t)
+
+	t.Run("snapshot targets", func(t *testing.T) {
+		inline := fixture.snapshot(t, mathConversionInlineID)
+		if inline.Notebook != mathConversionBoxID || inline.RootID != mathConversionDocID ||
+			inline.Path != "/"+mathConversionDocID+".sy" || inline.BlockType != "NodeParagraph" || !inline.TopLevel {
+			t.Fatalf("unexpected inline snapshot: %#v", inline)
+		}
+		if len(inline.Version) != 64 {
+			t.Fatalf("unexpected source version: %q", inline.Version)
+		}
+		if _, err := hex.DecodeString(inline.Version); err != nil {
+			t.Fatalf("source version is not a SHA-256 digest: %v", err)
+		}
+		if len(inline.Targets) != 1 || !inline.Targets[0].Supported || inline.Targets[0].Type != "inline-math" ||
+			inline.Targets[0].Source != "x + 1" || len(inline.Targets[0].Path) != 1 || inline.Targets[0].Path[0] != 0 {
+			t.Fatalf("unexpected inline targets: %#v", inline.Targets)
+		}
+		math := fixture.snapshot(t, mathConversionBlockID)
+		if math.BlockType != "NodeMathBlock" || len(math.Targets) != 1 || !math.Targets[0].Supported ||
+			math.Targets[0].Type != "math-block" || math.Targets[0].Source != "y = 2" || len(math.Targets[0].Path) != 0 {
+			t.Fatalf("unexpected math block snapshot: %#v", math)
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("snapshot changed the document source")
+		}
+	})
+
+	t.Run("snapshot rejections", func(t *testing.T) {
+		recorder := fixture.call(t, fixture.engine, mathConversionContractPath, map[string]any{"blockID": "invalid"})
+		if code, _ := mathConversionAPIResponseCode(t, recorder); code != -1 {
+			t.Fatalf("invalid block ID accepted: %s", recorder.Body.String())
+		}
+		recorder = fixture.call(t, fixture.engine, mathConversionContractPath, map[string]any{"blockID": mathConversionMissingID})
+		if code, _ := mathConversionAPIResponseCode(t, recorder); code != mathConversionConflictCode {
+			t.Fatalf("missing block did not conflict: %s", recorder.Body.String())
+		}
+		recorder = fixture.call(t, fixture.engine, mathConversionContractPath, map[string]any{"blockID": mathConversionBudgetID})
+		code, msg := mathConversionAPIResponseCode(t, recorder)
+		if code != mathConversionUnsupportedCode || !strings.Contains(msg, "unsupported") {
+			t.Fatalf("inline budget was not rejected: %s", recorder.Body.String())
+		}
+		nested := fixture.snapshot(t, mathConversionNestedParaID)
+		if nested.TopLevel || len(nested.Targets) != 1 || nested.Targets[0].Supported ||
+			!strings.Contains(nested.Targets[0].Reason, "nested") {
+			t.Fatalf("nested target was not marked unsupported: %#v", nested)
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("rejected snapshot changed the document source")
+		}
+	})
+
+	t.Run("convert and undo", func(t *testing.T) {
+		snapshot := fixture.snapshot(t, mathConversionInlineID)
+		recorder := fixture.call(t, fixture.engine, "/api/transactions",
+			mathConversionAPIConvertPayload(snapshot, mathConversionInlineID, "inline-to-block", snapshot.Targets[0]))
+		var converted mathConversionAPITransactionEnvelope
+		if err := json.Unmarshal(recorder.Body.Bytes(), &converted); err != nil {
+			t.Fatal(err)
+		}
+		if converted.Code != 0 || len(converted.Data) != 1 || len(converted.Data[0].DoOperations) != 1 {
+			t.Fatalf("conversion failed: %s", recorder.Body.String())
+		}
+		operation := converted.Data[0].DoOperations[0]
+		if operation.Action != "convertMath" || len(operation.RetData) != 1 || operation.RetData[0] != mathConversionInlineID {
+			t.Fatalf("conversion returned unexpected retData: %s", recorder.Body.String())
+		}
+		if bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("conversion did not change the document source")
+		}
+		if dom := model.GetBlockDOM(mathConversionInlineID); !strings.Contains(dom, `data-type="NodeMathBlock"`) {
+			t.Fatalf("conversion did not produce a math block: %s", dom)
+		}
+		fixture.requireUndoState(t, true, false)
+
+		recorder = fixture.call(t, fixture.engine, "/api/transactions/undo", map[string]any{"rootID": mathConversionDocID})
+		var undone mathConversionAPIUndoEnvelope
+		if err := json.Unmarshal(recorder.Body.Bytes(), &undone); err != nil {
+			t.Fatal(err)
+		}
+		if undone.Code != 0 || undone.Data.Failed || !undone.Data.IsUndo || len(undone.Data.DoOperations) != 1 ||
+			undone.Data.DoOperations[0].Action != "convertMath" {
+			t.Fatalf("undo failed: %s", recorder.Body.String())
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("undo did not restore the original document source")
+		}
+		if dom := model.GetBlockDOM(mathConversionInlineID); !strings.Contains(dom, `data-type="NodeParagraph"`) {
+			t.Fatalf("undo did not restore the paragraph: %s", dom)
+		}
+		fixture.requireUndoState(t, false, true)
+	})
+
+	t.Run("stale conversion", func(t *testing.T) {
+		snapshot := fixture.snapshot(t, mathConversionInlineID)
+		payload := mathConversionAPIConvertPayload(snapshot, mathConversionInlineID, "inline-to-block", snapshot.Targets[0])
+		recorder := fixture.call(t, fixture.engine, "/api/transactions", payload)
+		if code, _ := mathConversionAPIResponseCode(t, recorder); code != 0 {
+			t.Fatalf("conversion failed: %s", recorder.Body.String())
+		}
+		converted := fixture.fileBytes(t)
+		recorder = fixture.call(t, fixture.engine, "/api/transactions", payload)
+		code, msg := mathConversionAPIResponseCode(t, recorder)
+		if code != mathConversionConflictCode || !strings.Contains(msg, "conflict") {
+			t.Fatalf("stale conversion was not rejected: %s", recorder.Body.String())
+		}
+		if !bytes.Equal(fixture.fileBytes(t), converted) {
+			t.Fatal("stale conversion changed the document source")
+		}
+		recorder = fixture.call(t, fixture.engine, "/api/transactions/undo", map[string]any{"rootID": mathConversionDocID})
+		if code, _ := mathConversionAPIResponseCode(t, recorder); code != 0 {
+			t.Fatalf("undo failed: %s", recorder.Body.String())
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("stale conversion left an extra undo entry or source change")
+		}
+		fixture.requireUndoState(t, false, true)
+	})
+
+	t.Run("rejected combinations", func(t *testing.T) {
+		snapshot := fixture.snapshot(t, mathConversionInlineID)
+		convertPayload := mathConversionAPIConvertPayload(snapshot, mathConversionInlineID, "inline-to-block", snapshot.Targets[0])
+		operation := convertPayload["transactions"].([]map[string]any)[0]["doOperations"].([]map[string]any)[0]
+		for name, payload := range map[string]map[string]any{
+			"second operation": {"transactions": []map[string]any{{"doOperations": []map[string]any{operation,
+				{"action": "delete", "id": mathConversionInlineID}}}}, "reqId": 1},
+			"second transaction": {"transactions": []map[string]any{{"doOperations": []map[string]any{operation}},
+				{"doOperations": []map[string]any{{"action": "delete", "id": mathConversionInlineID}}}}, "reqId": 1},
+			"client undo operations": {"transactions": []map[string]any{{"doOperations": []map[string]any{operation},
+				"undoOperations": []map[string]any{{"action": "delete", "id": mathConversionInlineID}}}}, "reqId": 1},
+			"source removal versions": {"transactions": []map[string]any{{"doOperations": []map[string]any{operation},
+				"collectionRemovalSourceVersions": map[string]string{mathConversionDocID: "version"}}}, "reqId": 1},
+			"unknown direction": func() map[string]any {
+				copied := mathConversionAPIConvertPayload(snapshot, mathConversionInlineID, "sideways", snapshot.Targets[0])
+				copiedData := copied["transactions"].([]map[string]any)[0]["doOperations"].([]map[string]any)[0]["data"].(map[string]any)
+				copiedData["direction"] = "sideways"
+				return copied
+			}(),
+			"mismatched block": func() map[string]any {
+				copied := mathConversionAPIConvertPayload(snapshot, mathConversionInlineID, "inline-to-block", snapshot.Targets[0])
+				copied["transactions"].([]map[string]any)[0]["doOperations"].([]map[string]any)[0]["id"] = mathConversionBlockID
+				return copied
+			}(),
+		} {
+			recorder := fixture.call(t, fixture.engine, "/api/transactions", payload)
+			if code, _ := mathConversionAPIResponseCode(t, recorder); code != -1 {
+				t.Fatalf("%s accepted: %s", name, recorder.Body.String())
+			}
+			if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+				t.Fatalf("%s changed the document source", name)
+			}
+		}
+		fixture.requireUndoState(t, false, true)
+	})
+
+	t.Run("readonly target rejected", func(t *testing.T) {
+		snapshot := fixture.snapshot(t, mathConversionReadonlyID)
+		recorder := fixture.call(t, fixture.engine, "/api/transactions",
+			mathConversionAPIConvertPayload(snapshot, mathConversionReadonlyID, "inline-to-block", snapshot.Targets[0]))
+		code, msg := mathConversionAPIResponseCode(t, recorder)
+		if code != mathConversionPermissionCode || !strings.Contains(msg, "permission") {
+			t.Fatalf("readonly conversion was not rejected: %s", recorder.Body.String())
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("readonly conversion changed the document source")
+		}
+		fixture.requireUndoState(t, false, true)
+	})
+
+	t.Run("unsupported conversion rejected", func(t *testing.T) {
+		nested := fixture.snapshot(t, mathConversionNestedParaID)
+		recorder := fixture.call(t, fixture.engine, "/api/transactions",
+			mathConversionAPIConvertPayload(nested, mathConversionNestedParaID, "inline-to-block", nested.Targets[0]))
+		if code, msg := mathConversionAPIResponseCode(t, recorder); code != mathConversionUnsupportedCode || !strings.Contains(msg, "unsupported") {
+			t.Fatalf("nested conversion was not rejected: %s", recorder.Body.String())
+		}
+		if !bytes.Equal(fixture.fileBytes(t), fixture.source) {
+			t.Fatal("nested conversion changed the document source")
+		}
+	})
+
+	t.Run("writable route policy", func(t *testing.T) {
+		definition := apicontract.GetMathConversionTarget.Definition()
+		if definition.Authorization&apicontract.AuthenticatedAccess == 0 ||
+			definition.Authorization&apicontract.AdminAccess == 0 || definition.Authorization&apicontract.WritableAccess == 0 {
+			t.Fatal("snapshot route is not restricted to administrators of a writable workspace")
+		}
+		if handlers := contractRouteHandlers(apicontract.GetMathConversionTarget, getMathConversionTarget); len(handlers) != 4 {
+			t.Fatalf("snapshot route authorization middleware is incomplete: %d", len(handlers))
+		}
+		readonlyEngine := gin.New()
+		readonlyEngine.Use(func(c *gin.Context) {
+			c.Set(model.RoleContextKey, model.RoleReader)
+			c.Next()
+		}, model.CheckReadonly)
+		readonlyEngine.POST(mathConversionContractPath, getMathConversionTarget)
+		recorder := fixture.call(t, readonlyEngine, mathConversionContractPath, map[string]any{"blockID": mathConversionInlineID})
+		if code, _ := mathConversionAPIResponseCode(t, recorder); code != -1 {
+			t.Fatalf("read-only role was not rejected: %s", recorder.Body.String())
+		}
+	})
+}
