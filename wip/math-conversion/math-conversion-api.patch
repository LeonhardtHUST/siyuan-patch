+func (fixture *mathConversionAPIFixture) requireUndoState(t *testing.T, canUndo, canRedo bool) {
+	t.Helper()
+	recorder := fixture.call(t, fixture.engine, "/api/transactions/undoState", map[string]any{"rootID": mathConversionDocID})
+	var envelope mathConversionAPIUndoStateEnvelope
+	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
+		t.Fatal(err)
+	}
+	if envelope.Code != 0 || envelope.Data.CanUndo != canUndo || envelope.Data.CanRedo != canRedo {
+		t.Fatalf("unexpected undo state: %s", recorder.Body.String())
+	}
+}
+
+func mathConversionAPIResponseCode(t *testing.T, recorder *httptest.ResponseRecorder) (int, string) {
+	t.Helper()
+	var envelope struct {
+		Code int    `json:"code"`
+		Msg  string `json:"msg"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
+		t.Fatalf("decode response failed: %s", recorder.Body.String())
+	}
+	return envelope.Code, envelope.Msg
+}
