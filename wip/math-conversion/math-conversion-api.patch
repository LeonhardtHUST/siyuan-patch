+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package api
+
+import (
+	"encoding/json"
+	"errors"
+
+	"github.com/gin-gonic/gin"
+	"github.com/siyuan-note/siyuan/kernel/apicontract"
+	"github.com/siyuan-note/siyuan/kernel/mathconversion"
+	"github.com/siyuan-note/siyuan/kernel/model"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// 公式转换的业务错误码：来源版本或结构冲突、内核支持的转换范围、编辑权限。
+const (
+	mathConversionConflictCode    = -409
+	mathConversionPermissionCode  = 403
+	mathConversionUnsupportedCode = 422
+)
+
+// getMathConversionTarget 返回只读来源快照与目标候选。加密笔记本租约允许目标块暂不可见，
+// 由快照或提交按锁定状态返回权限错误，避免把锁定笔记本误报为块不存在。
+var getMathConversionTarget = contractHandler(apicontract.GetMathConversionTarget, func(c *gin.Context, request apicontract.MathConversionTargetRequest) apicontract.Response[apicontract.MathConversionTargetData] {
+	if err := holdEncryptedBlockRequests(c, "", []string{request.BlockID}, true); err != nil {
+		return apicontract.Failure[apicontract.MathConversionTargetData](mathConversionPermissionCode, util.EscapeHTML(err.Error()))
+	}
+	snapshot, err := model.SnapshotMathConversion(request.BlockID)
+	if err != nil {
+		return mathConversionFailure[apicontract.MathConversionTargetData](err)
+	}
+	return apicontract.Success(*mathConversionTargetData(snapshot))
+})
+
+func mathConversionTargetData(snapshot *model.MathConversionSnapshot) *apicontract.MathConversionTargetData {
+	data := &apicontract.MathConversionTargetData{
+		Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path, Version: snapshot.Version,
+		BlockType: snapshot.BlockType, TopLevel: snapshot.TopLevel,
+	}
+	for _, target := range snapshot.Targets {
+		data.Targets = append(data.Targets, &apicontract.MathConversionTarget{
+			Path: append([]int{}, target.Path...), Type: target.Type, Source: target.Source,
+			Supported: target.Supported, Reason: target.Reason,
+		})
+	}
+	return data
+}
+
+// mathConversionFailure 把模型层的 typed 公式转换错误映射成稳定的业务码，其余错误保持 -1。
+func mathConversionFailure[Data any](err error) apicontract.Response[Data] {
+	var failure *model.MathConversionError
+	if errors.As(err, &failure) {
+		switch failure.Kind {
+		case model.MathConversionConflict:
+			return apicontract.Failure[Data](mathConversionConflictCode, util.EscapeHTML(err.Error()))
+		case model.MathConversionUnsupported:
+			return apicontract.Failure[Data](mathConversionUnsupportedCode, util.EscapeHTML(err.Error()))
+		case model.MathConversionPermission:
+			return apicontract.Failure[Data](mathConversionPermissionCode, util.EscapeHTML(err.Error()))
+		}
+	}
+	return apicontract.Failure[Data](-1, util.EscapeHTML(err.Error()))
+}
+
+// newMathConversionOperation 把 HTTP 操作数据转成内核单操作。客户端只能提交目标和预期来源，
+// before/after 快照与生成 ID 的回调由内核在提交时构造；操作级 id 必须与 data.blockID 一致。
+func newMathConversionOperation(operation *model.Operation) (*model.Operation, error) {
+	data, err := json.Marshal(operation.Data)
+	if err != nil {
+		return nil, err
+	}
+	var payload apicontract.TransactionMathConversion
+	if err = json.Unmarshal(data, &payload); err != nil {
+		return nil, err
+	}
+	if operation.ID != "" && operation.ID != payload.BlockID ||
+		operation.BlockID != "" && operation.BlockID != payload.BlockID {
+		return nil, errors.New("math conversion block and target block differ")
+	}
+	direction := mathconversion.Direction(0)
+	switch payload.Direction {
+	case "inline-to-block":
+		direction = mathconversion.InlineToBlock
+	case "block-to-inline":
+		direction = mathconversion.BlockToInline
+	}
+	return model.NewConvertMathOperation(model.MathConversionRequest{
+		Notebook: payload.Notebook, RootID: payload.RootID, Path: payload.Path, BlockID: payload.BlockID,
+		Direction: direction, TargetPath: payload.TargetPath, ExpectedSource: payload.ExpectedSource,
+		ExpectedVersion: payload.ExpectedVersion,
+	})
+}
