+
+func mathConversionSetRootChildren(tree *parse.Tree, blocks ...*ast.Node) {
+	for child := tree.Root.FirstChild; child != nil; {
+		next := child.Next
+		child.Unlink()
+		child = next
+	}
+	for _, block := range blocks {
+		tree.Root.AppendChild(block)
+	}
+}
+
+func mathConversionParagraph(id string, children ...*ast.Node) *ast.Node {
+	paragraph := &ast.Node{Type: ast.NodeParagraph, ID: id}
+	paragraph.SetIALAttr("id", id)
+	for _, child := range children {
+		paragraph.AppendChild(child)
+	}
+	return paragraph
+}
+
+func mathConversionInline(source string) *ast.Node {
+	return &ast.Node{Type: ast.NodeTextMark, TextMarkType: "inline-math", TextMarkInlineMathContent: source}
+}
+
+func mathConversionMathBlock(id, source string) *ast.Node {
+	block := &ast.Node{Type: ast.NodeMathBlock, ID: id}
+	block.SetIALAttr("id", id)
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockOpenMarker, Tokens: []byte("$$")})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockContent, Tokens: []byte(source)})
+	block.AppendChild(&ast.Node{Type: ast.NodeMathBlockCloseMarker, Tokens: []byte("$$")})
+	return block
+}
+
+func mathConversionBudgetParagraph() *ast.Node {
+	children := make([]*ast.Node, 0, mathConversionInlineBudget+1)
+	for index := range mathConversionInlineBudget + 1 {
+		children = append(children, mathConversionInline(fmt.Sprintf("b + %d", index)))
+	}
+	return mathConversionParagraph(mathConversionBudgetID, children...)
+}
+
+func mathConversionReadonlyParagraph() *ast.Node {
+	paragraph := mathConversionParagraph(mathConversionReadonlyID, mathConversionInline("r + 1"))
+	paragraph.SetIALAttr("custom-sy-readonly", "true")
+	return paragraph
+}
+
+func mathConversionNestedList() *ast.Node {
+	list := &ast.Node{Type: ast.NodeList, ID: mathConversionNestedListID, ListData: &ast.ListData{Typ: 1}}
+	list.SetIALAttr("id", mathConversionNestedListID)
+	item := &ast.Node{Type: ast.NodeListItem, ID: mathConversionNestedItemID, ListData: &ast.ListData{Typ: 1}}
+	item.SetIALAttr("id", mathConversionNestedItemID)
+	item.AppendChild(mathConversionParagraph(mathConversionNestedParaID, mathConversionInline("n + 1")))
+	list.AppendChild(item)
+	return list
+}
+
+// mathConversionInlineBudget 与模型层有界扫描的候选上限一致，用于验证接口的预算拒绝。
+const mathConversionInlineBudget = 32
+
