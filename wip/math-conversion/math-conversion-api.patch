index 0000000..1a2e271
--- /dev/null
+++ b/kernel/apicontract/math_conversion.go
@@ -0,0 +1,49 @@
+// SiYuan - https://github.com/siyuan-note/siyuan
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package apicontract
+
+// MathConversionTargetRequest 读取一个块的公式转换快照。blockID 必须是目标段落或数学块本身。
+type MathConversionTargetRequest struct {
+	BlockID string `json:"blockID"`
+}
+
+// MathConversionTarget 是单个转换候选。path 为块内 AST 直接子级索引，数学块为空数组；
+// source 是内核规划的精确公式源。supported 为 false 时 reason 说明不支持的原因，
+// 调用方不得自行改选目标或按公式文本重新匹配。
+type MathConversionTarget struct {
+	Path      []int  `json:"path"`
+	Type      string `json:"type" api:"enum=inline-math|math-block"`
+	Source    string `json:"source"`
+	Supported bool   `json:"supported"`
+	Reason    string `json:"reason"`
+}
+
+// MathConversionTargetData 绑定同次读取的原文件字节摘要与全部候选。version 是原文件的 SHA-256，
+// 不是 updated 或 Markdown 投影；提交事务仍会重新读取来源并比较，快照本身不改变文档。
+type MathConversionTargetData struct {
+	Notebook  string                  `json:"notebook"`
+	RootID    string                  `json:"rootID"`
+	Path      string                  `json:"path"`
+	Version   string                  `json:"version"`
+	BlockType string                  `json:"blockType"`
+	TopLevel  bool                    `json:"topLevel"`
+	Targets   []*MathConversionTarget `json:"targets"`
+}
+
+// TransactionMathConversion 描述一次 convertMath 操作的目标、方向和预期来源。
+// notebook、rootID、path、blockID 必须对应目标块；direction 为 inline-to-block 或 block-to-inline。
+// inline-to-block 的 targetPath 必须包含一个 AST 直接子级索引，block-to-inline 必须为空数组。
+// expectedSource 为快照返回的精确公式源，expectedVersion 为快照返回的原文件摘要；两者都由内核在提交时重新校验。
+// 操作必须作为单笔、单操作事务提交，before/after 快照与撤销数据只由内核生成，客户端不能提交。
+type TransactionMathConversion struct {
+	Notebook        string `json:"notebook"`
+	RootID          string `json:"rootID"`
+	Path            string `json:"path"`
+	BlockID         string `json:"blockID"`
+	Direction       string `json:"direction" api:"enum=inline-to-block|block-to-inline"`
+	TargetPath      []int  `json:"targetPath"`
+	ExpectedSource  string `json:"expectedSource"`
+	ExpectedVersion string `json:"expectedVersion"`
+}
