+func TestMathConversionUndoPreservesDynamicRefNeighborInline(t *testing.T) {
+	fixture := setupMathConversionTest(t)
+	tree := mathConversionLoadTree(t, fixture.sourceID)
+	targetID := "20260718003101-abcdefg"
+	neighborID := "20260718003100-abcdefg"
+	refID := "20260718003102-abcdefg"
+	neighbor := mathConversionParagraph(neighborID, mathConversionText("refer "),
+		&ast.Node{Type: ast.NodeTextMark, TextMarkType: "block-ref",
+			TextMarkBlockRefID: refID, TextMarkBlockRefSubtype: "d", TextMarkTextContent: "1"},
+	)
+	mathConversionSetRootBlocks(t, tree,
+		neighbor,
+		mathConversionParagraph(targetID, mathConversionInline("dynamic + neighbor")),
+	)
+	mathConversionWriteTree(t, tree)
+
+	reloaded := mathConversionLoadTree(t, fixture.sourceID)
+	reloadedRef := treenode.GetNodeInTree(reloaded, neighborID).LastChild
+	if reloadedRef == nil || reloadedRef.Type != ast.NodeTextMark || reloadedRef.TextMarkBlockRefSubtype != "d" ||
+		reloadedRef.TextMarkTextContent != "1" {
+		t.Fatalf("block reference did not survive the document write: %+v", reloadedRef)
+	}
+	snapshot := mathConversionSnapshot(t, targetID)
+	request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+		BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{0},
+		ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+	if err := mathConversionPerform(t, request); err != nil {
+		t.Fatalf("conversion failed: %v", err)
+	}
+
+	external := mathConversionLoadTree(t, fixture.sourceID)
+	externalRef := treenode.GetNodeInTree(external, neighborID).LastChild
+	externalRef.TextMarkTextContent = "9"
+	mathConversionWriteTree(t, external)
+	if err := mathConversionUndo(t, fixture.sourceID); err != nil {
+		t.Fatalf("dynamic reference neighbor edit blocked undo: %v", err)
+	}
+	restored := mathConversionLoadTree(t, fixture.sourceID)
+	restoredRef := treenode.GetNodeInTree(restored, neighborID).LastChild
+	if restoredRef == nil || restoredRef.TextMarkTextContent != "9" {
+		t.Fatalf("undo did not preserve the dynamic reference text: %+v", restoredRef)
+	}
+	restoredTarget := treenode.GetNodeInTree(restored, targetID)
+	if restoredTarget == nil || restoredTarget.Type != ast.NodeParagraph ||
+		mathConversionInlineSourceOf(restoredTarget) != "dynamic + neighbor" {
+		t.Fatalf("undo did not restore the converted target: %+v", restoredTarget)
+	}
+}
