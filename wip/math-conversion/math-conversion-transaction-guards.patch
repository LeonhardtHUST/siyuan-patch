+func TestMathConversionUndoRejectsExternalPersistentFieldChanges(t *testing.T) {
+	for _, testcase := range []struct {
+		name    string
+		field   string
+		value   string
+		rawJSON bool
+	}{
+		{"updated", "updated", "20260718002700", false},
+		{"refcount", "refcount", "7", true},
+	} {
+		t.Run(testcase.name, func(t *testing.T) {
+			fixture := setupMathConversionTest(t)
+			tree := mathConversionLoadTree(t, fixture.sourceID)
+			targetID := "20260718002701-abcdefg"
+			mathConversionSetRootBlocks(t, tree,
+				mathConversionParagraph("20260718002700-abcdefg", mathConversionText("before")),
+				mathConversionParagraph(targetID, mathConversionInline("persistent + field")),
+			)
+			mathConversionWriteTree(t, tree)
+			snapshot := mathConversionSnapshot(t, targetID)
+			request := MathConversionRequest{Notebook: snapshot.Notebook, RootID: snapshot.RootID, Path: snapshot.Path,
+				BlockID: targetID, Direction: mathconversion.InlineToBlock, TargetPath: []int{0},
+				ExpectedSource: snapshot.Targets[0].Source, ExpectedVersion: snapshot.Version}
+			if err := mathConversionPerform(t, request); err != nil {
+				t.Fatalf("conversion failed: %v", err)
+			}
+			converted := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+			var changed []byte
+			if testcase.rawJSON {
+				changed = mathConversionInjectBlockProperty(t, fixture.box.ID, fixture.sourceID, fixture.sourcePath,
+					targetID, testcase.field, testcase.value)
+			} else {
+				external := mathConversionLoadTree(t, fixture.sourceID)
+				externalBlock := treenode.GetNodeInTree(external, targetID)
+				if externalBlock == nil {
+					t.Fatal("converted block is missing from the reloaded document")
+				}
+				externalBlock.SetIALAttr(testcase.field, testcase.value)
+				mathConversionWriteTree(t, external)
+				changed = mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath)
+			}
+			if bytes.Equal(changed, converted) {
+				t.Fatalf("external %s edit did not reach the document source", testcase.field)
+			}
+			persisted := treenode.GetNodeInTree(mathConversionLoadTree(t, fixture.sourceID), targetID)
+			if persisted == nil || persisted.IALAttr(testcase.field) != testcase.value {
+				t.Fatalf("external %s edit was not persisted", testcase.field)
+			}
+
+			err := mathConversionUndo(t, fixture.sourceID)
+			requireMathConversionKind(t, err, MathConversionConflict)
+			if current := mathConversionRawFile(t, fixture.box.ID, fixture.sourcePath); !bytes.Equal(current, changed) {
+				t.Fatal("failed undo overwrote the external persistent field change")
+			}
+			if depth := mathConversionUndoDepth(fixture.sourceID); depth != 1 {
+				t.Fatalf("failed undo must stay retryable: undo=%d", depth)
+			}
+			reloaded := treenode.GetNodeInTree(mathConversionLoadTree(t, fixture.sourceID), targetID)
+			if reloaded == nil || reloaded.IALAttr(testcase.field) != testcase.value {
+				t.Fatalf("failed undo discarded the external %s value", testcase.field)
+			}
+		})
+	}
+}
