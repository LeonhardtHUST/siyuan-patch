+func TestMathConversionNilOperationRejected(t *testing.T) {
+	transaction := &Transaction{}
+	txErr := transaction.doConvertMath(nil)
+	if txErr == nil {
+		t.Fatal("nil conversion operation was accepted")
+	}
+	if code := txErr.Code(); code != TxErrCodePushMsg {
+		t.Fatalf("unexpected transaction error code: got %d, want %d", code, TxErrCodePushMsg)
+	}
+	if txErr.id != "" {
+		t.Fatalf("nil operation failure must not carry a block ID: %q", txErr.id)
+	}
+	var failure *MathConversionError
+	if !errors.As(txErr, &failure) || failure.Kind != MathConversionInvalid {
+		t.Fatalf("nil operation failure is not a typed invalid conversion error: %v", txErr)
+	}
+}
