+func mathConversionFindDynamicRef(node *ast.Node) *ast.Node {
+	var found *ast.Node
+	ast.Walk(node, func(current *ast.Node, entering bool) ast.WalkStatus {
+		if entering && current.Type == ast.NodeTextMark && current.TextMarkType == "block-ref" &&
+			current.TextMarkBlockRefSubtype == "d" {
+			found = current
+			return ast.WalkStop
+		}
+		return ast.WalkContinue
+	})
+	return found
+}
+
+// planner 会拒绝目标段落里公式之外的 block-ref（persistentFields 认定为 unproven metadata），
+// 因此动态引用角标无法经由一次成功转换进入被替换 run。这里直接调用 undo 重放前的同一份
+// mathConversionValidateRun 校验：被替换 run 的动态引用正文变化必须整体 conflict。
+func TestMathConversionUndoValidationRejectsDynamicRefChange(t *testing.T) {
+	targetID := "20260718003201-abcdefg"
+	block := mathConversionParagraph(targetID, mathConversionText("see "),
+		&ast.Node{Type: ast.NodeTextMark, TextMarkType: "block-ref",
+			TextMarkBlockRefID: "20260718003202-abcdefg", TextMarkBlockRefSubtype: "d", TextMarkTextContent: "1"},
+	)
+	root := &ast.Node{Type: ast.NodeDocument, ID: "20260718003200-abcdefg"}
+	root.AppendChild(block)
+	tree := &parse.Tree{Root: root}
+	fragment := mathConversionFragment{node: cloneBlockSwapNode(block)}
+	position := mathConversionCapturePosition(block, block)
+	run, err := mathConversionValidateRun(tree, []mathConversionFragment{fragment}, position)
+	if err != nil || len(run) != 1 || run[0] != block {
+		t.Fatalf("baseline undo validation failed: run=%+v err=%v", run, err)
+	}
+
+	ref := mathConversionFindDynamicRef(block)
+	if ref == nil {
+		t.Fatal("dynamic reference is missing from the validation fixture")
+	}
+	ref.TextMarkTextContent = "9"
+	run, err = mathConversionValidateRun(tree, []mathConversionFragment{fragment}, position)
+	requireMathConversionKind(t, err, MathConversionConflict)
+	if run != nil {
+		t.Fatalf("conflicted undo validation returned a stale run: %d blocks", len(run))
+	}
+}
