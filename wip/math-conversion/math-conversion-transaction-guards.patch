+// mathConversionInjectBlockProperty 模拟其他进程直接改 raw .sy：JSON 渲染会主动删除 refcount，
+// 只能通过源文件注入才能构造真实的仅 refcount 外部修改。
+func mathConversionInjectBlockProperty(t *testing.T, boxID, documentID, documentPath, blockID, key, value string) []byte {
+	t.Helper()
+	raw := mathConversionRawFile(t, boxID, documentPath)
+	var document map[string]any
+	if err := json.Unmarshal(raw, &document); err != nil {
+		t.Fatalf("decode document source failed: %v", err)
+	}
+	var find func(any) map[string]any
+	find = func(candidate any) map[string]any {
+		node, ok := candidate.(map[string]any)
+		if !ok {
+			return nil
+		}
+		if node["ID"] == blockID {
+			return node
+		}
+		children, ok := node["Children"].([]any)
+		if !ok {
+			return nil
+		}
+		for _, child := range children {
+			if found := find(child); found != nil {
+				return found
+			}
+		}
+		return nil
+	}
+	target := find(document)
+	if target == nil {
+		t.Fatalf("block %s is missing from the document source", blockID)
+	}
+	properties, ok := target["Properties"].(map[string]any)
+	if !ok {
+		properties = map[string]any{}
+		target["Properties"] = properties
+	}
+	properties[key] = value
+	data, err := json.Marshal(document)
+	if err != nil {
+		t.Fatalf("encode external document source failed: %v", err)
+	}
+	filePath := filepath.Join(util.DataDir, boxID, documentPath)
+	if err := os.WriteFile(filePath, data, 0644); err != nil {
+		t.Fatalf("write external document source failed: %v", err)
+	}
+	cache.RemoveTreeDataInBox(documentID, boxID)
+	return data
+}
