+		candidates, err := mathConversionCollectBoundedTargets(mathConversionTestParagraph(1024, textChild))
+		if err != nil {
+			t.Fatalf("exact direct child budget was rejected: %v", err)
+		}
+		if len(candidates) != 0 {
+			t.Fatalf("text children produced %d formula candidates", len(candidates))
+		}
+	})
+
+	t.Run("direct-children-limit-plus-one", func(t *testing.T) {
+		candidates, err := mathConversionCollectBoundedTargets(mathConversionTestParagraph(1025, textChild))
+		requireMathConversionKind(t, err, MathConversionUnsupported)
+		if candidates != nil {
+			t.Fatalf("over-budget direct children returned partial candidates: %d", len(candidates))
+		}
+	})
+
+	t.Run("candidates-exact-limit", func(t *testing.T) {
+		candidates, err := mathConversionCollectBoundedTargets(mathConversionTestParagraph(32, inlineChild))
+		if err != nil {
+			t.Fatalf("exact candidate budget was rejected: %v", err)
+		}
+		if len(candidates) != 32 {
+			t.Fatalf("unexpected candidate count at the exact budget: %d", len(candidates))
+		}
+		for index, candidate := range candidates {
+			if candidate.node == nil || !slices.Equal(candidate.path, []int{index}) {
+				t.Fatalf("candidate %d has an unexpected path or node: %+v", index, candidate)
+			}
+		}
+	})
+
+	t.Run("candidates-limit-plus-one", func(t *testing.T) {
+		candidates, err := mathConversionCollectBoundedTargets(mathConversionTestParagraph(33, inlineChild))
+		requireMathConversionKind(t, err, MathConversionUnsupported)
+		if candidates != nil {
+			t.Fatalf("over-budget candidates returned partial targets: %d", len(candidates))
+		}
+	})
+
+	t.Run("candidate-indexes", func(t *testing.T) {
+		wanted := map[int]bool{5: true, 21: true, 37: true}
