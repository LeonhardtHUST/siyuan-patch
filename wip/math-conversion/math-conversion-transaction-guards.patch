+	block := mathConversionParagraph("20260718002901-abcdefg",
+		mathConversionText("see "),
+		&ast.Node{Type: ast.NodeTextMark, TextMarkType: "block-ref",
+			TextMarkBlockRefID: "20260718002900-abcdefg", TextMarkBlockRefSubtype: "d", TextMarkTextContent: "1"},
+	)
+	block.SetIALAttr("updated", "20260718002901")
+	block.SetIALAttr("refcount", "1")
+	block.SetIALAttr("style", "color: red")
+	block.SetIALAttr("custom-keep", "yes")
+	baseline := mathConversionFingerprint(block)
+	if baseline == "" {
+		t.Fatal("fingerprint is empty")
+	}
+	if mathConversionFingerprint(block) != baseline {
+		t.Fatal("fingerprint is not deterministic")
+	}
+
+	fingerprintWith := func(mutate func(*ast.Node)) string {
+		cloned := cloneBlockSwapNode(block)
+		mutate(cloned)
+		return mathConversionFingerprint(cloned)
+	}
+	if fingerprintWith(func(node *ast.Node) { node.SetIALAttr("updated", "20260718003000") }) == baseline {
+		t.Fatal("updated attribute is not part of the fingerprint")
+	}
+	if fingerprintWith(func(node *ast.Node) { node.SetIALAttr("refcount", "2") }) == baseline {
+		t.Fatal("refcount attribute is not part of the fingerprint")
+	}
+	if fingerprintWith(func(node *ast.Node) { node.LastChild.TextMarkTextContent = "2" }) == baseline {
+		t.Fatal("dynamic block reference text is not part of the fingerprint")
+	}
+	reordered := cloneBlockSwapNode(block)
+	slices.Reverse(reordered.KramdownIAL)
+	if got := mathConversionFingerprint(reordered); got != baseline {
+		t.Fatal("attribute order changed the fingerprint")
+	}
+}
