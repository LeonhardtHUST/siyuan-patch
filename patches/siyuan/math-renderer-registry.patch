+/**
+ * 数学公式渲染器注册表（Math Renderer Registry）
+ *
+ * 允许插件在 KaTeX 之前“认领”公式节点的渲染工作：
+ * - `canRender` 在 `mathRender` 的**同步过滤阶段**调用，此时 KaTeX 的 CSS/JS 都尚未加载；
+ * - 认领的节点会被置 `data-render="true"`，跳过 KaTeX 队列，零 KaTeX 开销；
+ * - `render` 为异步；返回 `false` 或抛错时，同一次调用内回退 KaTeX 兜底。
+ *
+ * 设计约束：
+ * - `canRender` 必须同步且廉价（滚动/输入时会被频繁调用）；
+ * - `render` 返回的 Promise 会并入 `mathRender` 的返回值——导出等 `await mathRender(...)`
+ *   的场景会等待渲染器完成（例如 PDF 导出等待 Typst 画完再打印）。
+ */
+
+export interface IMathRenderContext {
+    /** 目标节点：块级为 div[data-subtype="math"]，行内为 span[data-subtype="math"] */
+    element: HTMLElement;
+    /** 原始 data-content（未反转义；与 KaTeX 路径一致，由渲染器自行处理转义） */
+    mathContent: string;
+    /** 是否块级公式 */
+    isBlock: boolean;
+    /** 导出等场景要求渲染器自行完成宽度适配 */
+    maxWidth: boolean;
+    /**
+     * 行内公式的光标边界处理（思源原生行为：零宽字符/换行占位）。
+     * 渲染器在替换行内公式内容后应调用一次，保持与 KaTeX 渲染一致的光标行为。
+     */
+    applyInlineMathBoundaries: () => void;
+}
+
+export interface IMathRenderer {
+    /** 同步判定是否认领该节点 */
+    canRender: (context: IMathRenderContext) => boolean;
+    /** 异步渲染；返回 false 表示放弃并由 KaTeX 兜底 */
+    render: (context: IMathRenderContext) => Promise<boolean>;
+}
+
+const renderers: { id: string, renderer: IMathRenderer }[] = [];
+
+/** 注册渲染器；同一 id 重复注册会覆盖旧实现 */
+export const registerMathRenderer = (id: string, renderer: IMathRenderer) => {
+    const index = renderers.findIndex(item => item.id === id);
+    if (index > -1) {
+        renderers[index] = {id, renderer};
+    } else {
+        renderers.push({id, renderer});
+    }
+};
+
+/** 注销渲染器 */
+export const unregisterMathRenderer = (id: string) => {
+    const index = renderers.findIndex(item => item.id === id);
+    if (index > -1) {
+        renderers.splice(index, 1);
+    }
+};
+
+/** 按注册顺序寻找第一个认领该节点的渲染器 */
+export const findMathRenderer = (context: IMathRenderContext) => {
+    for (const item of renderers) {
+        try {
+            if (item.renderer.canRender(context)) {
+                return item.renderer;
+            }
+        } catch (error) {
+            console.warn(`Math renderer [${item.id}] canRender failed:`, error);
+        }
+    }
+    return undefined;
+};
