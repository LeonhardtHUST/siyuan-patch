+                wrapper.innerHTML = (inner as HTMLElement).shadowRoot!.innerHTML;
+                inner.replaceWith(wrapper);
+                baked++;
+            }
+        });
+        if (baked === 0) {
+            return html;
+        }
+        return container.innerHTML;
+    } catch (e) {
+        console.warn("[export] bake math failed:", e);
+        return html;
+    }
 };
