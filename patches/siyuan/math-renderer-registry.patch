+    const failedMathElements: HTMLElement[] = [];
+    const claimedPromise = Promise.all(claimedMathElements.map(item =>
+        Promise.resolve().then(() => item.renderer.render(item.context)).then((rendered) => {
+            if (rendered === false) {
