+test("a slow main script download stays within the page resource budget without a false timeout", () => {
+    const page = createPage();
+    try {
+        page.advance(67000);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        assert.equal(page.document.querySelector(".startup-error"), undefined);
+        page.advance(52999);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        assert.equal(page.document.querySelector(".startup-error"), undefined);
+    } finally { page.dispose(); }
+});
+
+test("a page load that never finishes still fails at the bounded page budget", () => {
+    const page = createPage();
+    try {
+        page.advance(119999);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        page.advance(1);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "failed");
+        const details = page.find(element => element.tagName === "PRE").textContent;
+        assert.match(details, /stage=page/);
+        assert.match(details, /Startup timed out/);
+        page.target.dispatchEvent(new CustomEvent("siyuan-startup-stage", {detail: "plugins"}));
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "failed");
+        assert.equal(page.timers.size, 0);
+    } finally { page.dispose(); }
+});
+
+test("DOM readiness narrows an unadvanced page stage to the business timeout after main execution errors", () => {
+    const page = createPage();
+    try {
+        page.advance(67000);
+        page.target.dispatchEvent(Object.assign(new Event("error"), {error: new SyntaxError("main script crash")}));
+        page.document.dispatchEvent(new Event("DOMContentLoaded"));
+        assert.equal(page.timers.size, 1);
+        page.advance(29999);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        page.advance(1);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "failed");
+        const details = page.find(element => element.tagName === "PRE").textContent;
+        assert.match(details, /stage=page/);
+        assert.match(details, /main script crash/);
+        assert.match(details, /Startup timed out/);
+    } finally { page.dispose(); }
+});
+
+test("business stages keep the 30-second deadline after a slow page load", () => {
+    const page = createPage();
+    try {
+        page.advance(67000);
+        setStartupStage("plugins");
+        assert.equal(page.timers.size, 1);
+        page.advance(29999);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        page.advance(1);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "failed");
+        assert.match(page.find(element => element.tagName === "PRE").textContent, /stage=plugins/);
+    } finally { page.dispose(); }
+});
+
+test("a custom business timeout keeps the page resource floor and the requested deadline", () => {
+    const page = createPage(5000);
+    try {
+        page.advance(5000);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        setStartupStage("plugins");
+        page.advance(4999);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "loading");
+        page.advance(1);
+        assert.equal(page.document.documentElement.attributes.get("data-startup-state"), "failed");
+        assert.match(page.find(element => element.tagName === "PRE").textContent, /stage=plugins/);
+    } finally { page.dispose(); }
+});
+
+test("startup completion and disposal clear both page and business deadlines", () => {
+    const ready = createPage();
+    try {
+        ready.advance(1000);
+        completeStartup();
+        assert.equal(ready.timers.size, 0);
+        ready.advance(200000);
+        assert.equal(ready.document.documentElement.attributes.get("data-startup-state"), "ready");
+        assert.equal(ready.document.querySelector(".startup-error"), undefined);
+    } finally { ready.dispose(); }
+    const disposed = createPage();
+    try {
+        disposed.startup.dispose();
+        assert.equal(disposed.timers.size, 0);
+        disposed.advance(200000);
+        assert.equal(disposed.document.documentElement.attributes.get("data-startup-state"), "loading");
+        assert.equal(disposed.document.querySelector(".startup-error"), undefined);
+    } finally { disposed.dispose(); }
+});
