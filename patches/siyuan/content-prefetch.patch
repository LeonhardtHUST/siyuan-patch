+    harness.fetchCalls[0].finish();
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.store.hasContentForeground(), true);
+    harness.fetchCalls[1].finish();
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.store.hasContentForeground(), false);
+});
+
+test("turning content prefetch off during a real load still releases its lease", async () => {
+    const harness = createScrollHarness({contentPrefetch: true});
+    assert.equal(harness.scroll.loadDynamic(harness.protyle, 2), true);
+    assert.equal(harness.store.hasContentForeground(), true);
+    harness.windowObject.siyuan.config.editor.contentPrefetch = false;
+    harness.fetchCalls[0].finish();
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.store.hasContentForeground(), false);
+});
+
+test("invalidating a dynamic load clears prefetched content even without an active request", () => {
+    const harness = createScrollHarness({contentPrefetch: true});
+    const key = {rootID: "document", anchorID: "last", mode: 2 as const, size: 128};
+    assert.equal(harness.store.store(harness.protyle, key, {code: 0} as IWebSocketData, Date.now(),
+        harness.store.getGeneration()), true);
+    harness.scroll.invalidateDynamicLoad(harness.protyle);
+    assert.equal(harness.invalidated.length, 1);
+    assert.equal(harness.store.has(harness.protyle, key), false);
+    assert.equal(harness.attributes.has("data-top"), false);
+});
+
+const createContentPrefetchHarness = () => {
+    const fetchCalls: Array<{input: any, init: any}> = [];
+    const images = [{getAttribute: (name: string): string | null => name === "src" ? "assets/photo.png" : null}];
+    const template = {content: {querySelectorAll: () => images}};
+    const windowObject: any = {
+        siyuan: {config: {editor: {contentPrefetch: true, dynamicLoadBlocks: 128}}},
+        requestIdleCallback: (callback: () => void) => callback(),
+        addEventListener: (): void => undefined,
+    };
+    const documentObject: any = {
+        hidden: false,
+        baseURI: "http://127.0.0.1:6806/stage/build/app/",
+        createElement: () => template,
+        addEventListener: (): void => undefined,
+    };
+    const fetchWithAppId = (input: any, init?: RequestInit) => {
+        fetchCalls.push({input, init});
+        if (input === "/api/filetree/getDoc") {
+            const body = JSON.parse(String(init?.body || "{}"));
+            return Promise.resolve({
+                ok: true,
+                headers: {get: () => "0"},
+                body: null,
+                text: () => Promise.resolve(JSON.stringify({code: 0, msg: "", data: {
+                    id: body.id, mode: body.mode, rootID: "document", content: "",
+                }})),
+            });
+        }
+        return new Promise((_resolve, reject) => {
+            init?.signal?.addEventListener("abort", () => reject(new Error("aborted")));
+        });
+    };
+    const globals: Record<string, any> = {
+        AbortController, TextDecoder, URL, console, setTimeout, clearTimeout,
+        window: windowObject,
+        document: documentObject,
+        location: {origin: "http://127.0.0.1:6806"},
+        navigator: {onLine: true},
+    };
+    const modules = new Map<string, any>();
+    const evaluate = (id: string, file: string, resolve: (name: string) => any) => {
+        const existing = modules.get(id);
+        if (existing) {
+            return existing;
+        }
+        const exportsObject: any = {};
+        modules.set(id, exportsObject);
+        runInNewContext(compiledSource(file), {
+            ...globals,
+            exports: exportsObject,
+            require: resolve,
+        });
+        return exportsObject;
+    };
+    const policy = evaluate("policy", "src/protyle/scroll/contentPrefetchPolicy.ts", (name: string) => {
+        throw new Error("unexpected policy require: " + name);
+    });
+    const store = evaluate("store", "src/protyle/scroll/contentPrefetchStore.ts", (name: string) => {
+        if (name === "./contentPrefetchPolicy") {
+            return policy;
+        }
+        throw new Error("unexpected store require: " + name);
+    });
+    const resources = evaluate("resources", "src/protyle/scroll/contentPrefetchResources.ts", (name: string) => {
+        if (name === "../../util/fetchWithAppId") {
+            return {fetchWithAppId};
+        }
+        if (name === "./contentPrefetchPolicy") {
+            return policy;
+        }
+        if (name === "./contentPrefetchStore") {
+            return store;
+        }
+        throw new Error("unexpected resources require: " + name);
+    });
+    const prefetch = evaluate("prefetch", "src/protyle/scroll/contentPrefetch.ts", (name: string) => {
+        if (name === "../../util/fetchWithAppId") {
+            return {fetchWithAppId};
+        }
+        if (name === "../util/transactionQueue") {
+            return {waitForPendingTransactions: () => Promise.resolve()};
+        }
+        if (name === "./contentPrefetchPolicy") {
+            return policy;
+        }
+        if (name === "./contentPrefetchResources") {
+            return resources;
+        }
+        if (name === "./contentPrefetchStore") {
+            return store;
+        }
+        throw new Error("unexpected prefetch require: " + name);
+    });
+    const editor = (rootID = "document") => ({
+        ws: {ws: {readyState: 1}},
+        element: {isConnected: true, getAttribute: (): null => null},
+        contentElement: {scrollTop: 1200, scrollHeight: 8000, clientHeight: 1000},
+        wysiwyg: {element: {
+            firstElementChild: {getAttribute: (name: string): string | null => name === "data-node-id" ? "first" : null},
+            lastElementChild: {getAttribute: (name: string): string | null => name === "data-node-id" ? "last" : null},
+            hasAttribute: (): boolean => false,
+        }},
+        block: {rootID, showAll: false},
+        notebookId: "box",
+    });
+    return {prefetch, resources, store: store.contentPrefetchStore, fetchCalls, editor};
+};
+
+test("foreground protection cancels in-flight image prefetch and suspends new speculation", async () => {
+    const harness = createContentPrefetchHarness();
+    const editorB = harness.editor();
+    harness.resources.prefetchContentImages("<img src=\"assets/photo.png\">");
+    assert.equal(harness.fetchCalls.length, 1);
+    const imageSignal = harness.fetchCalls[0].init.signal as AbortSignal;
+    const release = harness.store.beginContentForeground();
+    assert.equal(harness.store.hasContentForeground(), true);
+    assert.equal(imageSignal.aborted, true);
+    harness.resources.prefetchContentImages("<img src=\"assets/photo.png\">");
+    assert.equal(harness.fetchCalls.length, 1);
