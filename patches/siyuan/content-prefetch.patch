@@ -0,0 +1,153 @@
+import type {FileTreeGetDocRequestInput} from "../../types/api";
+
+export type TContentPrefetchMode = 1 | 2;
+
+export interface IContentPrefetchKey {
+    rootID: string;
+    anchorID: string;
+    mode: TContentPrefetchMode;
+    size: number;
+    notebook?: string;
+}
+
+export interface IContentPrefetchScrollMetrics {
+    scrollTop: number;
+    scrollHeight: number;
+    clientHeight: number;
+}
+
+export interface IContentPrefetchBoundaries {
+    before: boolean;
+    after: boolean;
+}
+
+export interface IContentPrefetchBoundaryElement {
+    firstElementChild: Element | null;
+    lastElementChild: Element | null;
+    hasAttribute: (name: string) => boolean;
+}
+
+export const CONTENT_PREFETCH_TTL = 30000;
+export const CONTENT_PREFETCH_MIN_INTERVAL = 800;
+export const CONTENT_PREFETCH_MAX_EDITORS = 8;
+export const CONTENT_PREFETCH_MAX_SIZE = 512;
+export const CONTENT_PREFETCH_MAX_BODY_BYTES = 2 * 1024 * 1024;
+export const CONTENT_PREFETCH_REQUEST_TIMEOUT = 8000;
+export const CONTENT_PREFETCH_TOP_FACTOR = 1.8;
+export const CONTENT_PREFETCH_BOTTOM_FACTOR = 3;
+export const CONTENT_PREFETCH_TRIGGER_TOP_FACTOR = 1;
+export const CONTENT_PREFETCH_TRIGGER_BOTTOM_FACTOR = 0.8;
+
+const ASSET_IMAGE_EXTENSIONS = [".png", ".jpg", ".jpeg", ".gif", ".webp", ".avif", ".bmp", ".svg"];
+
+export const isContentPrefetchSettingEnabled = () => {
+    if (typeof window === "undefined" || !window.siyuan?.config?.editor) {
+        return false;
+    }
+    const editor = window.siyuan.config.editor as Config.IEditor & { contentPrefetch?: boolean };
+    return editor.contentPrefetch === true;
+};
+
+export const isContentPrefetchNetworkRestricted = () => {
+    if (typeof navigator === "undefined") {
+        return false;
+    }
+    if (navigator.onLine === false) {
+        return true;
+    }
+    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
+    return connection?.saveData === true;
+};
+
+export const isContentPrefetchConnectionHealthy = (protyle: IProtyle) => {
+    const readyState = protyle.ws?.ws?.readyState;
+    if (readyState === undefined) {
+        return false;
+    }
+    const openState = (globalThis as { WebSocket?: { OPEN?: number } }).WebSocket?.OPEN ?? 1;
+    return readyState === openState;
+};
+
+export const withContentPrefetchPriority = (init: RequestInit) => {
+    const requestInit: RequestInit & { priority?: string } = {...init};
+    requestInit.priority = "low";
+    return requestInit;
+};
+
+export const getContentPrefetchBoundaries = (element: IContentPrefetchBoundaryElement): IContentPrefetchBoundaries => {
+    const firstElement = element.firstElementChild;
+    const lastElement = element.lastElementChild;
+    return {
+        before: firstElement?.getAttribute("data-eof") === "1" ||
+            firstElement?.getAttribute("data-node-index") === "0",
+        after: element.hasAttribute("data-bottom-eof") || lastElement?.getAttribute("data-eof") === "2",
+    };
+};
+
+export const getContentPrefetchDirection = (metrics: IContentPrefetchScrollMetrics,
+                                            boundaries: IContentPrefetchBoundaries): TContentPrefetchMode | undefined => {
+    const {scrollTop, scrollHeight, clientHeight} = metrics;
+    if (!(clientHeight > 0) || !(scrollHeight > clientHeight)) {
+        return undefined;
+    }
+    const remaining = scrollHeight - clientHeight - scrollTop;
+    const candidates: Array<{ mode: TContentPrefetchMode, distance: number }> = [];
+    if (!boundaries.before &&
+        scrollTop >= clientHeight * CONTENT_PREFETCH_TRIGGER_TOP_FACTOR &&
+        scrollTop <= clientHeight * CONTENT_PREFETCH_TOP_FACTOR) {
+        candidates.push({mode: 1, distance: scrollTop});
+    }
+    if (!boundaries.after &&
+        remaining > clientHeight * CONTENT_PREFETCH_TRIGGER_BOTTOM_FACTOR &&
+        remaining <= clientHeight * CONTENT_PREFETCH_BOTTOM_FACTOR) {
+        candidates.push({mode: 2, distance: remaining});
+    }
+    candidates.sort((first, second) => first.distance - second.distance);
+    return candidates[0]?.mode;
+};
+
+export const getContentPrefetchKeySignature = (key: IContentPrefetchKey) => [
+    key.rootID,
+    key.notebook || "",
+    key.anchorID,
+    key.mode.toString(),
+    key.size.toString(),
+].join("\u0000");
+
+export const buildContentPrefetchKey = (
+    param: Pick<FileTreeGetDocRequestInput, "id" | "mode" | "size" | "notebook">,
+    rootID?: string,
+): IContentPrefetchKey | undefined => {
+    if (!rootID || !param.id || (param.mode !== 1 && param.mode !== 2) || !param.size) {
+        return undefined;
+    }
+    return {
+        rootID,
+        anchorID: param.id,
+        mode: param.mode,
+        size: param.size,
+        notebook: param.notebook || undefined,
+    };
+};
+
+export const normalizeContentPrefetchAssetURL = (source: string, baseURI: string, origin: string) => {
+    const value = source.trim();
+    if (!value || /^(?:data|blob|javascript):/i.test(value)) {
+        return undefined;
+    }
+    try {
+        const normalizedSource = value.startsWith("assets/") ? origin + "/" + value : value;
+        const url = new URL(normalizedSource, baseURI);
+        if ((url.protocol !== "http:" && url.protocol !== "https:") || url.origin !== origin ||
+            !url.pathname.startsWith("/assets/") || url.searchParams.has("box")) {
+            return undefined;
+        }
+        const dotIndex = url.pathname.lastIndexOf(".");
+        if (dotIndex < 0 || !ASSET_IMAGE_EXTENSIONS.includes(url.pathname.slice(dotIndex).toLowerCase())) {
+            return undefined;
+        }
+        return url.href;
+    } catch {
+        return undefined;
+    }
+};
