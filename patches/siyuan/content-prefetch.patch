+import {fetchWithAppId} from "../../util/fetchWithAppId";
+import {
+    CONTENT_PREFETCH_REQUEST_TIMEOUT,
+    isContentPrefetchNetworkRestricted,
+    isContentPrefetchSettingEnabled,
+    normalizeContentPrefetchAssetURL,
+    withContentPrefetchPriority,
+} from "./contentPrefetchPolicy";
+import {contentPrefetchStore} from "./contentPrefetchStore";
+
+const MAX_IMAGES_PER_SEGMENT = 8;
+const MAX_IMAGE_QUEUE = 16;
+const MAX_IMAGE_BYTES = 8 * 1024 * 1024;
+const MAX_IMAGE_HISTORY = 128;
+const IMAGE_IDLE_TIMEOUT = 2000;
+const IMAGE_DEFER_DELAY = 1200;
+
+const imageQueue: string[] = [];
+const prefetchedImages = new Set<string>();
+let imageFetching = false;
+let imageGeneration = 0;
+let imageAbortController: AbortController | undefined;
+let lifecycleBound = false;
+
+const readImageBody = async (response: Response) => {
+    const contentLength = Number(response.headers.get("content-length") || "0");
+    if (contentLength > MAX_IMAGE_BYTES) {
+        await response.body?.cancel().catch((): undefined => undefined);
+        return;
+    }
+    const body = response.body;
+    if (!body) {
+        return;
+    }
+    const reader = body.getReader();
+    let received = 0;
+    try {
+        for (; ;) {
+            const chunk = await reader.read();
+            if (chunk.done) {
+                return;
+            }
+            received += chunk.value?.byteLength || 0;
+            if (received > MAX_IMAGE_BYTES) {
+                await reader.cancel();
+                return;
+            }
+        }
+    } finally {
+        reader.releaseLock();
+    }
+};
+
+const scheduleImagePump = (delay = 0) => {
+    if (delay > 0) {
+        setTimeout(() => void pumpImages(), delay);
+        return;
+    }
+    if (typeof window !== "undefined" && typeof window.requestIdleCallback === "function") {
+        window.requestIdleCallback(() => void pumpImages(), {timeout: IMAGE_IDLE_TIMEOUT});
+        return;
+    }
+    setTimeout(() => void pumpImages(), 200);
+};
+
+const pumpImages = async () => {
+    if (imageFetching || contentPrefetchStore.hasContentForeground()) {
+        return;
+    }
+    imageFetching = true;
+    const currentGeneration = imageGeneration;
+    try {
+        while (imageQueue.length && currentGeneration === imageGeneration &&
+        !contentPrefetchStore.hasContentForeground() && isContentPrefetchSettingEnabled()) {
+            if (document.hidden || isContentPrefetchNetworkRestricted()) {
+                imageQueue.length = 0;
+                return;
+            }
+            if (contentPrefetchStore.hasActiveAttempt()) {
+                scheduleImagePump(IMAGE_DEFER_DELAY);
+                return;
+            }
+            const url = imageQueue.shift();
+            imageAbortController = new AbortController();
+            const timeout = setTimeout(() => imageAbortController?.abort(), CONTENT_PREFETCH_REQUEST_TIMEOUT);
+            try {
+                const response = await fetchWithAppId(url, withContentPrefetchPriority({
+                    cache: "default",
+                    credentials: "same-origin",
+                    redirect: "error",
+                    signal: imageAbortController.signal,
+                }));
+                if (response.ok) {
+                    await readImageBody(response);
+                }
+            } catch {
+                continue;
+            } finally {
+                clearTimeout(timeout);
+                imageAbortController = undefined;
+            }
+        }
+    } finally {
+        imageFetching = false;
+    }
+};
+
+const bindContentImageLifecycle = () => {
+    if (lifecycleBound || typeof document === "undefined") {
+        return;
+    }
+    lifecycleBound = true;
+    document.addEventListener("visibilitychange", () => {
+        if (document.hidden) {
+            cancelContentImagePrefetch();
+        }
+    });
+    window.addEventListener("offline", () => cancelContentImagePrefetch());
+    window.addEventListener("pagehide", () => cancelContentImagePrefetch());
+};
+
+export const cancelContentImagePrefetch = () => {
+    imageGeneration++;
+    imageQueue.length = 0;
+    imageAbortController?.abort();
+    imageAbortController = undefined;
+};
+
+export const prefetchContentImages = (content: string) => {
+    if (!content || typeof document === "undefined" || !isContentPrefetchSettingEnabled() ||
+        isContentPrefetchNetworkRestricted() || document.hidden || contentPrefetchStore.hasContentForeground()) {
+        return;
+    }
+    bindContentImageLifecycle();
+    const template = document.createElement("template");
+    template.innerHTML = content;
+    const urls: string[] = [];
+    template.content.querySelectorAll("img").forEach(image => {
+        const source = image.getAttribute("data-src") || image.getAttribute("src");
+        if (!source) {
+            return;
+        }
+        const url = normalizeContentPrefetchAssetURL(source, document.baseURI, location.origin);
+        if (!url || prefetchedImages.has(url) || urls.includes(url)) {
+            return;
+        }
+        urls.push(url);
+    });
+    if (!urls.length) {
+        return;
+    }
+    if (prefetchedImages.size > MAX_IMAGE_HISTORY) {
+        prefetchedImages.clear();
+    }
+    urls.slice(0, MAX_IMAGES_PER_SEGMENT).forEach(url => {
+        if (imageQueue.length >= MAX_IMAGE_QUEUE) {
+            return;
+        }
+        prefetchedImages.add(url);
+        imageQueue.push(url);
+    });
+    scheduleImagePump();
+};
