+    harness.prefetch.scheduleContentPrefetch(editorB, {size: 128});
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.fetchCalls.length, 2);
+    assert.equal(harness.fetchCalls[1].input, "/api/filetree/getDoc");
+    assert.equal(JSON.parse(String(harness.fetchCalls[1].init.body)).mode, 1);
