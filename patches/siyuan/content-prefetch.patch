+++ b/app/src/protyle/scroll/contentPrefetch.ts
@@ -0,0 +1,252 @@
+import type {FileTreeGetDocRequestInput} from "../../types/api";
+import {fetchWithAppId} from "../../util/fetchWithAppId";
+import {waitForPendingTransactions} from "../util/transactionQueue";
+import {
+    buildContentPrefetchKey,
+    CONTENT_PREFETCH_MAX_BODY_BYTES,
+    CONTENT_PREFETCH_MAX_SIZE,
+    CONTENT_PREFETCH_REQUEST_TIMEOUT,
+    getContentPrefetchBoundaries,
+    getContentPrefetchDirection,
+    isContentPrefetchConnectionHealthy,
+    isContentPrefetchNetworkRestricted,
+    isContentPrefetchSettingEnabled,
+    withContentPrefetchPriority,
+    type IContentPrefetchKey,
+    type TContentPrefetchMode,
+} from "./contentPrefetchPolicy";
+import {cancelContentImagePrefetch, prefetchContentImages} from "./contentPrefetchResources";
+import {
+    contentPrefetchStore,
+    invalidateContentPrefetch,
+    registerContentPrefetchCancelHook,
+} from "./contentPrefetchStore";
+
+export interface IContentPrefetchOptions {
+    encrypted?: boolean;
+    notebook?: string;
+    size?: number;
+}
+
+registerContentPrefetchCancelHook(cancelContentImagePrefetch);
+
+let lifecycleBound = false;
+
+const bindContentPrefetchLifecycle = () => {
+    if (lifecycleBound) {
+        return;
+    }
+    lifecycleBound = true;
+    if (typeof document !== "undefined") {
+        document.addEventListener("visibilitychange", () => {
+            if (document.hidden) {
+                invalidateContentPrefetch();
+            }
+        });
+    }
+    if (typeof window !== "undefined") {
+        window.addEventListener("offline", () => invalidateContentPrefetch());
+    }
+};
+
+const cancelResponseBody = async (response: Response, controller: AbortController) => {
+    if (response.body) {
+        await response.body.cancel().catch((): undefined => undefined);
+        return;
+    }
+    controller.abort();
+};
+
+const readBoundedText = async (response: Response, maxBytes: number, controller: AbortController) => {
+    const contentLength = Number(response.headers.get("content-length") || "0");
+    if (contentLength > maxBytes) {
+        await cancelResponseBody(response, controller);
+        return undefined;
+    }
+    const body = response.body;
+    if (!body) {
+        const text = await response.text();
+        if (text.length > maxBytes) {
+            controller.abort();
+            return undefined;
+        }
+        return text;
+    }
+    const reader = body.getReader();
+    const decoder = new TextDecoder();
+    let received = 0;
+    let text = "";
+    try {
+        for (; ;) {
+            const chunk = await reader.read();
+            if (chunk.done) {
+                break;
+            }
+            received += chunk.value?.byteLength || 0;
+            if (received > maxBytes) {
+                await reader.cancel();
+                return undefined;
+            }
+            text += decoder.decode(chunk.value, {stream: true});
+        }
+        text += decoder.decode();
+        return text;
+    } finally {
+        reader.releaseLock();
+    }
+};
+
+const getAnchorID = (protyle: IProtyle, mode: TContentPrefetchMode) => {
+    const element = mode === 1 ? protyle.wysiwyg?.element.firstElementChild :
+        protyle.wysiwyg?.element.lastElementChild;
+    return element?.getAttribute("data-node-id") || undefined;
+};
+
+const canPrefetch = (protyle: IProtyle) => {
+    if (typeof document !== "undefined" && document.hidden) {
+        return false;
+    }
+    if (!isContentPrefetchConnectionHealthy(protyle)) {
+        return false;
+    }
+    if (!protyle.element?.isConnected || !protyle.contentElement || !protyle.wysiwyg?.element) {
+        return false;
+    }
+    if (!protyle.block?.rootID || protyle.block.showAll) {
+        return false;
+    }
+    if (protyle.element.getAttribute("disabled-forever") === "true") {
+        return false;
+    }
+    return !protyle.wysiwyg.element.hasAttribute("data-top");
+};
+
+const isContentPrefetchConsumable = (protyle: IProtyle) => {
+    if (!isContentPrefetchSettingEnabled()) {
+        return false;
+    }
+    if (!isContentPrefetchConnectionHealthy(protyle)) {
+        contentPrefetchStore.clear(protyle);
+        return false;
+    }
+    return true;
+};
+
+const requestDynamicResponse = async (protyle: IProtyle, key: IContentPrefetchKey,
+                                      controller: AbortController, generation: number, token: number,
+                                      notebookID: string) => {
+    const timeout = setTimeout(() => controller.abort(), CONTENT_PREFETCH_REQUEST_TIMEOUT);
+    try {
+        await waitForPendingTransactions(protyle);
+        if (controller.signal.aborted || contentPrefetchStore.getGeneration() !== generation ||
+            !isContentPrefetchSettingEnabled() || isContentPrefetchNetworkRestricted() ||
+            !canPrefetch(protyle) ||
+            protyle.block.rootID !== key.rootID || protyle.notebookId !== notebookID ||
+            getAnchorID(protyle, key.mode) !== key.anchorID) {
+            return;
+        }
+        const param: FileTreeGetDocRequestInput = {id: key.anchorID, mode: key.mode, size: key.size};
+        if (key.notebook) {
+            param.notebook = key.notebook;
+        }
+        const response = await fetchWithAppId("/api/filetree/getDoc", withContentPrefetchPriority({
+            method: "POST",
+            body: JSON.stringify(param),
+            credentials: "same-origin",
+            redirect: "error",
+            signal: controller.signal,
+        }));
+        if (!response.ok || controller.signal.aborted) {
+            return;
+        }
+        const text = await readBoundedText(response, CONTENT_PREFETCH_MAX_BODY_BYTES, controller);
+        if (!text || controller.signal.aborted) {
+            return;
+        }
+        const data = JSON.parse(text) as IWebSocketData;
+        if (controller.signal.aborted || !data || data.code !== 0 || !data.data ||
+            data.data.isSyncing || data.data.publishAccessRequired ||
+            data.data.rootID !== key.rootID || data.data.id !== key.anchorID || data.data.mode !== key.mode ||
+            typeof data.data.content !== "string" ||
+            contentPrefetchStore.getGeneration() !== generation ||
+            !isContentPrefetchSettingEnabled() || !protyle.element?.isConnected ||
+            protyle.block.rootID !== key.rootID || protyle.notebookId !== notebookID ||
+            getAnchorID(protyle, key.mode) !== key.anchorID) {
+            return;
+        }
+        if (!contentPrefetchStore.store(protyle, key, data, Date.now(), generation)) {
+            return;
+        }
+        prefetchContentImages(data.data.content);
+    } catch {
+        return;
+    } finally {
+        clearTimeout(timeout);
+        contentPrefetchStore.finishAttempt(protyle, token);
+    }
+};
+
+export const scheduleContentPrefetch = (protyle: IProtyle, options: IContentPrefetchOptions = {}) => {
+    bindContentPrefetchLifecycle();
+    if (options.encrypted || !isContentPrefetchSettingEnabled() || isContentPrefetchNetworkRestricted() ||
+        !canPrefetch(protyle) || contentPrefetchStore.hasContentForeground()) {
+        return;
+    }
+    const element = protyle.contentElement;
+    const metrics = {
+        scrollTop: element.scrollTop,
+        scrollHeight: element.scrollHeight,
+        clientHeight: element.clientHeight,
+    };
+    const mode = getContentPrefetchDirection(metrics, getContentPrefetchBoundaries(protyle.wysiwyg.element));
+    if (!mode) {
+        return;
+    }
+    const anchorID = getAnchorID(protyle, mode);
+    const size = options.size || window.siyuan.config.editor.dynamicLoadBlocks;
+    if (size > CONTENT_PREFETCH_MAX_SIZE) {
+        return;
+    }
+    const key = buildContentPrefetchKey({
+        id: anchorID,
+        mode,
+        size,
+        notebook: options.notebook,
+    }, protyle.block.rootID);
+    if (!key) {
+        return;
+    }
+    const now = Date.now();
+    if (contentPrefetchStore.has(protyle, key, now)) {
+        return;
+    }
+    const controller = new AbortController();
+    const generation = contentPrefetchStore.getGeneration();
+    const token = contentPrefetchStore.beginAttempt(protyle, controller, now);
+    if (!token) {
+        return;
+    }
+    const notebookID = protyle.notebookId;
+    void requestDynamicResponse(protyle, key, controller, generation, token, notebookID);
+};
+
+export const hasPrefetchedDynamicResponse = (protyle: IProtyle, param: FileTreeGetDocRequestInput,
+                                             rootID?: string) => {
+    if (!isContentPrefetchConsumable(protyle)) {
+        return false;
+    }
+    const key = buildContentPrefetchKey(param, rootID);
+    return !!key && contentPrefetchStore.has(protyle, key, Date.now());
+};
+
+export const consumePrefetchedDynamicResponse = (protyle: IProtyle, param: FileTreeGetDocRequestInput,
+                                                 rootID?: string) => {
+    if (!isContentPrefetchConsumable(protyle)) {
+        return undefined;
+    }
+    const key = buildContentPrefetchKey(param, rootID);
+    if (!key) {
+        return undefined;
+    }
+    return contentPrefetchStore.take(protyle, key, Date.now());
+};
