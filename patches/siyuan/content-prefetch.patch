+import {
+    CONTENT_PREFETCH_MAX_EDITORS,
+    CONTENT_PREFETCH_MIN_INTERVAL,
+    CONTENT_PREFETCH_TTL,
+    getContentPrefetchKeySignature,
+    type IContentPrefetchKey,
+    type TContentPrefetchMode,
+} from "./contentPrefetchPolicy";
+
+interface IContentPrefetchEntry {
+    key: IContentPrefetchKey;
+    signature: string;
+    response: IWebSocketData;
+    generation: number;
+    time: number;
+}
+
+interface IContentPrefetchAttempt {
+    token: number;
+    controller: AbortController;
+}
+
+interface IContentPrefetchEditorState {
+    before?: IContentPrefetchEntry;
+    after?: IContentPrefetchEntry;
+    attempt?: IContentPrefetchAttempt;
+    lastAttempt: number;
+    usedAt: number;
+}
+
+const isExpired = (entry: IContentPrefetchEntry, now: number) => now - entry.time > CONTENT_PREFETCH_TTL;
+
+export class ContentPrefetchStore {
+    private editors = new Map<IProtyle, IContentPrefetchEditorState>();
+    private foregroundTokens = new Set<object>();
+    private generation = 0;
+    private token = 0;
+
+    public getGeneration() {
+        return this.generation;
+    }
+
+    public has(protyle: IProtyle, key: IContentPrefetchKey, now = Date.now()) {
+        const state = this.editors.get(protyle);
+        return !!state && !!this.takeEntry(state, key, now);
+    }
+
+    public take(protyle: IProtyle, key: IContentPrefetchKey, now = Date.now()) {
+        const state = this.editors.get(protyle);
+        if (!state) {
+            return undefined;
+        }
+        const entry = this.takeEntry(state, key, now);
+        if (!entry) {
+            return undefined;
+        }
+        this.clearEntry(state, key.mode);
+        return entry.response;
+    }
+
+    public store(protyle: IProtyle, key: IContentPrefetchKey, response: IWebSocketData,
+                 now: number, generation: number) {
+        if (generation !== this.generation) {
+            return false;
+        }
+        const state = this.getState(protyle, now);
+        const entry: IContentPrefetchEntry = {
+            key,
+            signature: getContentPrefetchKeySignature(key),
+            response,
+            generation,
+            time: now,
+        };
+        if (key.mode === 1) {
+            state.before = entry;
+        } else {
+            state.after = entry;
+        }
+        state.usedAt = now;
+        this.prune(now);
+        return true;
+    }
+
+    public canAttempt(protyle: IProtyle, now = Date.now()) {
+        if (this.hasContentForeground() || this.activeAttemptCount() >= 1) {
+            return false;
+        }
+        const state = this.editors.get(protyle);
+        if (state?.attempt) {
+            return false;
+        }
+        return !state || now - state.lastAttempt >= CONTENT_PREFETCH_MIN_INTERVAL;
+    }
+
+    public beginAttempt(protyle: IProtyle, controller: AbortController, now = Date.now()) {
+        if (!this.canAttempt(protyle, now)) {
+            return undefined;
+        }
+        const state = this.getState(protyle, now);
+        const token = ++this.token;
+        state.attempt = {token, controller};
+        state.lastAttempt = now;
+        state.usedAt = now;
+        return token;
+    }
+
+    public finishAttempt(protyle: IProtyle, token: number) {
+        const state = this.editors.get(protyle);
+        if (!state?.attempt || state.attempt.token !== token) {
+            return;
+        }
+        state.attempt = undefined;
+    }
+
+    public abortAttempt(protyle: IProtyle) {
+        const state = this.editors.get(protyle);
+        const attempt = state?.attempt;
+        if (!state || !attempt) {
+            return;
+        }
+        state.attempt = undefined;
+        attempt.controller.abort();
+    }
+
+    public abortAllAttempts() {
+        this.editors.forEach(state => {
+            const attempt = state.attempt;
+            if (!attempt) {
+                return;
+            }
+            state.attempt = undefined;
+            attempt.controller.abort();
+        });
+    }
+
+    public beginContentForeground() {
+        const token = {};
+        this.foregroundTokens.add(token);
+        this.abortAllAttempts();
+        contentPrefetchCancelHooks.forEach(hook => {
+            hook();
+        });
+        return () => {
+            this.foregroundTokens.delete(token);
+        };
+    }
+
+    public hasContentForeground() {
+        return this.foregroundTokens.size > 0;
+    }
+
+    public hasActiveAttempt() {
+        return this.activeAttemptCount() > 0;
+    }
+
+    public clear(protyle: IProtyle) {
+        this.abortAttempt(protyle);
+        this.editors.delete(protyle);
+        this.generation++;
+    }
+
+    public clearAll() {
+        this.editors.forEach(state => state.attempt?.controller.abort());
+        this.editors.clear();
+        this.generation++;
+    }
+
+    private activeAttemptCount() {
+        let count = 0;
+        this.editors.forEach(state => {
+            if (state.attempt) {
+                count++;
+            }
+        });
+        return count;
+    }
+
+    private getState(protyle: IProtyle, now: number) {
+        const current = this.editors.get(protyle);
+        if (current) {
+            current.usedAt = now;
+            return current;
+        }
+        if (this.editors.size >= CONTENT_PREFETCH_MAX_EDITORS) {
+            let oldest: IProtyle | undefined;
+            let oldestUsedAt = Number.MAX_SAFE_INTEGER;
+            this.editors.forEach((state, editor) => {
+                if (state.attempt || state.usedAt >= oldestUsedAt) {
+                    return;
+                }
+                oldest = editor;
+                oldestUsedAt = state.usedAt;
+            });
+            if (oldest) {
+                this.editors.delete(oldest);
+            }
+        }
+        const state: IContentPrefetchEditorState = {lastAttempt: 0, usedAt: now};
+        this.editors.set(protyle, state);
+        return state;
+    }
+
+    private takeEntry(state: IContentPrefetchEditorState, key: IContentPrefetchKey, now: number) {
+        const entry = key.mode === 1 ? state.before : state.after;
+        if (!entry) {
+            return undefined;
+        }
+        if (entry.signature !== getContentPrefetchKeySignature(key)) {
+            return undefined;
+        }
+        if (entry.generation !== this.generation || isExpired(entry, now)) {
+            this.clearEntry(state, key.mode);
+            return undefined;
+        }
+        state.usedAt = now;
+        return entry;
+    }
+
+    private clearEntry(state: IContentPrefetchEditorState, mode: TContentPrefetchMode) {
+        if (mode === 1) {
+            state.before = undefined;
+        } else {
+            state.after = undefined;
+        }
+    }
+
+    private prune(now: number) {
+        this.editors.forEach((state, protyle) => {
+            if (state.before && (state.before.generation !== this.generation || isExpired(state.before, now))) {
+                state.before = undefined;
+            }
+            if (state.after && (state.after.generation !== this.generation || isExpired(state.after, now))) {
+                state.after = undefined;
+            }
+            if (!state.before && !state.after && !state.attempt && now - state.usedAt > CONTENT_PREFETCH_TTL) {
+                this.editors.delete(protyle);
+            }
+        });
+    }
+}
+
+const contentPrefetchCancelHooks = new Set<() => void>();
+
+export const registerContentPrefetchCancelHook = (hook: () => void) => {
+    contentPrefetchCancelHooks.add(hook);
+};
+
+export const contentPrefetchStore = new ContentPrefetchStore();
+
+export const invalidateContentPrefetchFor = (protyle: IProtyle, cancelImages = false) => {
+    contentPrefetchStore.clear(protyle);
+    if (cancelImages) {
+        contentPrefetchCancelHooks.forEach(hook => {
+            hook();
+        });
+    }
+};
+
+export const invalidateContentPrefetch = () => {
+    contentPrefetchStore.clearAll();
+    contentPrefetchCancelHooks.forEach(hook => {
+        hook();
+    });
+};
