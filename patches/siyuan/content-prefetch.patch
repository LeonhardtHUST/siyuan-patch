+import * as assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import {test} from "node:test";
+import {runInNewContext} from "node:vm";
+import {ModuleKind, ScriptTarget, transpileModule} from "typescript";
+import {DynamicLoadState} from "./dynamicLoadState";
+import {
+    buildContentPrefetchKey,
+    CONTENT_PREFETCH_MAX_SIZE,
+    CONTENT_PREFETCH_TTL,
+    getContentPrefetchBoundaries,
+    getContentPrefetchDirection,
+    isContentPrefetchConnectionHealthy,
+    normalizeContentPrefetchAssetURL,
+    type IContentPrefetchKey,
+} from "./contentPrefetchPolicy";
+import {
+    ContentPrefetchStore,
+    invalidateContentPrefetch,
+    invalidateContentPrefetchFor,
+    registerContentPrefetchCancelHook,
+} from "./contentPrefetchStore";
+
+const editor = () => Object.create(null) as IProtyle;
+
+const socketData = (data: unknown = null): IWebSocketData => ({code: 0, msg: "", data} as IWebSocketData);
+
+const key = (mode: 1 | 2, anchorID = "block", size = 128): IContentPrefetchKey => ({
+    rootID: "document",
+    anchorID,
+    mode,
+    size,
+});
+
+test("content prefetch stays ahead of the real load thresholds", () => {
+    const boundaries = {before: false, after: false};
+    assert.equal(getContentPrefetchDirection({scrollTop: 2500, scrollHeight: 6000, clientHeight: 1000}, boundaries), 2);
+    assert.equal(getContentPrefetchDirection({scrollTop: 4200, scrollHeight: 6000, clientHeight: 1000}, boundaries),
+        undefined);
+    assert.equal(getContentPrefetchDirection({scrollTop: 4190, scrollHeight: 6000, clientHeight: 1000}, boundaries),
+        2);
+    assert.equal(getContentPrefetchDirection({scrollTop: 5000, scrollHeight: 6000, clientHeight: 1000}, boundaries),
+        undefined);
+    assert.equal(getContentPrefetchDirection({scrollTop: 1200, scrollHeight: 8000, clientHeight: 1000}, boundaries), 1);
+    assert.equal(getContentPrefetchDirection({scrollTop: 800, scrollHeight: 8000, clientHeight: 1000}, boundaries),
+        undefined);
+    assert.equal(getContentPrefetchDirection({scrollTop: 2500, scrollHeight: 6000, clientHeight: 1000},
+        {before: false, after: true}), undefined);
+    assert.equal(getContentPrefetchDirection({scrollTop: 1200, scrollHeight: 8000, clientHeight: 1000},
+        {before: true, after: false}), undefined);
+    assert.equal(getContentPrefetchDirection({scrollTop: 0, scrollHeight: 1000, clientHeight: 1000}, boundaries),
+        undefined);
+});
+
+test("content prefetch reads document boundaries from rendered elements", () => {
+    const loaded = getContentPrefetchBoundaries({
+        firstElementChild: {getAttribute: (name: string): string | null => name === "data-eof" ? "1" : null} as unknown as Element,
+        lastElementChild: {getAttribute: (name: string): string | null => name === "data-eof" ? "2" : null} as unknown as Element,
+        hasAttribute: (): boolean => false,
+    });
+    assert.deepEqual(loaded, {before: true, after: true});
+    const unloaded = getContentPrefetchBoundaries({
+        firstElementChild: {getAttribute: (name: string): string | null => name === "data-node-index" ? "12" : null} as unknown as Element,
+        lastElementChild: {getAttribute: (): null => null} as unknown as Element,
+        hasAttribute: (name: string): boolean => name === "data-bottom-eof",
+    });
+    assert.deepEqual(unloaded, {before: false, after: true});
+});
+
+test("content prefetch keys include size, mode and notebook", () => {
+    assert.deepEqual(buildContentPrefetchKey({id: "anchor", mode: 2, size: 128}, "document"), {
+        rootID: "document", anchorID: "anchor", mode: 2, size: 128, notebook: undefined,
+    });
+    assert.equal(buildContentPrefetchKey({id: "anchor", mode: 2, size: 128, notebook: "box"}, "document")
+        .notebook, "box");
+    assert.equal(buildContentPrefetchKey({id: "anchor", mode: 2}, "document"), undefined);
+    assert.equal(buildContentPrefetchKey({id: "anchor", mode: 0, size: 128}, "document"), undefined);
+    assert.equal(buildContentPrefetchKey({id: "anchor", mode: 2, size: 128}, undefined), undefined);
+    assert.ok(CONTENT_PREFETCH_MAX_SIZE > 0);
+});
+
+test("content prefetch only accepts same origin asset images with the exact query", () => {
+    const origin = "http://127.0.0.1:6806";
+    const base = origin + "/stage/build/app/";
+    assert.equal(normalizeContentPrefetchAssetURL("assets/photo.png", base, origin), origin + "/assets/photo.png");
+    assert.equal(normalizeContentPrefetchAssetURL("/assets/photo.png?v=2", base, origin),
+        origin + "/assets/photo.png?v=2");
+    assert.equal(normalizeContentPrefetchAssetURL("assets/photo.png?box=encrypted", base, origin), undefined);
+    assert.equal(normalizeContentPrefetchAssetURL("https://example.com/assets/photo.png", base, origin), undefined);
+    assert.equal(normalizeContentPrefetchAssetURL("/stage/protyle/js/lute/lute.min.js", base, origin), undefined);
+    assert.equal(normalizeContentPrefetchAssetURL("assets/clip.mp4", base, origin), undefined);
+    assert.equal(normalizeContentPrefetchAssetURL("data:image/png;base64,AAAA", base, origin), undefined);
+    assert.equal(normalizeContentPrefetchAssetURL("javascript:alert(1)", base, origin), undefined);
+});
+
+test("content prefetch requires an open editor websocket", () => {
+    assert.equal(isContentPrefetchConnectionHealthy({ws: {ws: {readyState: 1}}} as unknown as IProtyle), true);
+    assert.equal(isContentPrefetchConnectionHealthy({ws: {ws: {readyState: 0}}} as unknown as IProtyle), false);
+    assert.equal(isContentPrefetchConnectionHealthy({} as unknown as IProtyle), false);
+});
+
+test("content prefetch store keeps one segment per direction and consumes hits", () => {
+    const store = new ContentPrefetchStore();
+    const protyle = editor();
+    const now = Date.now();
+    assert.equal(store.store(protyle, key(1), socketData(), now, store.getGeneration()), true);
+    assert.equal(store.store(protyle, key(2), socketData(), now, store.getGeneration()), true);
+    assert.equal(store.store(protyle, key(2, "other"), socketData(), now, store.getGeneration()), true);
+    assert.equal(store.has(protyle, key(1), now), true);
+    assert.equal(store.has(protyle, key(2, "other"), now), true);
+    assert.equal(store.has(protyle, key(2), now), false);
+    assert.equal(store.has(protyle, key(2, "other"), now), true);
+    assert.equal(store.take(protyle, key(1), now).code, 0);
+    assert.equal(store.has(protyle, key(1), now), false);
+    assert.equal(store.take(protyle, key(1), now), undefined);
+});
+
+test("content prefetch store expires entries and rejects stale generations", () => {
+    const store = new ContentPrefetchStore();
+    const protyle = editor();
+    const now = Date.now();
+    store.store(protyle, key(1), socketData(), now, store.getGeneration());
+    assert.equal(store.has(protyle, key(1), now + CONTENT_PREFETCH_TTL + 1), false);
+    store.store(protyle, key(2), socketData(), now, store.getGeneration());
+    const generation = store.getGeneration();
+    store.clear(protyle);
+    assert.equal(store.store(protyle, key(2), socketData(), now, generation), false);
+    assert.equal(store.take(protyle, key(2), now), undefined);
+});
+
+test("content prefetch store runs one attempt per editor and aborts it on invalidation", () => {
+    const store = new ContentPrefetchStore();
+    const first = editor();
+    const second = editor();
+    const now = Date.now();
+    const controller = new AbortController();
+    const token = store.beginAttempt(first, controller, now);
+    assert.ok(token);
+    assert.equal(store.beginAttempt(first, new AbortController(), now + 5000), undefined);
+    assert.equal(store.beginAttempt(second, new AbortController(), now + 5000), undefined);
+    store.clear(first);
+    assert.equal(controller.signal.aborted, true);
+    const next = new AbortController();
+    assert.ok(store.beginAttempt(second, next, now + 6000));
+    assert.equal(store.beginAttempt(second, new AbortController(), now + 6000), undefined);
+    store.finishAttempt(second, 0);
+    assert.equal(next.signal.aborted, false);
+});
+
+test("content prefetch store evicts the least recently used editor", () => {
+    const store = new ContentPrefetchStore();
+    const editors: IProtyle[] = [];
+    for (let index = 0; index < 9; index++) {
+        const protyle = editor();
+        editors.push(protyle);
+        store.store(protyle, key(2), socketData(), Date.now() + index, store.getGeneration());
+    }
+    assert.equal(store.has(editors[0], key(2), Date.now() + 100), false);
+    assert.equal(store.has(editors[8], key(2), Date.now() + 100), true);
+});
+
+test("content prefetch foreground ownership blocks speculation until every owner releases", () => {
+    const store = new ContentPrefetchStore();
+    const first = editor();
+    const second = editor();
+    const now = Date.now();
+    const speculative = new AbortController();
+    assert.ok(store.beginAttempt(first, speculative, now));
+    const releaseFirst = store.beginContentForeground();
+    assert.equal(speculative.signal.aborted, true);
+    assert.equal(store.hasActiveAttempt(), false);
+    assert.equal(store.hasContentForeground(), true);
+    assert.equal(store.beginAttempt(second, new AbortController(), now + 5000), undefined);
+    const releaseSecond = store.beginContentForeground();
+    releaseFirst();
+    assert.equal(store.hasContentForeground(), true);
+    assert.equal(store.canAttempt(second, now + 5000), false);
+    store.clearAll();
+    store.clear(second);
+    assert.equal(store.hasContentForeground(), true);
+    releaseSecond();
+    assert.equal(store.hasContentForeground(), false);
+    const next = new AbortController();
+    assert.ok(store.beginAttempt(second, next, now + 5000));
+    store.abortAttempt(second);
+    assert.equal(next.signal.aborted, true);
+});
+
+test("content prefetch foreground cancels registered image work", () => {
+    const store = new ContentPrefetchStore();
+    let cancelled = 0;
+    registerContentPrefetchCancelHook(() => cancelled++);
+    const release = store.beginContentForeground();
+    assert.equal(cancelled, 1);
+    assert.equal(store.hasContentForeground(), true);
+    release();
+    assert.equal(store.hasContentForeground(), false);
+});
+
+test("global content prefetch invalidation fires registered cancel hooks", () => {
+    let cancelled = 0;
+    registerContentPrefetchCancelHook(() => cancelled++);
+    invalidateContentPrefetch();
+    assert.equal(cancelled, 1);
+    invalidateContentPrefetchFor(editor(), false);
+    assert.equal(cancelled, 1);
+    invalidateContentPrefetchFor(editor(), true);
+    assert.equal(cancelled, 2);
+});
+
+const compiledSource = (file: string) => transpileModule(readFileSync(file, "utf8"), {
+    compilerOptions: {module: ModuleKind.CommonJS, target: ScriptTarget.ES2021},
+}).outputText;
+
+const createStoreModule = () => {
+    const policyExports: any = {};
+    runInNewContext(compiledSource("src/protyle/scroll/contentPrefetchPolicy.ts"), {exports: policyExports});
+    const storeExports: any = {};
+    runInNewContext(compiledSource("src/protyle/scroll/contentPrefetchStore.ts"), {
+        exports: storeExports,
+        require: (name: string) => {
+            if (name === "./contentPrefetchPolicy") {
+                return policyExports;
+            }
+            throw new Error("unexpected store require: " + name);
+        },
+    });
+    return storeExports;
+};
+
+type TFetchCall = {data: any, callback: (response: any) => void, finish: () => void};
+
+const createScrollHarness = (options: {
+    contentPrefetch: boolean;
+    cachedResponse?: IWebSocketData;
+    consumeCached?: boolean;
+    onGetThrows?: boolean;
+}) => {
+    const rendered: any[] = [];
+    const fetchCalls: TFetchCall[] = [];
+    const invalidated: IProtyle[] = [];
+    const finishes: boolean[] = [];
+    const scrollExports: any = {};
+    const windowObject: any = {
+        siyuan: {config: {editor: {dynamicLoadBlocks: 128, contentPrefetch: options.contentPrefetch}}},
+    };
+    const storeModule = createStoreModule();
+    const store = {
+        ...storeModule,
+        invalidateContentPrefetchFor: (protyle: IProtyle, cancelImages = false) => {
+            invalidated.push(protyle);
+            storeModule.invalidateContentPrefetchFor(protyle, cancelImages);
+        },
+    };
+    const contentPrefetchModule = {
+        hasPrefetchedDynamicResponse: (): boolean => !!options.cachedResponse,
+        consumePrefetchedDynamicResponse: (): IWebSocketData | undefined =>
+            options.consumeCached === false ? undefined : options.cachedResponse,
+        scheduleContentPrefetch: (): void => undefined,
+    };
+    const dependencies = {
+        DynamicLoadState,
+        Constants: {CB_GET_BEFORE: "before", CB_GET_APPEND: "append", CB_GET_UNCHANGEID: "keep-id"},
+        isEncryptedBox: (): boolean => false,
+        onGet: (values: any): void => {
+            if (options.onGetThrows) {
+                throw new Error("prefetch render failed");
+            }
+            rendered.push(values);
+        },
+        refreshSyntheticDragTarget: (): void => undefined,
+        waitForPendingTransactions: (): Promise<void> => Promise.resolve(),
+        fetchPost: (_url: string, data: any, callback: (response: any) => void): Promise<void> => new Promise<void>(finish => {
+            fetchCalls.push({data, callback, finish});
+        }),
+    };
+    runInNewContext(compiledSource("src/protyle/scroll/index.ts"), {
+        exports: scrollExports,
+        AbortController,
+        Promise,
+        window: windowObject,
+        require: (name: string) => {
+            if (name === "./contentPrefetch") {
+                return contentPrefetchModule;
+            }
+            if (name === "./contentPrefetchStore") {
+                return store;
+            }
+            return dependencies;
+        },
+    });
+    const createEditor = (rootID = "document") => {
+        const attributes = new Map<string, string>();
+        const scroll = Object.create(scrollExports.Scroll.prototype);
+        scroll.dynamicLoadState = new DynamicLoadState();
+        const protyle: any = {
+            notebookId: "box",
+            block: {rootID},
+            element: {isConnected: true, getAttribute: (): null => null},
+            contentElement: {scrollTop: 42},
+            wysiwyg: {element: {
+                firstElementChild: {
+                    getAttribute: (name: string): string | null => name === "data-node-id" ? "first" : null,
+                },
+                lastElementChild: {
+                    getAttribute: (name: string): string | null => name === "data-node-id" ? "last" : null,
+                },
+                hasAttribute: (name: string): boolean => attributes.has(name),
+                setAttribute: (name: string, value: string): void => { attributes.set(name, value); },
+                removeAttribute: (name: string): void => { attributes.delete(name); },
+            }},
+        };
+        return {scroll, protyle, attributes};
+    };
+    const current = createEditor();
+    return {
+        ...current,
+        createEditor,
+        rendered,
+        fetchCalls,
+        invalidated,
+        finishes,
+        store: storeModule.contentPrefetchStore as ContentPrefetchStore,
+        windowObject,
+    };
+};
+
+test("dynamic load applies a prefetched response without a second request", async () => {
+    const cached = {code: 0, data: {content: "cached"}} as IWebSocketData;
+    const harness = createScrollHarness({contentPrefetch: true, cachedResponse: cached});
+    assert.equal(harness.scroll.loadDynamic(harness.protyle, 2, {
+        onFinish: (success: boolean) => harness.finishes.push(success),
+    }), true);
+    assert.equal(harness.fetchCalls.length, 0);
+    assert.equal(harness.rendered.length, 0);
+    assert.equal(harness.store.hasContentForeground(), true);
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.fetchCalls.length, 0);
+    assert.equal(harness.store.hasContentForeground(), false);
+    assert.equal(harness.rendered.length, 1);
+    assert.equal(harness.rendered[0].data, cached);
+    assert.equal(harness.rendered[0].action.length, 2);
+    assert.equal(harness.rendered[0].action[0], "append");
+    assert.equal(harness.rendered[0].action[1], "keep-id");
+    assert.equal(harness.attributes.has("data-top"), false);
+    assert.equal(harness.finishes.length, 1);
+    assert.equal(harness.finishes[0], true);
+});
+
+test("dynamic load falls back to the original request when the cached response is stale", async () => {
+    const cached = {code: 0, data: {content: "stale"}} as IWebSocketData;
+    const harness = createScrollHarness({contentPrefetch: true, cachedResponse: cached, consumeCached: false});
+    assert.equal(harness.scroll.loadDynamic(harness.protyle, 2, {
+        onFinish: (success: boolean) => harness.finishes.push(success),
+    }), true);
+    assert.equal(harness.store.hasContentForeground(), true);
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.rendered.length, 0);
+    assert.equal(harness.fetchCalls.length, 1);
+    harness.fetchCalls[0].callback({code: 0, data: {content: "fresh"}});
+    assert.equal(harness.rendered.length, 1);
+    assert.equal(harness.rendered[0].data.data.content, "fresh");
+    harness.fetchCalls[0].finish();
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(harness.rendered.length, 1);
+    assert.equal(harness.store.hasContentForeground(), false);
+    assert.equal(harness.finishes.length, 1);
+    assert.equal(harness.finishes[0], true);
+});
+
+test("dynamic load keeps the original request when content prefetch is disabled", async () => {
+    const harness = createScrollHarness({contentPrefetch: false, cachedResponse: {code: 0} as IWebSocketData});
+    assert.equal(harness.scroll.loadDynamic(harness.protyle, 1), true);
